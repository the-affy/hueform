{
  "name": "hueform",
  "displayName": "HUEFORM — VS Code Theme & Icon Collection",
  "description": "A curated collection of 22 dark & light VS Code colour themes and matching file icon sets, crafted with intentional contrast, long-session eye comfort, and seamless theme synchronization.",
  "version": "1.0.0",
  "publisher": "theaffy",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "themes",
    "icons",
    "file icons",
    "icon theme",
    "minimal",
    "minimalist",
    "pierre",
    "abyss",
    "nocturne",
    "sakura",
    "umber",
    "midnight",
    "forest",
    "nebula",
    "ocean",
    "ember",
    "lavender",
    "blossom",
    "hueform"
  ],
  "galleryBanner": {
    "color": "#0B132B",
    "theme": "dark"
  },
  "icon": "assets/icon.png",
  "scripts": {
    "build:themes": "node build-themes.js",
    "build:icons": "node scripts/build-icons.js",
    "test": "node tests/verify-icons.js && node tests/test-theme-switching.js && node tests/test-icon-contrast.js && node tests/test-color-system.js",
    "package": "vsce package -o hueform-1.0.0.vsix"
  },
  "contributes": {
    "commands": [
      {
        "command": "hueform.toggleCursorAnimation",
        "title": "Toggle Cursor Glide Animation",
        "category": "HUEFORM"
      },
      {
        "command": "hueform.toggleFolderHighlights",
        "title": "Toggle Themed Folder Highlights",
        "category": "HUEFORM"
      },
      {
        "command": "hueform.toggleAutoMatchIconTheme",
        "title": "Toggle Automatic Icon Theme Matching",
        "category": "HUEFORM"
      },
      {
        "command": "hueform.syncActiveIconTheme",
        "title": "Match File Icons to Active Color Theme",
        "category": "HUEFORM"
      }
    ],
    "configuration": {
      "title": "HUEFORM Theme Collection",
      "properties": {
        "hueform.autoMatchIconTheme": {
          "type": "boolean",
          "default": true,
          "description": "Automatically match the file icon theme with the active HUEFORM color theme (22 matching themes across 11 families and dark/light variants)."
        },
        "hueform.cursor.animation": {
          "type": "boolean",
          "default": true,
          "description": "Enable smooth cursor glide motion matching the active HUEFORM theme."
        },
        "hueform.folderHighlights.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Highlight important project folders (src, components, tests, docs) with subtle themed badges in the explorer tree."
        }
      }
    },
    "iconThemes": [
      {
        "id": "hueform-abyss-icons-dark",
        "label": "HUEFORM Abyss Icons Dark",
        "path": "./icons/themes/hueform-abyss-icons-dark.json"
      },
      {
        "id": "hueform-abyss-icons-light",
        "label": "HUEFORM Abyss Icons Light",
        "path": "./icons/themes/hueform-abyss-icons-light.json"
      },
      {
        "id": "hueform-nocturne-icons-dark",
