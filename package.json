{
  "name": "sonder",
  "displayName": "SONDER — VS Code Theme & Icon Collection",
  "description": "A thoughtfully curated collection of 22 dark & light VS Code themes, matching themed icon sets, and subtle workbench enhancements.",
  "version": "1.0.0",
  "publisher": "sonder-theme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "themes",
    "icons",
    "file icons",
    "icon theme",
    "minimal",
    "minimalist",
    "pierre",
    "abyss",
    "nocturne",
    "sakura",
    "umber",
    "midnight",
    "forest",
    "nebula",
    "ocean",
    "ember",
    "lavender",
    "blossom",
    "sonder"
  ],
  "galleryBanner": {
    "color": "#0B132B",
    "theme": "dark"
  },
  "icon": "assets/icon.png",
  "scripts": {
    "build:themes": "node build-themes.js",
    "build:icons": "node scripts/build-icons.js",
    "test": "node tests/verify-icons.js && node tests/test-theme-switching.js && node tests/test-icon-contrast.js",
    "package": "vsce package -o sonder-1.0.0.vsix"
  },
  "contributes": {
    "commands": [
      {
        "command": "sonder.toggleCursorAnimation",
        "title": "Toggle Cursor Glide Animation",
        "category": "SONDER"
      },
      {
        "command": "sonder.toggleFolderHighlights",
        "title": "Toggle Themed Folder Highlights",
        "category": "SONDER"
      },
      {
        "command": "sonder.toggleAutoMatchIconTheme",
        "title": "Toggle Automatic Icon Theme Matching",
        "category": "SONDER"
      },
      {
        "command": "sonder.syncActiveIconTheme",
        "title": "Match File Icons to Active Color Theme",
        "category": "SONDER"
      }
    ],
    "configuration": {
      "title": "SONDER Theme Collection",
      "properties": {
        "sonder.autoMatchIconTheme": {
          "type": "boolean",
          "default": true,
          "description": "Automatically match the file icon theme with the active SONDER color theme (22 matching themes across 11 families and dark/light variants)."
        },
        "sonder.cursor.animation": {
          "type": "boolean",
          "default": true,
          "description": "Enable smooth cursor glide motion matching the active SONDER theme."
        },
        "sonder.folderHighlights.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Highlight important project folders (src, components, tests, docs) with subtle themed badges in the explorer tree."
        }
      }
    },
    "iconThemes": [
      {
        "id": "sonder-abyss-icons-dark",
        "label": "SONDER Abyss Icons Dark",
        "path": "./icons/themes/sonder-abyss-icons-dark.json"
      },
      {
        "id": "sonder-abyss-icons-light",
        "label": "SONDER Abyss Icons Light",
        "path": "./icons/themes/sonder-abyss-icons-light.json"
