{
  "name": "SONDER — Ocean Light",
  "$schema": "vscode://schemas/color-theme",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#021A26",
    "variable.readonly": "#BA3B10",
    "variable.defaultLibrary": "#006FA3",
    "parameter": "#021A26",
    "property": "#021A26",
    "property.readonly": "#BA3B10",
    "enumMember": "#BA3B10",
    "function": "#047A8A",
    "method": "#047A8A",
    "class": "#02677E",
    "interface": "#02677E",
    "type": "#02677E",
    "typeParameter": "#02677E",
    "namespace": "#02677E",
    "enum": "#02677E",
    "struct": "#02677E",
    "decorator": "#047A8A",
    "event": "#006FA3",
    "keyword": "#006FA3",
    "modifier": "#006FA3",
    "string": "#067E67",
    "number": "#BA3B10",
    "regexp": "#067E67",
    "operator": "#006FA3",
    "comment": "#44747E",
    "macro": "#047A8A"
  },
  "colors": {
    "focusBorder": "#0284C788",
    "foreground": "#021A26",
    "disabledForeground": "#04B9E299",
    "widget.shadow": "#00000018",
    "widget.border": "#A4CDD2",
    "selection.background": "#0284C72A",
    "descriptionForeground": "#02677E",
    "errorForeground": "#DC2626",
    "icon.foreground": "#02677E",
    "window.activeBorder": "#A4CDD2",
    "window.inactiveBorder": "#C6E2E7",
    "titleBar.activeBackground": "#D8EDF2",
    "titleBar.activeForeground": "#021A26",
    "titleBar.inactiveBackground": "#D8EDF2",
    "titleBar.inactiveForeground": "#02677E",
    "titleBar.border": "#A4CDD2",
    "activityBar.background": "#D8EDF2",
    "activityBar.foreground": "#0284C7",
    "activityBar.inactiveForeground": "#02677E88",
    "activityBar.border": "#A4CDD2",
    "activityBar.activeBorder": "#0284C7",
    "activityBarBadge.background": "#0284C7",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#D8EDF2",
    "sideBar.foreground": "#021A26",
    "sideBar.border": "#A4CDD2",
    "sideBarTitle.foreground": "#02677E",
    "sideBarSectionHeader.background": "#D8EDF2",
    "sideBarSectionHeader.foreground": "#021A26",
    "sideBarSectionHeader.border": "#A4CDD2",
    "list.activeSelectionBackground": "#0284C720",
    "list.activeSelectionForeground": "#021A26",
    "list.inactiveSelectionBackground": "#0284C712",
    "list.inactiveSelectionForeground": "#021A26",
    "list.hoverBackground": "#CFE8EF",
    "list.hoverForeground": "#021A26",
    "list.focusBackground": "#0284C720",
    "list.focusForeground": "#021A26",
    "list.highlightForeground": "#0284C7",
    "list.dropBackground": "#0284C722",
    "tree.indentGuidesStroke": "#C6E2E7",
    "editor.background": "#EBF7F9",
    "editor.foreground": "#021A26",
    "editorCursor.foreground": "#0284C7",
    "editorCursor.background": "#EBF7F9",
    "editor.lineHighlightBackground": "#D8EDF266",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#0284C72A",
    "editor.selectionHighlightBackground": "#0284C718",
    "editor.wordHighlightBackground": "#047A8A1E",
    "editor.wordHighlightBorder": "#047A8A66",
    "editor.findMatchBackground": "#0284C750",
    "editor.findMatchHighlightBackground": "#0284C726",
    "editorLineNumber.foreground": "#04B9E288",
    "editorLineNumber.activeForeground": "#0284C7",
    "editorIndentGuide.background1": "#C6E2E7",
    "editorIndentGuide.activeBackground1": "#0284C766",
    "editorWhitespace.foreground": "#C6E2E7",
    "editorRuler.foreground": "#C6E2E7",
    "editorBracketHighlight.foreground1": "#0284C7",
    "editorBracketHighlight.foreground2": "#047A8A",
    "editorBracketHighlight.foreground3": "#BA3B10",
    "editorBracketHighlight.foreground4": "#067E67",
    "editorBracketHighlight.foreground5": "#006FA3",
    "editorBracketHighlight.foreground6": "#02677E",
    "editorGroupHeader.tabsBackground": "#D8EDF2",
    "editorGroupHeader.tabsBorder": "#A4CDD2",
    "editorGroupHeader.noTabsBackground": "#D8EDF2",
    "editorGroup.border": "#A4CDD2",
    "tab.activeBackground": "#D8EEF5",
    "tab.activeForeground": "#021A26",
    "tab.activeBorderTop": "#0284C7",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#D8EDF2",
    "tab.inactiveForeground": "#02677E",
    "tab.border": "#A4CDD2",
    "tab.hoverBackground": "#BADEEC",
    "tab.hoverForeground": "#021A26",
    "tab.selectedBackground": "#0284C72A",
    "tab.selectedForeground": "#021A26",
    "tab.unfocusedActiveBackground": "#D8EEF4",
    "tab.unfocusedActiveForeground": "#021A26D9",
    "tab.unfocusedActiveBorderTop": "#0284C788",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#D8EDF2",
    "tab.unfocusedInactiveForeground": "#02677EB3",
    "tab.unfocusedHoverBackground": "#BADEEC",
    "tab.unfocusedHoverForeground": "#021A26",
    "tab.lastPinnedBorder": "#A4CDD2",
    "panel.background": "#C6E3EB",
    "panel.border": "#A4CDD2",
    "panelTitle.activeBorder": "#0284C7",
    "panelTitle.activeForeground": "#021A26",
    "panelTitle.inactiveForeground": "#02677E",
    "terminal.background": "#C6E3EB",
    "terminal.foreground": "#021A26",
    "terminal.border": "#A4CDD2",
    "terminal.ansiBlack": "#021A26",
    "terminal.ansiRed": "#991B1B",
    "terminal.ansiGreen": "#166534",
    "terminal.ansiYellow": "#92400E",
    "terminal.ansiBlue": "#006FA3",
    "terminal.ansiMagenta": "#701A75",
    "terminal.ansiCyan": "#0E7490",
    "terminal.ansiWhite": "#475569",
    "statusBar.background": "#C6E3EB",
    "statusBar.foreground": "#02677E",
    "statusBar.border": "#A4CDD2",
    "statusBar.debuggingBackground": "#0284C720",
    "statusBar.debuggingForeground": "#021A26",
    "statusBar.noFolderBackground": "#C6E3EB",
    "statusBarItem.hoverBackground": "#0284C712",
    "statusBarItem.activeBackground": "#0284C720",
    "statusBarItem.prominentBackground": "#0284C7",
    "statusBarItem.prominentForeground": "#FFFFFF",
    "gitDecoration.addedResourceForeground": "#16A34A",
    "gitDecoration.modifiedResourceForeground": "#0284C7",
    "gitDecoration.deletedResourceForeground": "#DC2626",
    "gitDecoration.untrackedResourceForeground": "#059669",
    "gitDecoration.ignoredResourceForeground": "#04B9E288",
    "diffEditor.insertedTextBackground": "#16A34A18",
    "diffEditor.removedTextBackground": "#DC262618",
    "input.background": "#EBF7F9",
    "input.foreground": "#021A26",
    "input.border": "#A4CDD2",
    "input.placeholderForeground": "#04B9E299",
    "dropdown.background": "#D8EDF2",
    "dropdown.foreground": "#021A26",
    "dropdown.border": "#A4CDD2",
    "quickInput.background": "#D8EDF2",
    "quickInput.foreground": "#021A26",
    "pickerGroup.border": "#A4CDD2",
    "pickerGroup.foreground": "#0284C7",
    "notificationCenter.border": "#A4CDD2",
    "notificationCenterHeader.background": "#D8EDF2",
    "notificationCenterHeader.foreground": "#021A26",
    "notifications.background": "#D8EDF2",
    "notifications.foreground": "#021A26",
    "notifications.border": "#A4CDD2",
    "badge.background": "#0284C7",
    "badge.foreground": "#FFFFFF",
    "breadcrumb.background": "#EBF7F9",
    "breadcrumb.foreground": "#02677E",
    "breadcrumb.focusForeground": "#021A26",
    "breadcrumb.activeSelectionForeground": "#0284C7"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#44747E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#006FA3"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#047A8A"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#067E67"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#BA3B10"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#02677E"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#021A26"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#021A26"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#006FA3"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#006FA3"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#047A8A"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#006FA3"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#047A8A"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#067E67"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#0284C7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#067E67"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#047A8A"
      }
    }
  ]
}
