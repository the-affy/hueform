{
  "name": "HUEFORM — Forest Dark",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#EEF7F2",
    "variable.readonly": "#F5C74E",
    "variable.defaultLibrary": "#29C7B2",
    "parameter": "#EEF7F2",
    "property": "#EEF7F2",
    "property.readonly": "#F5C74E",
    "enumMember": "#F5C74E",
    "function": "#3DD678",
    "method": "#3DD678",
    "class": "#80C899",
    "interface": "#80C899",
    "type": "#80C899",
    "typeParameter": "#80C899",
    "namespace": "#80C899",
    "enum": "#80C899",
    "struct": "#80C899",
    "decorator": "#3DD678",
    "event": "#29C7B2",
    "keyword": "#29C7B2",
    "modifier": "#29C7B2",
    "string": "#D2F48D",
    "number": "#F5C74E",
    "regexp": "#D2F48D",
    "operator": "#3DD678",
    "comment": "#638C71",
    "macro": "#3DD678"
  },
  "colors": {
    "focusBorder": "#3DD67888",
    "foreground": "#EEF7F2",
    "disabledForeground": "#449E6399",
    "widget.shadow": "var(--color-accent)66",
    "widget.border": "#244932",
    "selection.background": "#3DD67838",
    "descriptionForeground": "#80C899",
    "errorForeground": "#F87171",
    "icon.foreground": "#80C899",
    "window.activeBorder": "#244932",
    "window.inactiveBorder": "#152D1F",
    "titleBar.activeBackground": "#0D1E14",
    "titleBar.activeForeground": "#EEF7F2",
    "titleBar.inactiveBackground": "#0D1E14",
    "titleBar.inactiveForeground": "#80C899",
    "titleBar.border": "#244932",
    "activityBar.background": "#0D1E14",
    "activityBar.foreground": "#3DD678",
    "activityBar.inactiveForeground": "#80C89988",
    "activityBar.border": "#244932",
    "activityBar.activeBorder": "#3DD678",
    "activityBarBadge.background": "#3DD678",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#0D1E14",
    "sideBar.foreground": "#EEF7F2",
    "sideBar.border": "#244932",
    "sideBarTitle.foreground": "#80C899",
    "sideBarSectionHeader.background": "#0D1E14",
    "sideBarSectionHeader.foreground": "#EEF7F2",
    "sideBarSectionHeader.border": "#244932",
    "list.activeSelectionBackground": "#3DD6782A",
    "list.activeSelectionForeground": "#EEF7F2",
    "list.inactiveSelectionBackground": "#3DD67818",
    "list.inactiveSelectionForeground": "#EEF7F2",
    "list.hoverBackground": "#162F20",
    "list.hoverForeground": "#EEF7F2",
    "list.focusBackground": "#3DD6782A",
    "list.focusForeground": "#EEF7F2",
    "list.highlightForeground": "#3DD678",
    "list.dropBackground": "#3DD67822",
    "tree.indentGuidesStroke": "#152D1F",
    "editor.background": "#07120C",
    "editor.foreground": "#EEF7F2",
    "editorCursor.foreground": "#3DD678",
    "editorCursor.background": "#07120C",
    "editor.lineHighlightBackground": "#0D1E1455",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#3DD67838",
    "editor.selectionHighlightBackground": "#3DD67820",
    "editor.wordHighlightBackground": "#29C7B226",
    "editor.wordHighlightBorder": "#29C7B266",
    "editor.findMatchBackground": "#3DD67850",
    "editor.findMatchHighlightBackground": "#3DD67826",
    "editorLineNumber.foreground": "#449E6388",
    "editorLineNumber.activeForeground": "#3DD678",
    "editorIndentGuide.background1": "#152D1F",
    "editorIndentGuide.activeBackground1": "#3DD67866",
    "editorWhitespace.foreground": "#152D1F",
    "editorRuler.foreground": "#152D1F",
    "editorBracketHighlight.foreground1": "#3DD678",
    "editorBracketHighlight.foreground2": "#29C7B2",
    "editorBracketHighlight.foreground3": "#F5C74E",
    "editorBracketHighlight.foreground4": "#D2F48D",
    "editorBracketHighlight.foreground5": "#29C7B2",
    "editorBracketHighlight.foreground6": "#80C899",
    "editorGroupHeader.tabsBackground": "#0D1E14",
    "editorGroupHeader.tabsBorder": "#244932",
    "editorGroupHeader.noTabsBackground": "#0D1E14",
    "editorGroup.border": "#244932",
    "tab.activeBackground": "#0D2A19",
    "tab.activeForeground": "#EEF7F2",
    "tab.activeBorderTop": "#3DD678",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#0D1E14",
    "tab.inactiveForeground": "#80C899",
    "tab.border": "#244932",
    "tab.hoverBackground": "#153B24",
    "tab.hoverForeground": "#EEF7F2",
    "tab.selectedBackground": "#3DD67838",
    "tab.selectedForeground": "#EEF7F2",
    "tab.unfocusedActiveBackground": "#0B2014",
    "tab.unfocusedActiveForeground": "#EEF7F2D9",
    "tab.unfocusedActiveBorderTop": "#3DD67888",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#0D1E14",
    "tab.unfocusedInactiveForeground": "#80C899B3",
    "tab.unfocusedHoverBackground": "#153B24",
    "tab.unfocusedHoverForeground": "#EEF7F2",
    "tab.lastPinnedBorder": "#244932",
    "panel.background": "#142B1D",
    "panel.border": "#244932",
    "panelTitle.activeBorder": "#3DD678",
    "panelTitle.activeForeground": "#EEF7F2",
    "panelTitle.inactiveForeground": "#80C899",
    "terminal.background": "#142B1D",
    "terminal.foreground": "#EEF7F2",
    "terminal.border": "#244932",
    "terminal.ansiBlack": "#0D1E14",
    "terminal.ansiRed": "#FB7185",
    "terminal.ansiGreen": "#3DD678",
    "terminal.ansiYellow": "#F5C74E",
    "terminal.ansiBlue": "#29C7B2",
    "terminal.ansiMagenta": "#A78BFA",
    "terminal.ansiCyan": "#67E8F9",
    "terminal.ansiWhite": "#EEF7F2",
    "statusBar.background": "#142B1D",
    "statusBar.foreground": "#80C899",
    "statusBar.border": "#244932",
    "statusBar.debuggingBackground": "#3DD6782A",
    "statusBar.debuggingForeground": "#EEF7F2",
    "statusBar.noFolderBackground": "#142B1D",
    "statusBarItem.hoverBackground": "#3DD67818",
    "statusBarItem.activeBackground": "#3DD6782A",
    "statusBarItem.prominentBackground": "#3DD678",
    "statusBarItem.prominentForeground": "#000000",
    "gitDecoration.addedResourceForeground": "#4ADE80",
    "gitDecoration.modifiedResourceForeground": "#3DD678",
    "gitDecoration.deletedResourceForeground": "#F87171",
    "gitDecoration.untrackedResourceForeground": "#A7F3D0",
    "gitDecoration.ignoredResourceForeground": "#449E6388",
    "diffEditor.insertedTextBackground": "#4ADE8020",
    "diffEditor.removedTextBackground": "#F8717120",
    "input.background": "#0D1E14",
    "input.foreground": "#EEF7F2",
    "input.border": "#244932",
    "input.placeholderForeground": "#449E6399",
    "dropdown.background": "#142B1D",
    "dropdown.foreground": "#EEF7F2",
    "dropdown.border": "#244932",
    "quickInput.background": "#142B1D",
    "quickInput.foreground": "#EEF7F2",
    "pickerGroup.border": "#244932",
    "pickerGroup.foreground": "#3DD678",
    "notificationCenter.border": "#244932",
    "notificationCenterHeader.background": "#0D1E14",
    "notificationCenterHeader.foreground": "#EEF7F2",
    "notifications.background": "#142B1D",
    "notifications.foreground": "#EEF7F2",
    "notifications.border": "#244932",
    "badge.background": "#3DD678",
    "badge.foreground": "#000000",
    "breadcrumb.background": "#07120C",
    "breadcrumb.foreground": "#80C899",
    "breadcrumb.focusForeground": "#EEF7F2",
    "breadcrumb.activeSelectionForeground": "#3DD678"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#638C71",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#29C7B2"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#3DD678"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#D2F48D"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#F5C74E"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#80C899"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#EEF7F2"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#EEF7F2"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#3DD678"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#29C7B2"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#3DD678"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#29C7B2"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#3DD678"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#D2F48D"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#3DD678",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#D2F48D"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#29C7B2"
      }
    }
  ]
}
