{
  "name": "SONDER — Nebula Light",
  "$schema": "vscode://schemas/color-theme",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#1C0A36",
    "variable.readonly": "#B83E0A",
    "variable.defaultLibrary": "#9828C9",
    "parameter": "#1C0A36",
    "property": "#1C0A36",
    "property.readonly": "#B83E0A",
    "enumMember": "#B83E0A",
    "function": "#6D28D9",
    "method": "#6D28D9",
    "class": "#5E1D96",
    "interface": "#5E1D96",
    "type": "#5E1D96",
    "typeParameter": "#5E1D96",
    "namespace": "#5E1D96",
    "enum": "#5E1D96",
    "struct": "#5E1D96",
    "decorator": "#6D28D9",
    "event": "#9828C9",
    "keyword": "#9828C9",
    "modifier": "#9828C9",
    "string": "#0E7490",
    "number": "#B83E0A",
    "regexp": "#0E7490",
    "operator": "#9828C9",
    "comment": "#725B8F",
    "macro": "#6D28D9"
  },
  "colors": {
    "focusBorder": "#9828C988",
    "foreground": "#1C0A36",
    "disabledForeground": "#923FDA99",
    "widget.shadow": "#00000018",
    "widget.border": "#C5AEDB",
    "selection.background": "#9828C92A",
    "descriptionForeground": "#5E1D96",
    "errorForeground": "#DC2626",
    "icon.foreground": "#5E1D96",
    "window.activeBorder": "#C5AEDB",
    "window.inactiveBorder": "#DFD2ED",
    "titleBar.activeBackground": "#EDE5F6",
    "titleBar.activeForeground": "#1C0A36",
    "titleBar.inactiveBackground": "#EDE5F6",
    "titleBar.inactiveForeground": "#5E1D96",
    "titleBar.border": "#C5AEDB",
    "activityBar.background": "#EDE5F6",
    "activityBar.foreground": "#9828C9",
    "activityBar.inactiveForeground": "#5E1D9688",
    "activityBar.border": "#C5AEDB",
    "activityBar.activeBorder": "#9828C9",
    "activityBarBadge.background": "#9828C9",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#EDE5F6",
    "sideBar.foreground": "#1C0A36",
    "sideBar.border": "#C5AEDB",
    "sideBarTitle.foreground": "#5E1D96",
    "sideBarSectionHeader.background": "#EDE5F6",
    "sideBarSectionHeader.foreground": "#1C0A36",
    "sideBarSectionHeader.border": "#C5AEDB",
    "list.activeSelectionBackground": "#9828C920",
    "list.activeSelectionForeground": "#1C0A36",
    "list.inactiveSelectionBackground": "#9828C912",
    "list.inactiveSelectionForeground": "#1C0A36",
    "list.hoverBackground": "#E6DCF2",
    "list.hoverForeground": "#1C0A36",
    "list.focusBackground": "#9828C920",
    "list.focusForeground": "#1C0A36",
    "list.highlightForeground": "#9828C9",
    "list.dropBackground": "#9828C922",
    "tree.indentGuidesStroke": "#DFD2ED",
    "editor.background": "#F7F4FB",
    "editor.foreground": "#1C0A36",
    "editorCursor.foreground": "#9828C9",
    "editorCursor.background": "#F7F4FB",
    "editor.lineHighlightBackground": "#EDE5F666",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#9828C92A",
    "editor.selectionHighlightBackground": "#9828C918",
    "editor.wordHighlightBackground": "#6D28D91E",
    "editor.wordHighlightBorder": "#6D28D966",
    "editor.findMatchBackground": "#9828C950",
    "editor.findMatchHighlightBackground": "#9828C926",
    "editorLineNumber.foreground": "#923FDA88",
    "editorLineNumber.activeForeground": "#9828C9",
    "editorIndentGuide.background1": "#DFD2ED",
    "editorIndentGuide.activeBackground1": "#9828C966",
    "editorWhitespace.foreground": "#DFD2ED",
    "editorRuler.foreground": "#DFD2ED",
    "editorBracketHighlight.foreground1": "#9828C9",
    "editorBracketHighlight.foreground2": "#6D28D9",
    "editorBracketHighlight.foreground3": "#B83E0A",
    "editorBracketHighlight.foreground4": "#0E7490",
    "editorBracketHighlight.foreground5": "#9828C9",
    "editorBracketHighlight.foreground6": "#5E1D96",
    "editorGroupHeader.tabsBackground": "#EDE5F6",
    "editorGroupHeader.tabsBorder": "#C5AEDB",
    "editorGroupHeader.noTabsBackground": "#EDE5F6",
    "editorGroup.border": "#C5AEDB",
    "tab.activeBackground": "#EFE4F7",
    "tab.activeForeground": "#1C0A36",
    "tab.activeBorderTop": "#9828C9",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#EDE5F6",
    "tab.inactiveForeground": "#5E1D96",
    "tab.border": "#C5AEDB",
    "tab.hoverBackground": "#E1CBF0",
    "tab.hoverForeground": "#1C0A36",
    "tab.selectedBackground": "#9828C92A",
    "tab.selectedForeground": "#1C0A36",
    "tab.unfocusedActiveBackground": "#EEE5F7",
    "tab.unfocusedActiveForeground": "#1C0A36D9",
    "tab.unfocusedActiveBorderTop": "#9828C988",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#EDE5F6",
    "tab.unfocusedInactiveForeground": "#5E1D96B3",
    "tab.unfocusedHoverBackground": "#E1CBF0",
    "tab.unfocusedHoverForeground": "#1C0A36",
    "tab.lastPinnedBorder": "#C5AEDB",
    "panel.background": "#DFD2EE",
    "panel.border": "#C5AEDB",
    "panelTitle.activeBorder": "#9828C9",
    "panelTitle.activeForeground": "#1C0A36",
    "panelTitle.inactiveForeground": "#5E1D96",
    "terminal.background": "#DFD2EE",
    "terminal.foreground": "#1C0A36",
    "terminal.border": "#C5AEDB",
    "terminal.ansiBlack": "#1C0A36",
    "terminal.ansiRed": "#9F1239",
    "terminal.ansiGreen": "#166534",
    "terminal.ansiYellow": "#92400E",
    "terminal.ansiBlue": "#581C87",
    "terminal.ansiMagenta": "#86198F",
    "terminal.ansiCyan": "#0E7490",
    "terminal.ansiWhite": "#475569",
    "statusBar.background": "#DFD2EE",
    "statusBar.foreground": "#5E1D96",
    "statusBar.border": "#C5AEDB",
    "statusBar.debuggingBackground": "#9828C920",
    "statusBar.debuggingForeground": "#1C0A36",
    "statusBar.noFolderBackground": "#DFD2EE",
    "statusBarItem.hoverBackground": "#9828C912",
    "statusBarItem.activeBackground": "#9828C920",
    "statusBarItem.prominentBackground": "#9828C9",
    "statusBarItem.prominentForeground": "#FFFFFF",
    "gitDecoration.addedResourceForeground": "#16A34A",
    "gitDecoration.modifiedResourceForeground": "#9828C9",
    "gitDecoration.deletedResourceForeground": "#DC2626",
    "gitDecoration.untrackedResourceForeground": "#059669",
    "gitDecoration.ignoredResourceForeground": "#923FDA88",
    "diffEditor.insertedTextBackground": "#16A34A18",
    "diffEditor.removedTextBackground": "#DC262618",
    "input.background": "#F7F4FB",
    "input.foreground": "#1C0A36",
    "input.border": "#C5AEDB",
    "input.placeholderForeground": "#923FDA99",
    "dropdown.background": "#EDE5F6",
    "dropdown.foreground": "#1C0A36",
    "dropdown.border": "#C5AEDB",
    "quickInput.background": "#EDE5F6",
    "quickInput.foreground": "#1C0A36",
    "pickerGroup.border": "#C5AEDB",
    "pickerGroup.foreground": "#9828C9",
    "notificationCenter.border": "#C5AEDB",
    "notificationCenterHeader.background": "#EDE5F6",
    "notificationCenterHeader.foreground": "#1C0A36",
    "notifications.background": "#EDE5F6",
    "notifications.foreground": "#1C0A36",
    "notifications.border": "#C5AEDB",
    "badge.background": "#9828C9",
    "badge.foreground": "#FFFFFF",
    "breadcrumb.background": "#F7F4FB",
    "breadcrumb.foreground": "#5E1D96",
    "breadcrumb.focusForeground": "#1C0A36",
    "breadcrumb.activeSelectionForeground": "#9828C9"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#725B8F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#9828C9"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#6D28D9"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#0E7490"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#B83E0A"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#5E1D96"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#1C0A36"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#1C0A36"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#9828C9"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#9828C9"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#6D28D9"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#9828C9"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#6D28D9"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#0E7490"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#9828C9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#0E7490"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#6D28D9"
      }
    }
  ]
}
