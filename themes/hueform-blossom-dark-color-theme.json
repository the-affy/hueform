{
  "name": "HUEFORM — Blossom Dark",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#FDF1F6",
    "variable.readonly": "#FBBF24",
    "variable.defaultLibrary": "#E94090",
    "parameter": "#FDF1F6",
    "property": "#FDF1F6",
    "property.readonly": "#FBBF24",
    "enumMember": "#FBBF24",
    "function": "#FB8268",
    "method": "#FB8268",
    "class": "#F8A4CE",
    "interface": "#F8A4CE",
    "type": "#F8A4CE",
    "typeParameter": "#F8A4CE",
    "namespace": "#F8A4CE",
    "enum": "#F8A4CE",
    "struct": "#F8A4CE",
    "decorator": "#FB8268",
    "event": "#E94090",
    "keyword": "#E94090",
    "modifier": "#E94090",
    "string": "#FED7AA",
    "number": "#FBBF24",
    "regexp": "#FED7AA",
    "operator": "#E94090",
    "comment": "#986F8D",
    "macro": "#FB8268"
  },
  "colors": {
    "focusBorder": "#E9409088",
    "foreground": "#FDF1F6",
    "disabledForeground": "#F1459B99",
    "widget.shadow": "var(--color-accent)66",
    "widget.border": "#4D2045",
    "selection.background": "#E9409038",
    "descriptionForeground": "#F8A4CE",
    "errorForeground": "#F87171",
    "icon.foreground": "#F8A4CE",
    "window.activeBorder": "#4D2045",
    "window.inactiveBorder": "#2E132A",
    "titleBar.activeBackground": "#1E0C1B",
    "titleBar.activeForeground": "#FDF1F6",
    "titleBar.inactiveBackground": "#1E0C1B",
    "titleBar.inactiveForeground": "#F8A4CE",
    "titleBar.border": "#4D2045",
    "activityBar.background": "#1E0C1B",
    "activityBar.foreground": "#E94090",
    "activityBar.inactiveForeground": "#F8A4CE88",
    "activityBar.border": "#4D2045",
    "activityBar.activeBorder": "#E94090",
    "activityBarBadge.background": "#E94090",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#1E0C1B",
    "sideBar.foreground": "#FDF1F6",
    "sideBar.border": "#4D2045",
    "sideBarTitle.foreground": "#F8A4CE",
    "sideBarSectionHeader.background": "#1E0C1B",
    "sideBarSectionHeader.foreground": "#FDF1F6",
    "sideBarSectionHeader.border": "#4D2045",
    "list.activeSelectionBackground": "#E940902A",
    "list.activeSelectionForeground": "#FDF1F6",
    "list.inactiveSelectionBackground": "#E9409018",
    "list.inactiveSelectionForeground": "#FDF1F6",
    "list.hoverBackground": "#31142C",
    "list.hoverForeground": "#FDF1F6",
    "list.focusBackground": "#E940902A",
    "list.focusForeground": "#FDF1F6",
    "list.highlightForeground": "#E94090",
    "list.dropBackground": "#E9409022",
    "tree.indentGuidesStroke": "#2E132A",
    "editor.background": "#140711",
    "editor.foreground": "#FDF1F6",
    "editorCursor.foreground": "#E94090",
    "editorCursor.background": "#140711",
    "editor.lineHighlightBackground": "#1E0C1B55",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#E9409038",
    "editor.selectionHighlightBackground": "#E9409020",
    "editor.wordHighlightBackground": "#FB718526",
    "editor.wordHighlightBorder": "#FB718566",
    "editor.findMatchBackground": "#E9409050",
    "editor.findMatchHighlightBackground": "#E9409026",
    "editorLineNumber.foreground": "#F1459B88",
    "editorLineNumber.activeForeground": "#E94090",
    "editorIndentGuide.background1": "#2E132A",
    "editorIndentGuide.activeBackground1": "#E9409066",
    "editorWhitespace.foreground": "#2E132A",
    "editorRuler.foreground": "#2E132A",
    "editorBracketHighlight.foreground1": "#E94090",
    "editorBracketHighlight.foreground2": "#FB7185",
    "editorBracketHighlight.foreground3": "#FBBF24",
    "editorBracketHighlight.foreground4": "#FED7AA",
    "editorBracketHighlight.foreground5": "#E94090",
    "editorBracketHighlight.foreground6": "#F8A4CE",
    "editorGroupHeader.tabsBackground": "#1E0C1B",
    "editorGroupHeader.tabsBorder": "#4D2045",
    "editorGroupHeader.noTabsBackground": "#1E0C1B",
    "editorGroup.border": "#4D2045",
    "tab.activeBackground": "#2E0E20",
    "tab.activeForeground": "#FDF1F6",
    "tab.activeBorderTop": "#E94090",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#1E0C1B",
    "tab.inactiveForeground": "#F8A4CE",
    "tab.border": "#4D2045",
    "tab.hoverBackground": "#3E142E",
    "tab.hoverForeground": "#FDF1F6",
    "tab.selectedBackground": "#E9409038",
    "tab.selectedForeground": "#FDF1F6",
    "tab.unfocusedActiveBackground": "#240B1A",
    "tab.unfocusedActiveForeground": "#FDF1F6D9",
    "tab.unfocusedActiveBorderTop": "#E9409088",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#1E0C1B",
    "tab.unfocusedInactiveForeground": "#F8A4CEB3",
    "tab.unfocusedHoverBackground": "#3E142E",
    "tab.unfocusedHoverForeground": "#FDF1F6",
    "tab.lastPinnedBorder": "#4D2045",
    "panel.background": "#291125",
    "panel.border": "#4D2045",
    "panelTitle.activeBorder": "#E94090",
    "panelTitle.activeForeground": "#FDF1F6",
    "panelTitle.inactiveForeground": "#F8A4CE",
    "terminal.background": "#291125",
    "terminal.foreground": "#FDF1F6",
    "terminal.border": "#4D2045",
    "terminal.ansiBlack": "#1E0C1B",
    "terminal.ansiRed": "#FB7185",
    "terminal.ansiGreen": "#34D399",
    "terminal.ansiYellow": "#FBBF24",
    "terminal.ansiBlue": "#E94090",
    "terminal.ansiMagenta": "#F472B6",
    "terminal.ansiCyan": "#67E8F9",
    "terminal.ansiWhite": "#FDF1F6",
    "statusBar.background": "#291125",
    "statusBar.foreground": "#F8A4CE",
    "statusBar.border": "#4D2045",
    "statusBar.debuggingBackground": "#E940902A",
    "statusBar.debuggingForeground": "#FDF1F6",
    "statusBar.noFolderBackground": "#291125",
    "statusBarItem.hoverBackground": "#E9409018",
    "statusBarItem.activeBackground": "#E940902A",
    "statusBarItem.prominentBackground": "#E94090",
    "statusBarItem.prominentForeground": "#000000",
    "gitDecoration.addedResourceForeground": "#4ADE80",
    "gitDecoration.modifiedResourceForeground": "#E94090",
    "gitDecoration.deletedResourceForeground": "#F87171",
    "gitDecoration.untrackedResourceForeground": "#A7F3D0",
    "gitDecoration.ignoredResourceForeground": "#F1459B88",
    "diffEditor.insertedTextBackground": "#4ADE8020",
    "diffEditor.removedTextBackground": "#F8717120",
    "input.background": "#1E0C1B",
    "input.foreground": "#FDF1F6",
    "input.border": "#4D2045",
    "input.placeholderForeground": "#F1459B99",
    "dropdown.background": "#291125",
    "dropdown.foreground": "#FDF1F6",
    "dropdown.border": "#4D2045",
    "quickInput.background": "#291125",
    "quickInput.foreground": "#FDF1F6",
    "pickerGroup.border": "#4D2045",
    "pickerGroup.foreground": "#E94090",
    "notificationCenter.border": "#4D2045",
    "notificationCenterHeader.background": "#1E0C1B",
    "notificationCenterHeader.foreground": "#FDF1F6",
    "notifications.background": "#291125",
    "notifications.foreground": "#FDF1F6",
    "notifications.border": "#4D2045",
    "badge.background": "#E94090",
    "badge.foreground": "#000000",
    "breadcrumb.background": "#140711",
    "breadcrumb.foreground": "#F8A4CE",
    "breadcrumb.focusForeground": "#FDF1F6",
    "breadcrumb.activeSelectionForeground": "#E94090"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#986F8D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#E94090"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#FB8268"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#FED7AA"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#FBBF24"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#F8A4CE"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#FDF1F6"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#FDF1F6"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#E94090"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#E94090"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FB8268"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#E94090"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#FB8268"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#FED7AA"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#E94090",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#FED7AA"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#FB7185"
      }
    }
  ]
}
