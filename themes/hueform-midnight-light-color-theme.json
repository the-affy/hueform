{
  "name": "HUEFORM — Midnight Light",
  "$schema": "vscode://schemas/color-theme",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#09162D",
    "variable.readonly": "#B84A0E",
    "variable.defaultLibrary": "#1D64D8",
    "parameter": "#09162D",
    "property": "#09162D",
    "property.readonly": "#B84A0E",
    "enumMember": "#B84A0E",
    "function": "#1E40AF",
    "method": "#1E40AF",
    "class": "#1B4485",
    "interface": "#1B4485",
    "type": "#1B4485",
    "typeParameter": "#1B4485",
    "namespace": "#1B4485",
    "enum": "#1B4485",
    "struct": "#1B4485",
    "decorator": "#1E40AF",
    "event": "#1D64D8",
    "keyword": "#1D64D8",
    "modifier": "#1D64D8",
    "string": "#157F3B",
    "number": "#B84A0E",
    "regexp": "#157F3B",
    "operator": "#1D64D8",
    "comment": "#526E8F",
    "macro": "#1E40AF"
  },
  "colors": {
    "focusBorder": "#1D64D888",
    "foreground": "#09162D",
    "disabledForeground": "#3170D599",
    "widget.shadow": "#00000018",
    "widget.border": "#B5C8DC",
    "selection.background": "#1D64D82A",
    "descriptionForeground": "#1B4485",
    "errorForeground": "#DC2626",
    "icon.foreground": "#1B4485",
    "window.activeBorder": "#B5C8DC",
    "window.inactiveBorder": "#D4DFEC",
    "titleBar.activeBackground": "#E5ECF4",
    "titleBar.activeForeground": "#09162D",
    "titleBar.inactiveBackground": "#E5ECF4",
    "titleBar.inactiveForeground": "#1B4485",
    "titleBar.border": "#B5C8DC",
    "activityBar.background": "#E5ECF4",
    "activityBar.foreground": "#1D64D8",
    "activityBar.inactiveForeground": "#1B448588",
    "activityBar.border": "#B5C8DC",
    "activityBar.activeBorder": "#1D64D8",
    "activityBarBadge.background": "#1D64D8",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#E5ECF4",
    "sideBar.foreground": "#09162D",
    "sideBar.border": "#B5C8DC",
    "sideBarTitle.foreground": "#1B4485",
    "sideBarSectionHeader.background": "#E5ECF4",
    "sideBarSectionHeader.foreground": "#09162D",
    "sideBarSectionHeader.border": "#B5C8DC",
    "list.activeSelectionBackground": "#1D64D820",
    "list.activeSelectionForeground": "#09162D",
    "list.inactiveSelectionBackground": "#1D64D812",
    "list.inactiveSelectionForeground": "#09162D",
    "list.hoverBackground": "#DEE7F1",
    "list.hoverForeground": "#09162D",
    "list.focusBackground": "#1D64D820",
    "list.focusForeground": "#09162D",
    "list.highlightForeground": "#1D64D8",
    "list.dropBackground": "#1D64D822",
    "tree.indentGuidesStroke": "#D4DFEC",
    "editor.background": "#F3F6FA",
    "editor.foreground": "#09162D",
    "editorCursor.foreground": "#1D64D8",
    "editorCursor.background": "#F3F6FA",
    "editor.lineHighlightBackground": "#E5ECF466",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#1D64D82A",
    "editor.selectionHighlightBackground": "#1D64D818",
    "editor.wordHighlightBackground": "#1E40AF1E",
    "editor.wordHighlightBorder": "#1E40AF66",
    "editor.findMatchBackground": "#1D64D850",
    "editor.findMatchHighlightBackground": "#1D64D826",
    "editorLineNumber.foreground": "#3170D588",
    "editorLineNumber.activeForeground": "#1D64D8",
    "editorIndentGuide.background1": "#D4DFEC",
    "editorIndentGuide.activeBackground1": "#1D64D866",
    "editorWhitespace.foreground": "#D4DFEC",
    "editorRuler.foreground": "#D4DFEC",
    "editorBracketHighlight.foreground1": "#1D64D8",
    "editorBracketHighlight.foreground2": "#1E40AF",
    "editorBracketHighlight.foreground3": "#B84A0E",
    "editorBracketHighlight.foreground4": "#157F3B",
    "editorBracketHighlight.foreground5": "#1D64D8",
    "editorBracketHighlight.foreground6": "#1B4485",
    "editorGroupHeader.tabsBackground": "#E5ECF4",
    "editorGroupHeader.tabsBorder": "#B5C8DC",
    "editorGroupHeader.noTabsBackground": "#E5ECF4",
    "editorGroup.border": "#B5C8DC",
    "tab.activeBackground": "#E2EAF7",
    "tab.activeForeground": "#09162D",
    "tab.activeBorderTop": "#1D64D8",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#E5ECF4",
    "tab.inactiveForeground": "#1B4485",
    "tab.border": "#B5C8DC",
    "tab.hoverBackground": "#C9D9F0",
    "tab.hoverForeground": "#09162D",
    "tab.selectedBackground": "#1D64D82A",
    "tab.selectedForeground": "#09162D",
    "tab.unfocusedActiveBackground": "#E4EBF6",
    "tab.unfocusedActiveForeground": "#09162DD9",
    "tab.unfocusedActiveBorderTop": "#1D64D888",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#E5ECF4",
    "tab.unfocusedInactiveForeground": "#1B4485B3",
    "tab.unfocusedHoverBackground": "#C9D9F0",
    "tab.unfocusedHoverForeground": "#09162D",
    "tab.lastPinnedBorder": "#B5C8DC",
    "panel.background": "#D6E2EE",
    "panel.border": "#B5C8DC",
    "panelTitle.activeBorder": "#1D64D8",
    "panelTitle.activeForeground": "#09162D",
    "panelTitle.inactiveForeground": "#1B4485",
    "terminal.background": "#D6E2EE",
    "terminal.foreground": "#09162D",
    "terminal.border": "#B5C8DC",
    "terminal.ansiBlack": "#09162D",
    "terminal.ansiRed": "#991B1B",
    "terminal.ansiGreen": "#166534",
    "terminal.ansiYellow": "#92400E",
    "terminal.ansiBlue": "#1E40AF",
    "terminal.ansiMagenta": "#6B21A8",
    "terminal.ansiCyan": "#0E7490",
    "terminal.ansiWhite": "#475569",
    "statusBar.background": "#D6E2EE",
    "statusBar.foreground": "#1B4485",
    "statusBar.border": "#B5C8DC",
    "statusBar.debuggingBackground": "#1D64D820",
    "statusBar.debuggingForeground": "#09162D",
    "statusBar.noFolderBackground": "#D6E2EE",
    "statusBarItem.hoverBackground": "#1D64D812",
    "statusBarItem.activeBackground": "#1D64D820",
    "statusBarItem.prominentBackground": "#1D64D8",
    "statusBarItem.prominentForeground": "#FFFFFF",
    "gitDecoration.addedResourceForeground": "#16A34A",
    "gitDecoration.modifiedResourceForeground": "#1D64D8",
    "gitDecoration.deletedResourceForeground": "#DC2626",
    "gitDecoration.untrackedResourceForeground": "#059669",
    "gitDecoration.ignoredResourceForeground": "#3170D588",
    "diffEditor.insertedTextBackground": "#16A34A18",
    "diffEditor.removedTextBackground": "#DC262618",
    "input.background": "#F3F6FA",
    "input.foreground": "#09162D",
    "input.border": "#B5C8DC",
    "input.placeholderForeground": "#3170D599",
    "dropdown.background": "#E5ECF4",
    "dropdown.foreground": "#09162D",
    "dropdown.border": "#B5C8DC",
    "quickInput.background": "#E5ECF4",
    "quickInput.foreground": "#09162D",
    "pickerGroup.border": "#B5C8DC",
    "pickerGroup.foreground": "#1D64D8",
    "notificationCenter.border": "#B5C8DC",
    "notificationCenterHeader.background": "#E5ECF4",
    "notificationCenterHeader.foreground": "#09162D",
    "notifications.background": "#E5ECF4",
    "notifications.foreground": "#09162D",
    "notifications.border": "#B5C8DC",
    "badge.background": "#1D64D8",
    "badge.foreground": "#FFFFFF",
    "breadcrumb.background": "#F3F6FA",
    "breadcrumb.foreground": "#1B4485",
    "breadcrumb.focusForeground": "#09162D",
    "breadcrumb.activeSelectionForeground": "#1D64D8"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#526E8F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#1D64D8"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#1E40AF"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#157F3B"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#B84A0E"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#1B4485"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#09162D"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#09162D"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#1D64D8"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#1D64D8"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#1E40AF"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#1D64D8"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#1E40AF"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#157F3B"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#1D64D8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#157F3B"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#1E40AF"
      }
    }
  ]
}
