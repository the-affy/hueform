{
  "name": "HUEFORM — Lavender Dark",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#F6F4FD",
    "variable.readonly": "#F472B6",
    "variable.defaultLibrary": "#B87CF8",
    "parameter": "#F6F4FD",
    "property": "#F6F4FD",
    "property.readonly": "#F472B6",
    "enumMember": "#F472B6",
    "function": "#9B8AFB",
    "method": "#9B8AFB",
    "class": "#B8A8F8",
    "interface": "#B8A8F8",
    "type": "#B8A8F8",
    "typeParameter": "#B8A8F8",
    "namespace": "#B8A8F8",
    "enum": "#B8A8F8",
    "struct": "#B8A8F8",
    "decorator": "#9B8AFB",
    "event": "#B87CF8",
    "keyword": "#B87CF8",
    "modifier": "#B87CF8",
    "string": "#E5D5FC",
    "number": "#F472B6",
    "regexp": "#E5D5FC",
    "operator": "#9B8AFB",
    "comment": "#8076A5",
    "macro": "#9B8AFB"
  },
  "colors": {
    "focusBorder": "#9B8AFB88",
    "foreground": "#F6F4FD",
    "disabledForeground": "#6B4AF099",
    "widget.shadow": "var(--color-accent)66",
    "widget.border": "#30275C",
    "selection.background": "#9B8AFB38",
    "descriptionForeground": "#B8A8F8",
    "errorForeground": "#F87171",
    "icon.foreground": "#B8A8F8",
    "window.activeBorder": "#30275C",
    "window.inactiveBorder": "#1D1738",
    "titleBar.activeBackground": "#120E25",
    "titleBar.activeForeground": "#F6F4FD",
    "titleBar.inactiveBackground": "#120E25",
    "titleBar.inactiveForeground": "#B8A8F8",
    "titleBar.border": "#30275C",
    "activityBar.background": "#120E25",
    "activityBar.foreground": "#9B8AFB",
    "activityBar.inactiveForeground": "#B8A8F888",
    "activityBar.border": "#30275C",
    "activityBar.activeBorder": "#9B8AFB",
    "activityBarBadge.background": "#9B8AFB",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#120E25",
    "sideBar.foreground": "#F6F4FD",
    "sideBar.border": "#30275C",
    "sideBarTitle.foreground": "#B8A8F8",
    "sideBarSectionHeader.background": "#120E25",
    "sideBarSectionHeader.foreground": "#F6F4FD",
    "sideBarSectionHeader.border": "#30275C",
    "list.activeSelectionBackground": "#9B8AFB2A",
    "list.activeSelectionForeground": "#F6F4FD",
    "list.inactiveSelectionBackground": "#9B8AFB18",
    "list.inactiveSelectionForeground": "#F6F4FD",
    "list.hoverBackground": "#1E183B",
    "list.hoverForeground": "#F6F4FD",
    "list.focusBackground": "#9B8AFB2A",
    "list.focusForeground": "#F6F4FD",
    "list.highlightForeground": "#9B8AFB",
    "list.dropBackground": "#9B8AFB22",
    "tree.indentGuidesStroke": "#1D1738",
    "editor.background": "#0B0819",
    "editor.foreground": "#F6F4FD",
    "editorCursor.foreground": "#9B8AFB",
    "editorCursor.background": "#0B0819",
    "editor.lineHighlightBackground": "#120E2555",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#9B8AFB38",
    "editor.selectionHighlightBackground": "#9B8AFB20",
    "editor.wordHighlightBackground": "#C4B5FD26",
    "editor.wordHighlightBorder": "#C4B5FD66",
    "editor.findMatchBackground": "#9B8AFB50",
    "editor.findMatchHighlightBackground": "#9B8AFB26",
    "editorLineNumber.foreground": "#6B4AF088",
    "editorLineNumber.activeForeground": "#9B8AFB",
    "editorIndentGuide.background1": "#1D1738",
    "editorIndentGuide.activeBackground1": "#9B8AFB66",
    "editorWhitespace.foreground": "#1D1738",
    "editorRuler.foreground": "#1D1738",
    "editorBracketHighlight.foreground1": "#9B8AFB",
    "editorBracketHighlight.foreground2": "#C4B5FD",
    "editorBracketHighlight.foreground3": "#F472B6",
    "editorBracketHighlight.foreground4": "#E5D5FC",
    "editorBracketHighlight.foreground5": "#B87CF8",
    "editorBracketHighlight.foreground6": "#B8A8F8",
    "editorGroupHeader.tabsBackground": "#120E25",
    "editorGroupHeader.tabsBorder": "#30275C",
    "editorGroupHeader.noTabsBackground": "#120E25",
    "editorGroup.border": "#30275C",
    "tab.activeBackground": "#1C1834",
    "tab.activeForeground": "#F6F4FD",
    "tab.activeBorderTop": "#9B8AFB",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#120E25",
    "tab.inactiveForeground": "#B8A8F8",
    "tab.border": "#30275C",
    "tab.hoverBackground": "#282247",
    "tab.hoverForeground": "#F6F4FD",
    "tab.selectedBackground": "#9B8AFB38",
    "tab.selectedForeground": "#F6F4FD",
    "tab.unfocusedActiveBackground": "#151229",
    "tab.unfocusedActiveForeground": "#F6F4FDD9",
    "tab.unfocusedActiveBorderTop": "#9B8AFB88",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#120E25",
    "tab.unfocusedInactiveForeground": "#B8A8F8B3",
    "tab.unfocusedHoverBackground": "#282247",
    "tab.unfocusedHoverForeground": "#F6F4FD",
    "tab.lastPinnedBorder": "#30275C",
    "panel.background": "#191433",
    "panel.border": "#30275C",
    "panelTitle.activeBorder": "#9B8AFB",
    "panelTitle.activeForeground": "#F6F4FD",
    "panelTitle.inactiveForeground": "#B8A8F8",
    "terminal.background": "#191433",
    "terminal.foreground": "#F6F4FD",
    "terminal.border": "#30275C",
    "terminal.ansiBlack": "#120E25",
    "terminal.ansiRed": "#FB7185",
    "terminal.ansiGreen": "#34D399",
    "terminal.ansiYellow": "#FBBF24",
    "terminal.ansiBlue": "#9B8AFB",
    "terminal.ansiMagenta": "#B87CF8",
    "terminal.ansiCyan": "#67E8F9",
    "terminal.ansiWhite": "#F6F4FD",
    "statusBar.background": "#191433",
    "statusBar.foreground": "#B8A8F8",
    "statusBar.border": "#30275C",
    "statusBar.debuggingBackground": "#9B8AFB2A",
    "statusBar.debuggingForeground": "#F6F4FD",
    "statusBar.noFolderBackground": "#191433",
    "statusBarItem.hoverBackground": "#9B8AFB18",
    "statusBarItem.activeBackground": "#9B8AFB2A",
    "statusBarItem.prominentBackground": "#9B8AFB",
    "statusBarItem.prominentForeground": "#000000",
    "gitDecoration.addedResourceForeground": "#4ADE80",
    "gitDecoration.modifiedResourceForeground": "#9B8AFB",
    "gitDecoration.deletedResourceForeground": "#F87171",
    "gitDecoration.untrackedResourceForeground": "#A7F3D0",
    "gitDecoration.ignoredResourceForeground": "#6B4AF088",
    "diffEditor.insertedTextBackground": "#4ADE8020",
    "diffEditor.removedTextBackground": "#F8717120",
    "input.background": "#120E25",
    "input.foreground": "#F6F4FD",
    "input.border": "#30275C",
    "input.placeholderForeground": "#6B4AF099",
    "dropdown.background": "#191433",
    "dropdown.foreground": "#F6F4FD",
    "dropdown.border": "#30275C",
    "quickInput.background": "#191433",
    "quickInput.foreground": "#F6F4FD",
    "pickerGroup.border": "#30275C",
    "pickerGroup.foreground": "#9B8AFB",
    "notificationCenter.border": "#30275C",
    "notificationCenterHeader.background": "#120E25",
    "notificationCenterHeader.foreground": "#F6F4FD",
    "notifications.background": "#191433",
    "notifications.foreground": "#F6F4FD",
    "notifications.border": "#30275C",
    "badge.background": "#9B8AFB",
    "badge.foreground": "#000000",
    "breadcrumb.background": "#0B0819",
    "breadcrumb.foreground": "#B8A8F8",
    "breadcrumb.focusForeground": "#F6F4FD",
    "breadcrumb.activeSelectionForeground": "#9B8AFB"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8076A5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#B87CF8"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#9B8AFB"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#E5D5FC"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#F472B6"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#B8A8F8"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#F6F4FD"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#F6F4FD"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#9B8AFB"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#B87CF8"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#9B8AFB"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#B87CF8"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#9B8AFB"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#E5D5FC"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#9B8AFB",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#E5D5FC"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#C4B5FD"
      }
    }
  ]
}
