{
  "name": "HUEFORM — Sakura Dark",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#FBF0F3",
    "variable.readonly": "#F2B880",
    "variable.defaultLibrary": "#F4728B",
    "parameter": "#FBF0F3",
    "property": "#FBF0F3",
    "property.readonly": "#F2B880",
    "enumMember": "#F2B880",
    "function": "#EE8BA4",
    "method": "#EE8BA4",
    "class": "#E8A2B0",
    "interface": "#E8A2B0",
    "type": "#E8A2B0",
    "typeParameter": "#E8A2B0",
    "namespace": "#E8A2B0",
    "enum": "#E8A2B0",
    "struct": "#E8A2B0",
    "decorator": "#EE8BA4",
    "event": "#F4728B",
    "keyword": "#F4728B",
    "modifier": "#F4728B",
    "string": "#C2D6A4",
    "number": "#F2B880",
    "regexp": "#C2D6A4",
    "operator": "#F4728B",
    "comment": "#8F7388",
    "macro": "#EE8BA4"
  },
  "colors": {
    "focusBorder": "#F4728B88",
    "foreground": "#FBF0F3",
    "disabledForeground": "#D4506B99",
    "widget.shadow": "var(--color-accent)66",
    "widget.border": "#463243",
    "selection.background": "#F4728B38",
    "descriptionForeground": "#E8A2B0",
    "errorForeground": "#F87171",
    "icon.foreground": "#E8A2B0",
    "window.activeBorder": "#463243",
    "window.inactiveBorder": "#2B1F2A",
    "titleBar.activeBackground": "#1D151C",
    "titleBar.activeForeground": "#FBF0F3",
    "titleBar.inactiveBackground": "#1D151C",
    "titleBar.inactiveForeground": "#E8A2B0",
    "titleBar.border": "#463243",
    "activityBar.background": "#1D151C",
    "activityBar.foreground": "#F4728B",
    "activityBar.inactiveForeground": "#E8A2B088",
    "activityBar.border": "#463243",
    "activityBar.activeBorder": "#F4728B",
    "activityBarBadge.background": "#F4728B",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#1D151C",
    "sideBar.foreground": "#FBF0F3",
    "sideBar.border": "#463243",
    "sideBarTitle.foreground": "#E8A2B0",
    "sideBarSectionHeader.background": "#1D151C",
    "sideBarSectionHeader.foreground": "#FBF0F3",
    "sideBarSectionHeader.border": "#463243",
    "list.activeSelectionBackground": "#F4728B2A",
    "list.activeSelectionForeground": "#FBF0F3",
    "list.inactiveSelectionBackground": "#F4728B18",
    "list.inactiveSelectionForeground": "#FBF0F3",
    "list.hoverBackground": "#2D212C",
    "list.hoverForeground": "#FBF0F3",
    "list.focusBackground": "#F4728B2A",
    "list.focusForeground": "#FBF0F3",
    "list.highlightForeground": "#F4728B",
    "list.dropBackground": "#F4728B22",
    "tree.indentGuidesStroke": "#2B1F2A",
    "editor.background": "#130E12",
    "editor.foreground": "#FBF0F3",
    "editorCursor.foreground": "#F4728B",
    "editorCursor.background": "#130E12",
    "editor.lineHighlightBackground": "#1D151C55",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#F4728B38",
    "editor.selectionHighlightBackground": "#F4728B20",
    "editor.wordHighlightBackground": "#F9A8B626",
    "editor.wordHighlightBorder": "#F9A8B666",
    "editor.findMatchBackground": "#F4728B50",
    "editor.findMatchHighlightBackground": "#F4728B26",
    "editorLineNumber.foreground": "#D4506B88",
    "editorLineNumber.activeForeground": "#F4728B",
    "editorIndentGuide.background1": "#2B1F2A",
    "editorIndentGuide.activeBackground1": "#F4728B66",
    "editorWhitespace.foreground": "#2B1F2A",
    "editorRuler.foreground": "#2B1F2A",
    "editorBracketHighlight.foreground1": "#F4728B",
    "editorBracketHighlight.foreground2": "#F9A8B6",
    "editorBracketHighlight.foreground3": "#F2B880",
    "editorBracketHighlight.foreground4": "#C2D6A4",
    "editorBracketHighlight.foreground5": "#F4728B",
    "editorBracketHighlight.foreground6": "#E8A2B0",
    "editorGroupHeader.tabsBackground": "#1D151C",
    "editorGroupHeader.tabsBorder": "#463243",
    "editorGroupHeader.noTabsBackground": "#1D151C",
    "editorGroup.border": "#463243",
    "tab.activeBackground": "#2E1A21",
    "tab.activeForeground": "#FBF0F3",
    "tab.activeBorderTop": "#F4728B",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#1D151C",
    "tab.inactiveForeground": "#E8A2B0",
    "tab.border": "#463243",
    "tab.hoverBackground": "#3F242E",
    "tab.hoverForeground": "#FBF0F3",
    "tab.selectedBackground": "#F4728B38",
    "tab.selectedForeground": "#FBF0F3",
    "tab.unfocusedActiveBackground": "#23151B",
    "tab.unfocusedActiveForeground": "#FBF0F3D9",
    "tab.unfocusedActiveBorderTop": "#F4728B88",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#1D151C",
    "tab.unfocusedInactiveForeground": "#E8A2B0B3",
    "tab.unfocusedHoverBackground": "#3F242E",
    "tab.unfocusedHoverForeground": "#FBF0F3",
    "tab.lastPinnedBorder": "#463243",
    "panel.background": "#271C26",
    "panel.border": "#463243",
    "panelTitle.activeBorder": "#F4728B",
    "panelTitle.activeForeground": "#FBF0F3",
    "panelTitle.inactiveForeground": "#E8A2B0",
    "terminal.background": "#271C26",
    "terminal.foreground": "#FBF0F3",
    "terminal.border": "#463243",
    "terminal.ansiBlack": "#1D151C",
    "terminal.ansiRed": "#F4728B",
    "terminal.ansiGreen": "#4ADE80",
    "terminal.ansiYellow": "#FCD34D",
    "terminal.ansiBlue": "#F9A8B6",
    "terminal.ansiMagenta": "#EE8BA4",
    "terminal.ansiCyan": "#67E8F9",
    "terminal.ansiWhite": "#FBF0F3",
    "statusBar.background": "#271C26",
    "statusBar.foreground": "#E8A2B0",
    "statusBar.border": "#463243",
    "statusBar.debuggingBackground": "#F4728B2A",
    "statusBar.debuggingForeground": "#FBF0F3",
    "statusBar.noFolderBackground": "#271C26",
    "statusBarItem.hoverBackground": "#F4728B18",
    "statusBarItem.activeBackground": "#F4728B2A",
    "statusBarItem.prominentBackground": "#F4728B",
    "statusBarItem.prominentForeground": "#000000",
    "gitDecoration.addedResourceForeground": "#4ADE80",
    "gitDecoration.modifiedResourceForeground": "#F4728B",
    "gitDecoration.deletedResourceForeground": "#F87171",
    "gitDecoration.untrackedResourceForeground": "#A7F3D0",
    "gitDecoration.ignoredResourceForeground": "#D4506B88",
    "diffEditor.insertedTextBackground": "#4ADE8020",
    "diffEditor.removedTextBackground": "#F8717120",
    "input.background": "#1D151C",
    "input.foreground": "#FBF0F3",
    "input.border": "#463243",
    "input.placeholderForeground": "#D4506B99",
    "dropdown.background": "#271C26",
    "dropdown.foreground": "#FBF0F3",
    "dropdown.border": "#463243",
    "quickInput.background": "#271C26",
    "quickInput.foreground": "#FBF0F3",
    "pickerGroup.border": "#463243",
    "pickerGroup.foreground": "#F4728B",
    "notificationCenter.border": "#463243",
    "notificationCenterHeader.background": "#1D151C",
    "notificationCenterHeader.foreground": "#FBF0F3",
    "notifications.background": "#271C26",
    "notifications.foreground": "#FBF0F3",
    "notifications.border": "#463243",
    "badge.background": "#F4728B",
    "badge.foreground": "#000000",
    "breadcrumb.background": "#130E12",
    "breadcrumb.foreground": "#E8A2B0",
    "breadcrumb.focusForeground": "#FBF0F3",
    "breadcrumb.activeSelectionForeground": "#F4728B"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8F7388",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#F4728B"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#EE8BA4"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#C2D6A4"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#F2B880"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#E8A2B0"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#FBF0F3"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#FBF0F3"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#F4728B"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#F4728B"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#EE8BA4"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#F4728B"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#EE8BA4"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#C2D6A4"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#F4728B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#C2D6A4"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#F9A8B6"
      }
    }
  ]
}
