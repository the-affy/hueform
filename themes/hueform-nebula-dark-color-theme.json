{
  "name": "HUEFORM — Nebula Dark",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#F7EEFF",
    "variable.readonly": "#FDBA74",
    "variable.defaultLibrary": "#EE62C8",
    "parameter": "#F7EEFF",
    "property": "#F7EEFF",
    "property.readonly": "#FDBA74",
    "enumMember": "#FDBA74",
    "function": "#A77BFA",
    "method": "#A77BFA",
    "class": "#CA92FA",
    "interface": "#CA92FA",
    "type": "#CA92FA",
    "typeParameter": "#CA92FA",
    "namespace": "#CA92FA",
    "enum": "#CA92FA",
    "struct": "#CA92FA",
    "decorator": "#A77BFA",
    "event": "#EE62C8",
    "keyword": "#EE62C8",
    "modifier": "#EE62C8",
    "string": "#7DD3FC",
    "number": "#FDBA74",
    "regexp": "#7DD3FC",
    "operator": "#EE62C8",
    "comment": "#8870B1",
    "macro": "#A77BFA"
  },
  "colors": {
    "focusBorder": "#EE62C888",
    "foreground": "#F7EEFF",
    "disabledForeground": "#9B30F699",
    "widget.shadow": "var(--color-accent)66",
    "widget.border": "#39246B",
    "selection.background": "#EE62C838",
    "descriptionForeground": "#CA92FA",
    "errorForeground": "#F87171",
    "icon.foreground": "#CA92FA",
    "window.activeBorder": "#39246B",
    "window.inactiveBorder": "#211442",
    "titleBar.activeBackground": "#140C2C",
    "titleBar.activeForeground": "#F7EEFF",
    "titleBar.inactiveBackground": "#140C2C",
    "titleBar.inactiveForeground": "#CA92FA",
    "titleBar.border": "#39246B",
    "activityBar.background": "#140C2C",
    "activityBar.foreground": "#EE62C8",
    "activityBar.inactiveForeground": "#CA92FA88",
    "activityBar.border": "#39246B",
    "activityBar.activeBorder": "#EE62C8",
    "activityBarBadge.background": "#EE62C8",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#140C2C",
    "sideBar.foreground": "#F7EEFF",
    "sideBar.border": "#39246B",
    "sideBarTitle.foreground": "#CA92FA",
    "sideBarSectionHeader.background": "#140C2C",
    "sideBarSectionHeader.foreground": "#F7EEFF",
    "sideBarSectionHeader.border": "#39246B",
    "list.activeSelectionBackground": "#EE62C82A",
    "list.activeSelectionForeground": "#F7EEFF",
    "list.inactiveSelectionBackground": "#EE62C818",
    "list.inactiveSelectionForeground": "#F7EEFF",
    "list.hoverBackground": "#231645",
    "list.hoverForeground": "#F7EEFF",
    "list.focusBackground": "#EE62C82A",
    "list.focusForeground": "#F7EEFF",
    "list.highlightForeground": "#EE62C8",
    "list.dropBackground": "#EE62C822",
    "tree.indentGuidesStroke": "#211442",
    "editor.background": "#0B0618",
    "editor.foreground": "#F7EEFF",
    "editorCursor.foreground": "#EE62C8",
    "editorCursor.background": "#0B0618",
    "editor.lineHighlightBackground": "#140C2C55",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#EE62C838",
    "editor.selectionHighlightBackground": "#EE62C820",
    "editor.wordHighlightBackground": "#8C7AF726",
    "editor.wordHighlightBorder": "#8C7AF766",
    "editor.findMatchBackground": "#EE62C850",
    "editor.findMatchHighlightBackground": "#EE62C826",
    "editorLineNumber.foreground": "#9B30F688",
    "editorLineNumber.activeForeground": "#EE62C8",
    "editorIndentGuide.background1": "#211442",
    "editorIndentGuide.activeBackground1": "#EE62C866",
    "editorWhitespace.foreground": "#211442",
    "editorRuler.foreground": "#211442",
    "editorBracketHighlight.foreground1": "#EE62C8",
    "editorBracketHighlight.foreground2": "#8C7AF7",
    "editorBracketHighlight.foreground3": "#FDBA74",
    "editorBracketHighlight.foreground4": "#7DD3FC",
    "editorBracketHighlight.foreground5": "#EE62C8",
    "editorBracketHighlight.foreground6": "#CA92FA",
    "editorGroupHeader.tabsBackground": "#140C2C",
    "editorGroupHeader.tabsBorder": "#39246B",
    "editorGroupHeader.noTabsBackground": "#140C2C",
    "editorGroup.border": "#39246B",
    "tab.activeBackground": "#26112D",
    "tab.activeForeground": "#F7EEFF",
    "tab.activeBorderTop": "#EE62C8",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#140C2C",
    "tab.inactiveForeground": "#CA92FA",
    "tab.border": "#39246B",
    "tab.hoverBackground": "#371A45",
    "tab.hoverForeground": "#F7EEFF",
    "tab.selectedBackground": "#EE62C838",
    "tab.selectedForeground": "#F7EEFF",
    "tab.unfocusedActiveBackground": "#1B0D25",
    "tab.unfocusedActiveForeground": "#F7EEFFD9",
    "tab.unfocusedActiveBorderTop": "#EE62C888",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#140C2C",
    "tab.unfocusedInactiveForeground": "#CA92FAB3",
    "tab.unfocusedHoverBackground": "#371A45",
    "tab.unfocusedHoverForeground": "#F7EEFF",
    "tab.lastPinnedBorder": "#39246B",
    "panel.background": "#1C123D",
    "panel.border": "#39246B",
    "panelTitle.activeBorder": "#EE62C8",
    "panelTitle.activeForeground": "#F7EEFF",
    "panelTitle.inactiveForeground": "#CA92FA",
    "terminal.background": "#1C123D",
    "terminal.foreground": "#F7EEFF",
    "terminal.border": "#39246B",
    "terminal.ansiBlack": "#140C2C",
    "terminal.ansiRed": "#F43F5E",
    "terminal.ansiGreen": "#34D399",
    "terminal.ansiYellow": "#FBBF24",
    "terminal.ansiBlue": "#8C7AF7",
    "terminal.ansiMagenta": "#EE62C8",
    "terminal.ansiCyan": "#7DD3FC",
    "terminal.ansiWhite": "#F7EEFF",
    "statusBar.background": "#1C123D",
    "statusBar.foreground": "#CA92FA",
    "statusBar.border": "#39246B",
    "statusBar.debuggingBackground": "#EE62C82A",
    "statusBar.debuggingForeground": "#F7EEFF",
    "statusBar.noFolderBackground": "#1C123D",
    "statusBarItem.hoverBackground": "#EE62C818",
    "statusBarItem.activeBackground": "#EE62C82A",
    "statusBarItem.prominentBackground": "#EE62C8",
    "statusBarItem.prominentForeground": "#000000",
    "gitDecoration.addedResourceForeground": "#4ADE80",
    "gitDecoration.modifiedResourceForeground": "#EE62C8",
    "gitDecoration.deletedResourceForeground": "#F87171",
    "gitDecoration.untrackedResourceForeground": "#A7F3D0",
    "gitDecoration.ignoredResourceForeground": "#9B30F688",
    "diffEditor.insertedTextBackground": "#4ADE8020",
    "diffEditor.removedTextBackground": "#F8717120",
    "input.background": "#140C2C",
    "input.foreground": "#F7EEFF",
    "input.border": "#39246B",
    "input.placeholderForeground": "#9B30F699",
    "dropdown.background": "#1C123D",
    "dropdown.foreground": "#F7EEFF",
    "dropdown.border": "#39246B",
    "quickInput.background": "#1C123D",
    "quickInput.foreground": "#F7EEFF",
    "pickerGroup.border": "#39246B",
    "pickerGroup.foreground": "#EE62C8",
    "notificationCenter.border": "#39246B",
    "notificationCenterHeader.background": "#140C2C",
    "notificationCenterHeader.foreground": "#F7EEFF",
    "notifications.background": "#1C123D",
    "notifications.foreground": "#F7EEFF",
    "notifications.border": "#39246B",
    "badge.background": "#EE62C8",
    "badge.foreground": "#000000",
    "breadcrumb.background": "#0B0618",
    "breadcrumb.foreground": "#CA92FA",
    "breadcrumb.focusForeground": "#F7EEFF",
    "breadcrumb.activeSelectionForeground": "#EE62C8"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8870B1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#EE62C8"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#A77BFA"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#7DD3FC"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#FDBA74"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#CA92FA"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#F7EEFF"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#F7EEFF"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#EE62C8"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#EE62C8"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#A77BFA"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#EE62C8"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#A77BFA"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#7DD3FC"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#EE62C8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#7DD3FC"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#8C7AF7"
      }
    }
  ]
}
