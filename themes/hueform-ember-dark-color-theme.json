{
  "name": "HUEFORM — Ember Dark",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#FFF3EB",
    "variable.readonly": "#F87171",
    "variable.defaultLibrary": "#FA741B",
    "parameter": "#FFF3EB",
    "property": "#FFF3EB",
    "property.readonly": "#F87171",
    "enumMember": "#F87171",
    "function": "#F59E0B",
    "method": "#F59E0B",
    "class": "#FDB56C",
    "interface": "#FDB56C",
    "type": "#FDB56C",
    "typeParameter": "#FDB56C",
    "namespace": "#FDB56C",
    "enum": "#FDB56C",
    "struct": "#FDB56C",
    "decorator": "#F59E0B",
    "event": "#FA741B",
    "keyword": "#FA741B",
    "modifier": "#FA741B",
    "string": "#FCD34D",
    "number": "#F87171",
    "regexp": "#FCD34D",
    "operator": "#FA741B",
    "comment": "#9A7363",
    "macro": "#F59E0B"
  },
  "colors": {
    "focusBorder": "#FA741B88",
    "foreground": "#FFF3EB",
    "disabledForeground": "#FC820799",
    "widget.shadow": "var(--color-accent)66",
    "widget.border": "#4B2718",
    "selection.background": "#FA741B38",
    "descriptionForeground": "#FDB56C",
    "errorForeground": "#F87171",
    "icon.foreground": "#FDB56C",
    "window.activeBorder": "#4B2718",
    "window.inactiveBorder": "#2E170E",
    "titleBar.activeBackground": "#1F0F09",
    "titleBar.activeForeground": "#FFF3EB",
    "titleBar.inactiveBackground": "#1F0F09",
    "titleBar.inactiveForeground": "#FDB56C",
    "titleBar.border": "#4B2718",
    "activityBar.background": "#1F0F09",
    "activityBar.foreground": "#FA741B",
    "activityBar.inactiveForeground": "#FDB56C88",
    "activityBar.border": "#4B2718",
    "activityBar.activeBorder": "#FA741B",
    "activityBarBadge.background": "#FA741B",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#1F0F09",
    "sideBar.foreground": "#FFF3EB",
    "sideBar.border": "#4B2718",
    "sideBarTitle.foreground": "#FDB56C",
    "sideBarSectionHeader.background": "#1F0F09",
    "sideBarSectionHeader.foreground": "#FFF3EB",
    "sideBarSectionHeader.border": "#4B2718",
    "list.activeSelectionBackground": "#FA741B2A",
    "list.activeSelectionForeground": "#FFF3EB",
    "list.inactiveSelectionBackground": "#FA741B18",
    "list.inactiveSelectionForeground": "#FFF3EB",
    "list.hoverBackground": "#31190F",
    "list.hoverForeground": "#FFF3EB",
    "list.focusBackground": "#FA741B2A",
    "list.focusForeground": "#FFF3EB",
    "list.highlightForeground": "#FA741B",
    "list.dropBackground": "#FA741B22",
    "tree.indentGuidesStroke": "#2E170E",
    "editor.background": "#140A06",
    "editor.foreground": "#FFF3EB",
    "editorCursor.foreground": "#FA741B",
    "editorCursor.background": "#140A06",
    "editor.lineHighlightBackground": "#1F0F0955",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#FA741B38",
    "editor.selectionHighlightBackground": "#FA741B20",
    "editor.wordHighlightBackground": "#F59E0B26",
    "editor.wordHighlightBorder": "#F59E0B66",
    "editor.findMatchBackground": "#FA741B50",
    "editor.findMatchHighlightBackground": "#FA741B26",
    "editorLineNumber.foreground": "#FC820788",
    "editorLineNumber.activeForeground": "#FA741B",
    "editorIndentGuide.background1": "#2E170E",
    "editorIndentGuide.activeBackground1": "#FA741B66",
    "editorWhitespace.foreground": "#2E170E",
    "editorRuler.foreground": "#2E170E",
    "editorBracketHighlight.foreground1": "#FA741B",
    "editorBracketHighlight.foreground2": "#F59E0B",
    "editorBracketHighlight.foreground3": "#F87171",
    "editorBracketHighlight.foreground4": "#FCD34D",
    "editorBracketHighlight.foreground5": "#FA741B",
    "editorBracketHighlight.foreground6": "#FDB56C",
    "editorGroupHeader.tabsBackground": "#1F0F09",
    "editorGroupHeader.tabsBorder": "#4B2718",
    "editorGroupHeader.noTabsBackground": "#1F0F09",
    "editorGroup.border": "#4B2718",
    "tab.activeBackground": "#301709",
    "tab.activeForeground": "#FFF3EB",
    "tab.activeBorderTop": "#FA741B",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#1F0F09",
    "tab.inactiveForeground": "#FDB56C",
    "tab.border": "#4B2718",
    "tab.hoverBackground": "#421F0C",
    "tab.hoverForeground": "#FFF3EB",
    "tab.selectedBackground": "#FA741B38",
    "tab.selectedForeground": "#FFF3EB",
    "tab.unfocusedActiveBackground": "#251208",
    "tab.unfocusedActiveForeground": "#FFF3EBD9",
    "tab.unfocusedActiveBorderTop": "#FA741B88",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#1F0F09",
    "tab.unfocusedInactiveForeground": "#FDB56CB3",
    "tab.unfocusedHoverBackground": "#421F0C",
    "tab.unfocusedHoverForeground": "#FFF3EB",
    "tab.lastPinnedBorder": "#4B2718",
    "panel.background": "#2A160D",
    "panel.border": "#4B2718",
    "panelTitle.activeBorder": "#FA741B",
    "panelTitle.activeForeground": "#FFF3EB",
    "panelTitle.inactiveForeground": "#FDB56C",
    "terminal.background": "#2A160D",
    "terminal.foreground": "#FFF3EB",
    "terminal.border": "#4B2718",
    "terminal.ansiBlack": "#1F0F09",
    "terminal.ansiRed": "#EF4444",
    "terminal.ansiGreen": "#84CC16",
    "terminal.ansiYellow": "#FBBF24",
    "terminal.ansiBlue": "#FA741B",
    "terminal.ansiMagenta": "#F43F5E",
    "terminal.ansiCyan": "#38BDF8",
    "terminal.ansiWhite": "#FFF3EB",
    "statusBar.background": "#2A160D",
    "statusBar.foreground": "#FDB56C",
    "statusBar.border": "#4B2718",
    "statusBar.debuggingBackground": "#FA741B2A",
    "statusBar.debuggingForeground": "#FFF3EB",
    "statusBar.noFolderBackground": "#2A160D",
    "statusBarItem.hoverBackground": "#FA741B18",
    "statusBarItem.activeBackground": "#FA741B2A",
    "statusBarItem.prominentBackground": "#FA741B",
    "statusBarItem.prominentForeground": "#000000",
    "gitDecoration.addedResourceForeground": "#4ADE80",
    "gitDecoration.modifiedResourceForeground": "#FA741B",
    "gitDecoration.deletedResourceForeground": "#F87171",
    "gitDecoration.untrackedResourceForeground": "#A7F3D0",
    "gitDecoration.ignoredResourceForeground": "#FC820788",
    "diffEditor.insertedTextBackground": "#4ADE8020",
    "diffEditor.removedTextBackground": "#F8717120",
    "input.background": "#1F0F09",
    "input.foreground": "#FFF3EB",
    "input.border": "#4B2718",
    "input.placeholderForeground": "#FC820799",
    "dropdown.background": "#2A160D",
    "dropdown.foreground": "#FFF3EB",
    "dropdown.border": "#4B2718",
    "quickInput.background": "#2A160D",
    "quickInput.foreground": "#FFF3EB",
    "pickerGroup.border": "#4B2718",
    "pickerGroup.foreground": "#FA741B",
    "notificationCenter.border": "#4B2718",
    "notificationCenterHeader.background": "#1F0F09",
    "notificationCenterHeader.foreground": "#FFF3EB",
    "notifications.background": "#2A160D",
    "notifications.foreground": "#FFF3EB",
    "notifications.border": "#4B2718",
    "badge.background": "#FA741B",
    "badge.foreground": "#000000",
    "breadcrumb.background": "#140A06",
    "breadcrumb.foreground": "#FDB56C",
    "breadcrumb.focusForeground": "#FFF3EB",
    "breadcrumb.activeSelectionForeground": "#FA741B"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9A7363",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#FA741B"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#F59E0B"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#FCD34D"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#F87171"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#FDB56C"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#FFF3EB"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#FFF3EB"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#FA741B"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#FA741B"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#F59E0B"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#FA741B"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#F59E0B"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#FCD34D"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#FA741B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#FCD34D"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#F59E0B"
      }
    }
  ]
}
