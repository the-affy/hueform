{
  "name": "HUEFORM — Midnight Dark",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#EBF2FC",
    "variable.readonly": "#F5B06B",
    "variable.defaultLibrary": "#788AF5",
    "parameter": "#EBF2FC",
    "property": "#EBF2FC",
    "property.readonly": "#F5B06B",
    "enumMember": "#F5B06B",
    "function": "#38BAF5",
    "method": "#38BAF5",
    "class": "#87B4ED",
    "interface": "#87B4ED",
    "type": "#87B4ED",
    "typeParameter": "#87B4ED",
    "namespace": "#87B4ED",
    "enum": "#87B4ED",
    "struct": "#87B4ED",
    "decorator": "#38BAF5",
    "event": "#788AF5",
    "keyword": "#788AF5",
    "modifier": "#788AF5",
    "string": "#6EE7B7",
    "number": "#F5B06B",
    "regexp": "#6EE7B7",
    "operator": "#38BAF5",
    "comment": "#657DAA",
    "macro": "#38BAF5"
  },
  "colors": {
    "focusBorder": "#38BAF588",
    "foreground": "#EBF2FC",
    "disabledForeground": "#2E7DE099",
    "widget.shadow": "var(--color-accent)66",
    "widget.border": "#23325B",
    "selection.background": "#38BAF538",
    "descriptionForeground": "#87B4ED",
    "errorForeground": "#F87171",
    "icon.foreground": "#87B4ED",
    "window.activeBorder": "#23325B",
    "window.inactiveBorder": "#151F39",
    "titleBar.activeBackground": "#0D1426",
    "titleBar.activeForeground": "#EBF2FC",
    "titleBar.inactiveBackground": "#0D1426",
    "titleBar.inactiveForeground": "#87B4ED",
    "titleBar.border": "#23325B",
    "activityBar.background": "#0D1426",
    "activityBar.foreground": "#38BAF5",
    "activityBar.inactiveForeground": "#87B4ED88",
    "activityBar.border": "#23325B",
    "activityBar.activeBorder": "#38BAF5",
    "activityBarBadge.background": "#38BAF5",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#0D1426",
    "sideBar.foreground": "#EBF2FC",
    "sideBar.border": "#23325B",
    "sideBarTitle.foreground": "#87B4ED",
    "sideBarSectionHeader.background": "#0D1426",
    "sideBarSectionHeader.foreground": "#EBF2FC",
    "sideBarSectionHeader.border": "#23325B",
    "list.activeSelectionBackground": "#38BAF52A",
    "list.activeSelectionForeground": "#EBF2FC",
    "list.inactiveSelectionBackground": "#38BAF518",
    "list.inactiveSelectionForeground": "#EBF2FC",
    "list.hoverBackground": "#16203B",
    "list.hoverForeground": "#EBF2FC",
    "list.focusBackground": "#38BAF52A",
    "list.focusForeground": "#EBF2FC",
    "list.highlightForeground": "#38BAF5",
    "list.dropBackground": "#38BAF522",
    "tree.indentGuidesStroke": "#151F39",
    "editor.background": "#070B16",
    "editor.foreground": "#EBF2FC",
    "editorCursor.foreground": "#38BAF5",
    "editorCursor.background": "#070B16",
    "editor.lineHighlightBackground": "#0D142655",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#38BAF538",
    "editor.selectionHighlightBackground": "#38BAF520",
    "editor.wordHighlightBackground": "#788AF526",
    "editor.wordHighlightBorder": "#788AF566",
    "editor.findMatchBackground": "#38BAF550",
    "editor.findMatchHighlightBackground": "#38BAF526",
    "editorLineNumber.foreground": "#2E7DE088",
    "editorLineNumber.activeForeground": "#38BAF5",
    "editorIndentGuide.background1": "#151F39",
    "editorIndentGuide.activeBackground1": "#38BAF566",
    "editorWhitespace.foreground": "#151F39",
    "editorRuler.foreground": "#151F39",
    "editorBracketHighlight.foreground1": "#38BAF5",
    "editorBracketHighlight.foreground2": "#788AF5",
    "editorBracketHighlight.foreground3": "#F5B06B",
    "editorBracketHighlight.foreground4": "#6EE7B7",
    "editorBracketHighlight.foreground5": "#788AF5",
    "editorBracketHighlight.foreground6": "#87B4ED",
    "editorGroupHeader.tabsBackground": "#0D1426",
    "editorGroupHeader.tabsBorder": "#23325B",
    "editorGroupHeader.noTabsBackground": "#0D1426",
    "editorGroup.border": "#23325B",
    "tab.activeBackground": "#0D2031",
    "tab.activeForeground": "#EBF2FC",
    "tab.activeBorderTop": "#38BAF5",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#0D1426",
    "tab.inactiveForeground": "#87B4ED",
    "tab.border": "#23325B",
    "tab.hoverBackground": "#142F47",
    "tab.hoverForeground": "#EBF2FC",
    "tab.selectedBackground": "#38BAF538",
    "tab.selectedForeground": "#EBF2FC",
    "tab.unfocusedActiveBackground": "#0B1826",
    "tab.unfocusedActiveForeground": "#EBF2FCD9",
    "tab.unfocusedActiveBorderTop": "#38BAF588",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#0D1426",
    "tab.unfocusedInactiveForeground": "#87B4EDB3",
    "tab.unfocusedHoverBackground": "#142F47",
    "tab.unfocusedHoverForeground": "#EBF2FC",
    "tab.lastPinnedBorder": "#23325B",
    "panel.background": "#141E38",
    "panel.border": "#23325B",
    "panelTitle.activeBorder": "#38BAF5",
    "panelTitle.activeForeground": "#EBF2FC",
    "panelTitle.inactiveForeground": "#87B4ED",
    "terminal.background": "#141E38",
    "terminal.foreground": "#EBF2FC",
    "terminal.border": "#23325B",
    "terminal.ansiBlack": "#0D1426",
    "terminal.ansiRed": "#F87171",
    "terminal.ansiGreen": "#4ADE80",
    "terminal.ansiYellow": "#FBBF24",
    "terminal.ansiBlue": "#38BAF5",
    "terminal.ansiMagenta": "#788AF5",
    "terminal.ansiCyan": "#67E8F9",
    "terminal.ansiWhite": "#EBF2FC",
    "statusBar.background": "#141E38",
    "statusBar.foreground": "#87B4ED",
    "statusBar.border": "#23325B",
    "statusBar.debuggingBackground": "#38BAF52A",
    "statusBar.debuggingForeground": "#EBF2FC",
    "statusBar.noFolderBackground": "#141E38",
    "statusBarItem.hoverBackground": "#38BAF518",
    "statusBarItem.activeBackground": "#38BAF52A",
    "statusBarItem.prominentBackground": "#38BAF5",
    "statusBarItem.prominentForeground": "#000000",
    "gitDecoration.addedResourceForeground": "#4ADE80",
    "gitDecoration.modifiedResourceForeground": "#38BAF5",
    "gitDecoration.deletedResourceForeground": "#F87171",
    "gitDecoration.untrackedResourceForeground": "#A7F3D0",
    "gitDecoration.ignoredResourceForeground": "#2E7DE088",
    "diffEditor.insertedTextBackground": "#4ADE8020",
    "diffEditor.removedTextBackground": "#F8717120",
    "input.background": "#0D1426",
    "input.foreground": "#EBF2FC",
    "input.border": "#23325B",
    "input.placeholderForeground": "#2E7DE099",
    "dropdown.background": "#141E38",
    "dropdown.foreground": "#EBF2FC",
    "dropdown.border": "#23325B",
    "quickInput.background": "#141E38",
    "quickInput.foreground": "#EBF2FC",
    "pickerGroup.border": "#23325B",
    "pickerGroup.foreground": "#38BAF5",
    "notificationCenter.border": "#23325B",
    "notificationCenterHeader.background": "#0D1426",
    "notificationCenterHeader.foreground": "#EBF2FC",
    "notifications.background": "#141E38",
    "notifications.foreground": "#EBF2FC",
    "notifications.border": "#23325B",
    "badge.background": "#38BAF5",
    "badge.foreground": "#000000",
    "breadcrumb.background": "#070B16",
    "breadcrumb.foreground": "#87B4ED",
    "breadcrumb.focusForeground": "#EBF2FC",
    "breadcrumb.activeSelectionForeground": "#38BAF5"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#657DAA",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#788AF5"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#38BAF5"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#6EE7B7"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#F5B06B"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#87B4ED"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#EBF2FC"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#EBF2FC"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#38BAF5"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#788AF5"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#38BAF5"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#788AF5"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#38BAF5"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#6EE7B7"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#38BAF5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#6EE7B7"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#788AF5"
      }
    }
  ]
}
