{
  "name": "SONDER — Ocean Dark",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#EBF5FA",
    "variable.readonly": "#FDBA74",
    "variable.defaultLibrary": "#38BDF8",
    "parameter": "#EBF5FA",
    "property": "#EBF5FA",
    "property.readonly": "#FDBA74",
    "enumMember": "#FDBA74",
    "function": "#22D3EE",
    "method": "#22D3EE",
    "class": "#60C5F8",
    "interface": "#60C5F8",
    "type": "#60C5F8",
    "typeParameter": "#60C5F8",
    "namespace": "#60C5F8",
    "enum": "#60C5F8",
    "struct": "#60C5F8",
    "decorator": "#22D3EE",
    "event": "#38BDF8",
    "keyword": "#38BDF8",
    "modifier": "#38BDF8",
    "string": "#A5F3FC",
    "number": "#FDBA74",
    "regexp": "#A5F3FC",
    "operator": "#22D3EE",
    "comment": "#5C87AC",
    "macro": "#22D3EE"
  },
  "colors": {
    "focusBorder": "#22D3EE88",
    "foreground": "#EBF5FA",
    "disabledForeground": "#0A9DE899",
    "widget.shadow": "#00000066",
    "widget.border": "#1D4262",
    "selection.background": "#22D3EE38",
    "descriptionForeground": "#60C5F8",
    "errorForeground": "#F87171",
    "icon.foreground": "#60C5F8",
    "window.activeBorder": "#1D4262",
    "window.inactiveBorder": "#11293E",
    "titleBar.activeBackground": "#0A1C2B",
    "titleBar.activeForeground": "#EBF5FA",
    "titleBar.inactiveBackground": "#0A1C2B",
    "titleBar.inactiveForeground": "#60C5F8",
    "titleBar.border": "#1D4262",
    "activityBar.background": "#0A1C2B",
    "activityBar.foreground": "#22D3EE",
    "activityBar.inactiveForeground": "#60C5F888",
    "activityBar.border": "#1D4262",
    "activityBar.activeBorder": "#22D3EE",
    "activityBarBadge.background": "#22D3EE",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#0A1C2B",
    "sideBar.foreground": "#EBF5FA",
    "sideBar.border": "#1D4262",
    "sideBarTitle.foreground": "#60C5F8",
    "sideBarSectionHeader.background": "#0A1C2B",
    "sideBarSectionHeader.foreground": "#EBF5FA",
    "sideBarSectionHeader.border": "#1D4262",
    "list.activeSelectionBackground": "#22D3EE2A",
    "list.activeSelectionForeground": "#EBF5FA",
    "list.inactiveSelectionBackground": "#22D3EE18",
    "list.inactiveSelectionForeground": "#EBF5FA",
    "list.hoverBackground": "#122B41",
    "list.hoverForeground": "#EBF5FA",
    "list.focusBackground": "#22D3EE2A",
    "list.focusForeground": "#EBF5FA",
    "list.highlightForeground": "#22D3EE",
    "list.dropBackground": "#22D3EE22",
    "tree.indentGuidesStroke": "#11293E",
    "editor.background": "#05121D",
    "editor.foreground": "#EBF5FA",
    "editorCursor.foreground": "#22D3EE",
    "editorCursor.background": "#05121D",
    "editor.lineHighlightBackground": "#0A1C2B55",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#22D3EE38",
    "editor.selectionHighlightBackground": "#22D3EE20",
    "editor.wordHighlightBackground": "#38BDF826",
    "editor.wordHighlightBorder": "#38BDF866",
    "editor.findMatchBackground": "#22D3EE50",
    "editor.findMatchHighlightBackground": "#22D3EE26",
    "editorLineNumber.foreground": "#0A9DE888",
    "editorLineNumber.activeForeground": "#22D3EE",
    "editorIndentGuide.background1": "#11293E",
    "editorIndentGuide.activeBackground1": "#22D3EE66",
    "editorWhitespace.foreground": "#11293E",
    "editorRuler.foreground": "#11293E",
    "editorBracketHighlight.foreground1": "#22D3EE",
    "editorBracketHighlight.foreground2": "#38BDF8",
    "editorBracketHighlight.foreground3": "#FDBA74",
    "editorBracketHighlight.foreground4": "#A5F3FC",
    "editorBracketHighlight.foreground5": "#38BDF8",
    "editorBracketHighlight.foreground6": "#60C5F8",
    "editorGroupHeader.tabsBackground": "#0A1C2B",
    "editorGroupHeader.tabsBorder": "#1D4262",
    "editorGroupHeader.noTabsBackground": "#0A1C2B",
    "editorGroup.border": "#1D4262",
    "tab.activeBackground": "#082936",
    "tab.activeForeground": "#EBF5FA",
    "tab.activeBorderTop": "#22D3EE",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#0A1C2B",
    "tab.inactiveForeground": "#60C5F8",
    "tab.border": "#1D4262",
    "tab.hoverBackground": "#0E394A",
    "tab.hoverForeground": "#EBF5FA",
    "tab.selectedBackground": "#22D3EE38",
    "tab.selectedForeground": "#EBF5FA",
    "tab.unfocusedActiveBackground": "#07202C",
    "tab.unfocusedActiveForeground": "#EBF5FAD9",
    "tab.unfocusedActiveBorderTop": "#22D3EE88",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#0A1C2B",
    "tab.unfocusedInactiveForeground": "#60C5F8B3",
    "tab.unfocusedHoverBackground": "#0E394A",
    "tab.unfocusedHoverForeground": "#EBF5FA",
    "tab.lastPinnedBorder": "#1D4262",
    "panel.background": "#10283D",
    "panel.border": "#1D4262",
    "panelTitle.activeBorder": "#22D3EE",
    "panelTitle.activeForeground": "#EBF5FA",
    "panelTitle.inactiveForeground": "#60C5F8",
    "terminal.background": "#10283D",
    "terminal.foreground": "#EBF5FA",
    "terminal.border": "#1D4262",
    "terminal.ansiBlack": "#0A1C2B",
    "terminal.ansiRed": "#F87171",
    "terminal.ansiGreen": "#34D399",
    "terminal.ansiYellow": "#FBBF24",
    "terminal.ansiBlue": "#38BDF8",
    "terminal.ansiMagenta": "#818CF8",
    "terminal.ansiCyan": "#22D3EE",
    "terminal.ansiWhite": "#EBF5FA",
    "statusBar.background": "#10283D",
    "statusBar.foreground": "#60C5F8",
    "statusBar.border": "#1D4262",
    "statusBar.debuggingBackground": "#22D3EE2A",
    "statusBar.debuggingForeground": "#EBF5FA",
    "statusBar.noFolderBackground": "#10283D",
    "statusBarItem.hoverBackground": "#22D3EE18",
    "statusBarItem.activeBackground": "#22D3EE2A",
    "statusBarItem.prominentBackground": "#22D3EE",
    "statusBarItem.prominentForeground": "#000000",
    "gitDecoration.addedResourceForeground": "#4ADE80",
    "gitDecoration.modifiedResourceForeground": "#22D3EE",
    "gitDecoration.deletedResourceForeground": "#F87171",
    "gitDecoration.untrackedResourceForeground": "#A7F3D0",
    "gitDecoration.ignoredResourceForeground": "#0A9DE888",
    "diffEditor.insertedTextBackground": "#4ADE8020",
    "diffEditor.removedTextBackground": "#F8717120",
    "input.background": "#0A1C2B",
    "input.foreground": "#EBF5FA",
    "input.border": "#1D4262",
    "input.placeholderForeground": "#0A9DE899",
    "dropdown.background": "#10283D",
    "dropdown.foreground": "#EBF5FA",
    "dropdown.border": "#1D4262",
    "quickInput.background": "#10283D",
    "quickInput.foreground": "#EBF5FA",
    "pickerGroup.border": "#1D4262",
    "pickerGroup.foreground": "#22D3EE",
    "notificationCenter.border": "#1D4262",
    "notificationCenterHeader.background": "#0A1C2B",
    "notificationCenterHeader.foreground": "#EBF5FA",
    "notifications.background": "#10283D",
    "notifications.foreground": "#EBF5FA",
    "notifications.border": "#1D4262",
    "badge.background": "#22D3EE",
    "badge.foreground": "#000000",
    "breadcrumb.background": "#05121D",
    "breadcrumb.foreground": "#60C5F8",
    "breadcrumb.focusForeground": "#EBF5FA",
    "breadcrumb.activeSelectionForeground": "#22D3EE"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5C87AC",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#38BDF8"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#22D3EE"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#A5F3FC"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#FDBA74"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#60C5F8"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#EBF5FA"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#EBF5FA"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#22D3EE"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#38BDF8"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#22D3EE"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#38BDF8"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#22D3EE"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#A5F3FC"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#22D3EE",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#A5F3FC"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#38BDF8"
      }
    }
  ]
}
