{
  "name": "SONDER — Umber Light",
  "$schema": "vscode://schemas/color-theme",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#24180E",
    "variable.readonly": "#AA5515",
    "variable.defaultLibrary": "#9E4324",
    "parameter": "#24180E",
    "property": "#24180E",
    "property.readonly": "#AA5515",
    "enumMember": "#AA5515",
    "function": "#8A5714",
    "method": "#8A5714",
    "class": "#684124",
    "interface": "#684124",
    "type": "#684124",
    "typeParameter": "#684124",
    "namespace": "#684124",
    "enum": "#684124",
    "struct": "#684124",
    "decorator": "#8A5714",
    "event": "#9E4324",
    "keyword": "#9E4324",
    "modifier": "#9E4324",
    "string": "#3D662B",
    "number": "#AA5515",
    "regexp": "#3D662B",
    "operator": "#9E4324",
    "comment": "#75604F",
    "macro": "#8A5714"
  },
  "colors": {
    "focusBorder": "#9E432488",
    "foreground": "#24180E",
    "disabledForeground": "#B4703E99",
    "widget.shadow": "#00000018",
    "widget.border": "#CEC0AF",
    "selection.background": "#9E43242A",
    "descriptionForeground": "#684124",
    "errorForeground": "#DC2626",
    "icon.foreground": "#684124",
    "window.activeBorder": "#CEC0AF",
    "window.inactiveBorder": "#E4DBCF",
    "titleBar.activeBackground": "#F0EAE0",
    "titleBar.activeForeground": "#24180E",
    "titleBar.inactiveBackground": "#F0EAE0",
    "titleBar.inactiveForeground": "#684124",
    "titleBar.border": "#CEC0AF",
    "activityBar.background": "#F0EAE0",
    "activityBar.foreground": "#9E4324",
    "activityBar.inactiveForeground": "#68412488",
    "activityBar.border": "#CEC0AF",
    "activityBar.activeBorder": "#9E4324",
    "activityBarBadge.background": "#9E4324",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#F0EAE0",
    "sideBar.foreground": "#24180E",
    "sideBar.border": "#CEC0AF",
    "sideBarTitle.foreground": "#684124",
    "sideBarSectionHeader.background": "#F0EAE0",
    "sideBarSectionHeader.foreground": "#24180E",
    "sideBarSectionHeader.border": "#CEC0AF",
    "list.activeSelectionBackground": "#9E432420",
    "list.activeSelectionForeground": "#24180E",
    "list.inactiveSelectionBackground": "#9E432412",
    "list.inactiveSelectionForeground": "#24180E",
    "list.hoverBackground": "#EBE3D7",
    "list.hoverForeground": "#24180E",
    "list.focusBackground": "#9E432420",
    "list.focusForeground": "#24180E",
    "list.highlightForeground": "#9E4324",
    "list.dropBackground": "#9E432422",
    "tree.indentGuidesStroke": "#E4DBCF",
    "editor.background": "#FAF7F2",
    "editor.foreground": "#24180E",
    "editorCursor.foreground": "#9E4324",
    "editorCursor.background": "#FAF7F2",
    "editor.lineHighlightBackground": "#F0EAE066",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#9E43242A",
    "editor.selectionHighlightBackground": "#9E432418",
    "editor.wordHighlightBackground": "#8A57141E",
    "editor.wordHighlightBorder": "#8A571466",
    "editor.findMatchBackground": "#9E432450",
    "editor.findMatchHighlightBackground": "#9E432426",
    "editorLineNumber.foreground": "#B4703E88",
    "editorLineNumber.activeForeground": "#9E4324",
    "editorIndentGuide.background1": "#E4DBCF",
    "editorIndentGuide.activeBackground1": "#9E432466",
    "editorWhitespace.foreground": "#E4DBCF",
    "editorRuler.foreground": "#E4DBCF",
    "editorBracketHighlight.foreground1": "#9E4324",
    "editorBracketHighlight.foreground2": "#8A5714",
    "editorBracketHighlight.foreground3": "#AA5515",
    "editorBracketHighlight.foreground4": "#3D662B",
    "editorBracketHighlight.foreground5": "#9E4324",
    "editorBracketHighlight.foreground6": "#684124",
    "editorGroupHeader.tabsBackground": "#F0EAE0",
    "editorGroupHeader.tabsBorder": "#CEC0AF",
    "editorGroupHeader.noTabsBackground": "#F0EAE0",
    "editorGroup.border": "#CEC0AF",
    "tab.activeBackground": "#F3E9E2",
    "tab.activeForeground": "#24180E",
    "tab.activeBorderTop": "#9E4324",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#F0EAE0",
    "tab.inactiveForeground": "#684124",
    "tab.border": "#CEC0AF",
    "tab.hoverBackground": "#E5D3C6",
    "tab.hoverForeground": "#24180E",
    "tab.selectedBackground": "#9E43242A",
    "tab.selectedForeground": "#24180E",
    "tab.unfocusedActiveBackground": "#F2EAE1",
    "tab.unfocusedActiveForeground": "#24180ED9",
    "tab.unfocusedActiveBorderTop": "#9E432488",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#F0EAE0",
    "tab.unfocusedInactiveForeground": "#684124B3",
    "tab.unfocusedHoverBackground": "#E5D3C6",
    "tab.unfocusedHoverForeground": "#24180E",
    "tab.lastPinnedBorder": "#CEC0AF",
    "panel.background": "#E5DCCE",
    "panel.border": "#CEC0AF",
    "panelTitle.activeBorder": "#9E4324",
    "panelTitle.activeForeground": "#24180E",
    "panelTitle.inactiveForeground": "#684124",
    "terminal.background": "#E5DCCE",
    "terminal.foreground": "#24180E",
    "terminal.border": "#CEC0AF",
    "terminal.ansiBlack": "#24180E",
    "terminal.ansiRed": "#9A3412",
    "terminal.ansiGreen": "#166534",
    "terminal.ansiYellow": "#854D0E",
    "terminal.ansiBlue": "#78350F",
    "terminal.ansiMagenta": "#701A75",
    "terminal.ansiCyan": "#0E7490",
    "terminal.ansiWhite": "#475569",
    "statusBar.background": "#E5DCCE",
    "statusBar.foreground": "#684124",
    "statusBar.border": "#CEC0AF",
    "statusBar.debuggingBackground": "#9E432420",
    "statusBar.debuggingForeground": "#24180E",
    "statusBar.noFolderBackground": "#E5DCCE",
    "statusBarItem.hoverBackground": "#9E432412",
    "statusBarItem.activeBackground": "#9E432420",
    "statusBarItem.prominentBackground": "#9E4324",
    "statusBarItem.prominentForeground": "#FFFFFF",
    "gitDecoration.addedResourceForeground": "#16A34A",
    "gitDecoration.modifiedResourceForeground": "#9E4324",
    "gitDecoration.deletedResourceForeground": "#DC2626",
    "gitDecoration.untrackedResourceForeground": "#059669",
    "gitDecoration.ignoredResourceForeground": "#B4703E88",
    "diffEditor.insertedTextBackground": "#16A34A18",
    "diffEditor.removedTextBackground": "#DC262618",
    "input.background": "#FAF7F2",
    "input.foreground": "#24180E",
    "input.border": "#CEC0AF",
    "input.placeholderForeground": "#B4703E99",
    "dropdown.background": "#F0EAE0",
    "dropdown.foreground": "#24180E",
    "dropdown.border": "#CEC0AF",
    "quickInput.background": "#F0EAE0",
    "quickInput.foreground": "#24180E",
    "pickerGroup.border": "#CEC0AF",
    "pickerGroup.foreground": "#9E4324",
    "notificationCenter.border": "#CEC0AF",
    "notificationCenterHeader.background": "#F0EAE0",
    "notificationCenterHeader.foreground": "#24180E",
    "notifications.background": "#F0EAE0",
    "notifications.foreground": "#24180E",
    "notifications.border": "#CEC0AF",
    "badge.background": "#9E4324",
    "badge.foreground": "#FFFFFF",
    "breadcrumb.background": "#FAF7F2",
    "breadcrumb.foreground": "#684124",
    "breadcrumb.focusForeground": "#24180E",
    "breadcrumb.activeSelectionForeground": "#9E4324"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#75604F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#9E4324"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#8A5714"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#3D662B"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#AA5515"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#684124"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#24180E"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#24180E"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#9E4324"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#9E4324"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8A5714"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#9E4324"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#8A5714"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#3D662B"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#9E4324",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#3D662B"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#8A5714"
      }
    }
  ]
}
