{
  "name": "HUEFORM — Ember Light",
  "$schema": "vscode://schemas/color-theme",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#2B0F05",
    "variable.readonly": "#B91C1C",
    "variable.defaultLibrary": "#BD3900",
    "parameter": "#2B0F05",
    "property": "#2B0F05",
    "property.readonly": "#B91C1C",
    "enumMember": "#B91C1C",
    "function": "#9E2E02",
    "method": "#9E2E02",
    "class": "#8F3008",
    "interface": "#8F3008",
    "type": "#8F3008",
    "typeParameter": "#8F3008",
    "namespace": "#8F3008",
    "enum": "#8F3008",
    "struct": "#8F3008",
    "decorator": "#9E2E02",
    "event": "#BD3900",
    "keyword": "#BD3900",
    "modifier": "#BD3900",
    "string": "#824408",
    "number": "#B91C1C",
    "regexp": "#824408",
    "operator": "#BD3900",
    "comment": "#7B5848",
    "macro": "#9E2E02"
  },
  "colors": {
    "focusBorder": "#BD390088",
    "foreground": "#2B0F05",
    "disabledForeground": "#F0500D99",
    "widget.shadow": "#00000018",
    "widget.border": "#CFB7A0",
    "selection.background": "#BD39002A",
    "descriptionForeground": "#8F3008",
    "errorForeground": "#DC2626",
    "icon.foreground": "#8F3008",
    "window.activeBorder": "#CFB7A0",
    "window.inactiveBorder": "#E6D6C6",
    "titleBar.activeBackground": "#F2E6DA",
    "titleBar.activeForeground": "#2B0F05",
    "titleBar.inactiveBackground": "#F2E6DA",
    "titleBar.inactiveForeground": "#8F3008",
    "titleBar.border": "#CFB7A0",
    "activityBar.background": "#F2E6DA",
    "activityBar.foreground": "#BD3900",
    "activityBar.inactiveForeground": "#8F300888",
    "activityBar.border": "#CFB7A0",
    "activityBar.activeBorder": "#BD3900",
    "activityBarBadge.background": "#BD3900",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#F2E6DA",
    "sideBar.foreground": "#2B0F05",
    "sideBar.border": "#CFB7A0",
    "sideBarTitle.foreground": "#8F3008",
    "sideBarSectionHeader.background": "#F2E6DA",
    "sideBarSectionHeader.foreground": "#2B0F05",
    "sideBarSectionHeader.border": "#CFB7A0",
    "list.activeSelectionBackground": "#BD390020",
    "list.activeSelectionForeground": "#2B0F05",
    "list.inactiveSelectionBackground": "#BD390012",
    "list.inactiveSelectionForeground": "#2B0F05",
    "list.hoverBackground": "#EDDED0",
    "list.hoverForeground": "#2B0F05",
    "list.focusBackground": "#BD390020",
    "list.focusForeground": "#2B0F05",
    "list.highlightForeground": "#BD3900",
    "list.dropBackground": "#BD390022",
    "tree.indentGuidesStroke": "#E6D6C6",
    "editor.background": "#FAF3EC",
    "editor.foreground": "#2B0F05",
    "editorCursor.foreground": "#BD3900",
    "editorCursor.background": "#FAF3EC",
    "editor.lineHighlightBackground": "#F2E6DA66",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#BD39002A",
    "editor.selectionHighlightBackground": "#BD390018",
    "editor.wordHighlightBackground": "#9E2E021E",
    "editor.wordHighlightBorder": "#9E2E0266",
    "editor.findMatchBackground": "#BD390050",
    "editor.findMatchHighlightBackground": "#BD390026",
    "editorLineNumber.foreground": "#F0500D88",
    "editorLineNumber.activeForeground": "#BD3900",
    "editorIndentGuide.background1": "#E6D6C6",
    "editorIndentGuide.activeBackground1": "#BD390066",
    "editorWhitespace.foreground": "#E6D6C6",
    "editorRuler.foreground": "#E6D6C6",
    "editorBracketHighlight.foreground1": "#BD3900",
    "editorBracketHighlight.foreground2": "#9E2E02",
    "editorBracketHighlight.foreground3": "#B91C1C",
    "editorBracketHighlight.foreground4": "#824408",
    "editorBracketHighlight.foreground5": "#BD3900",
    "editorBracketHighlight.foreground6": "#8F3008",
    "editorGroupHeader.tabsBackground": "#F2E6DA",
    "editorGroupHeader.tabsBorder": "#CFB7A0",
    "editorGroupHeader.noTabsBackground": "#F2E6DA",
    "editorGroup.border": "#CFB7A0",
    "tab.activeBackground": "#F5E4D9",
    "tab.activeForeground": "#2B0F05",
    "tab.activeBorderTop": "#BD3900",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#F2E6DA",
    "tab.inactiveForeground": "#8F3008",
    "tab.border": "#CFB7A0",
    "tab.hoverBackground": "#EBCEBB",
    "tab.hoverForeground": "#2B0F05",
    "tab.selectedBackground": "#BD39002A",
    "tab.selectedForeground": "#2B0F05",
    "tab.unfocusedActiveBackground": "#F4E5DA",
    "tab.unfocusedActiveForeground": "#2B0F05D9",
    "tab.unfocusedActiveBorderTop": "#BD390088",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#F2E6DA",
    "tab.unfocusedInactiveForeground": "#8F3008B3",
    "tab.unfocusedHoverBackground": "#EBCEBB",
    "tab.unfocusedHoverForeground": "#2B0F05",
    "tab.lastPinnedBorder": "#CFB7A0",
    "panel.background": "#E7D6C6",
    "panel.border": "#CFB7A0",
    "panelTitle.activeBorder": "#BD3900",
    "panelTitle.activeForeground": "#2B0F05",
    "panelTitle.inactiveForeground": "#8F3008",
    "terminal.background": "#E7D6C6",
    "terminal.foreground": "#2B0F05",
    "terminal.border": "#CFB7A0",
    "terminal.ansiBlack": "#2B0F05",
    "terminal.ansiRed": "#9A3412",
    "terminal.ansiGreen": "#166534",
    "terminal.ansiYellow": "#854D0E",
    "terminal.ansiBlue": "#9A3412",
    "terminal.ansiMagenta": "#831843",
    "terminal.ansiCyan": "#0E7490",
    "terminal.ansiWhite": "#475569",
    "statusBar.background": "#E7D6C6",
    "statusBar.foreground": "#8F3008",
    "statusBar.border": "#CFB7A0",
    "statusBar.debuggingBackground": "#BD390020",
    "statusBar.debuggingForeground": "#2B0F05",
    "statusBar.noFolderBackground": "#E7D6C6",
    "statusBarItem.hoverBackground": "#BD390012",
    "statusBarItem.activeBackground": "#BD390020",
    "statusBarItem.prominentBackground": "#BD3900",
    "statusBarItem.prominentForeground": "#FFFFFF",
    "gitDecoration.addedResourceForeground": "#16A34A",
    "gitDecoration.modifiedResourceForeground": "#BD3900",
    "gitDecoration.deletedResourceForeground": "#DC2626",
    "gitDecoration.untrackedResourceForeground": "#059669",
    "gitDecoration.ignoredResourceForeground": "#F0500D88",
    "diffEditor.insertedTextBackground": "#16A34A18",
    "diffEditor.removedTextBackground": "#DC262618",
    "input.background": "#FAF3EC",
    "input.foreground": "#2B0F05",
    "input.border": "#CFB7A0",
    "input.placeholderForeground": "#F0500D99",
    "dropdown.background": "#F2E6DA",
    "dropdown.foreground": "#2B0F05",
    "dropdown.border": "#CFB7A0",
    "quickInput.background": "#F2E6DA",
    "quickInput.foreground": "#2B0F05",
    "pickerGroup.border": "#CFB7A0",
    "pickerGroup.foreground": "#BD3900",
    "notificationCenter.border": "#CFB7A0",
    "notificationCenterHeader.background": "#F2E6DA",
    "notificationCenterHeader.foreground": "#2B0F05",
    "notifications.background": "#F2E6DA",
    "notifications.foreground": "#2B0F05",
    "notifications.border": "#CFB7A0",
    "badge.background": "#BD3900",
    "badge.foreground": "#FFFFFF",
    "breadcrumb.background": "#FAF3EC",
    "breadcrumb.foreground": "#8F3008",
    "breadcrumb.focusForeground": "#2B0F05",
    "breadcrumb.activeSelectionForeground": "#BD3900"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7B5848",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#BD3900"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#9E2E02"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#824408"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#B91C1C"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#8F3008"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#2B0F05"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#2B0F05"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#BD3900"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#BD3900"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#9E2E02"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#BD3900"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#9E2E02"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#824408"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#BD3900",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#824408"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#9E2E02"
      }
    }
  ]
}
