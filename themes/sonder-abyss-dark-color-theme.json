{
  "name": "SONDER — Abyss Dark",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#D5E4EC",
    "variable.readonly": "#E59D62",
    "variable.defaultLibrary": "#3EAABF",
    "parameter": "#D5E4EC",
    "property": "#D5E4EC",
    "property.readonly": "#E59D62",
    "enumMember": "#E59D62",
    "function": "#6BBCCF",
    "method": "#6BBCCF",
    "class": "#80A8B8",
    "interface": "#80A8B8",
    "type": "#80A8B8",
    "typeParameter": "#80A8B8",
    "namespace": "#80A8B8",
    "enum": "#80A8B8",
    "struct": "#80A8B8",
    "decorator": "#6BBCCF",
    "event": "#3EAABF",
    "keyword": "#3EAABF",
    "modifier": "#3EAABF",
    "string": "#7ECEAA",
    "number": "#E59D62",
    "regexp": "#7ECEAA",
    "operator": "#6BBCCF",
    "comment": "#5A8296",
    "macro": "#6BBCCF"
  },
  "colors": {
    "focusBorder": "#3EAABF88",
    "foreground": "#D5E4EC",
    "disabledForeground": "#4B768799",
    "widget.shadow": "var(--color-accent)66",
    "widget.border": "#18364B",
    "selection.background": "#3EAABF38",
    "descriptionForeground": "#80A8B8",
    "errorForeground": "#F87171",
    "icon.foreground": "#80A8B8",
    "window.activeBorder": "#18364B",
    "window.inactiveBorder": "#0E2230",
    "titleBar.activeBackground": "#081722",
    "titleBar.activeForeground": "#D5E4EC",
    "titleBar.inactiveBackground": "#081722",
    "titleBar.inactiveForeground": "#80A8B8",
    "titleBar.border": "#18364B",
    "activityBar.background": "#081722",
    "activityBar.foreground": "#3EAABF",
    "activityBar.inactiveForeground": "#80A8B888",
    "activityBar.border": "#18364B",
    "activityBar.activeBorder": "#3EAABF",
    "activityBarBadge.background": "#3EAABF",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#081722",
    "sideBar.foreground": "#D5E4EC",
    "sideBar.border": "#18364B",
    "sideBarTitle.foreground": "#80A8B8",
    "sideBarSectionHeader.background": "#081722",
    "sideBarSectionHeader.foreground": "#D5E4EC",
    "sideBarSectionHeader.border": "#18364B",
    "list.activeSelectionBackground": "#3EAABF2A",
    "list.activeSelectionForeground": "#D5E4EC",
    "list.inactiveSelectionBackground": "#3EAABF18",
    "list.inactiveSelectionForeground": "#D5E4EC",
    "list.hoverBackground": "#0E2332",
    "list.hoverForeground": "#D5E4EC",
    "list.focusBackground": "#3EAABF2A",
    "list.focusForeground": "#D5E4EC",
    "list.highlightForeground": "#3EAABF",
    "list.dropBackground": "#3EAABF22",
    "tree.indentGuidesStroke": "#0E2230",
    "editor.background": "#040D14",
    "editor.foreground": "#D5E4EC",
    "editorCursor.foreground": "#3EAABF",
    "editorCursor.background": "#040D14",
    "editor.lineHighlightBackground": "#08172255",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#3EAABF38",
    "editor.selectionHighlightBackground": "#3EAABF20",
    "editor.wordHighlightBackground": "#5296A826",
    "editor.wordHighlightBorder": "#5296A866",
    "editor.findMatchBackground": "#3EAABF50",
    "editor.findMatchHighlightBackground": "#3EAABF26",
    "editorLineNumber.foreground": "#4B768788",
    "editorLineNumber.activeForeground": "#3EAABF",
    "editorIndentGuide.background1": "#0E2230",
    "editorIndentGuide.activeBackground1": "#3EAABF66",
    "editorWhitespace.foreground": "#0E2230",
    "editorRuler.foreground": "#0E2230",
    "editorBracketHighlight.foreground1": "#3EAABF",
    "editorBracketHighlight.foreground2": "#5296A8",
    "editorBracketHighlight.foreground3": "#E59D62",
    "editorBracketHighlight.foreground4": "#7ECEAA",
    "editorBracketHighlight.foreground5": "#3EAABF",
    "editorBracketHighlight.foreground6": "#80A8B8",
    "editorGroupHeader.tabsBackground": "#081722",
    "editorGroupHeader.tabsBorder": "#18364B",
    "editorGroupHeader.noTabsBackground": "#081722",
    "editorGroup.border": "#18364B",
    "tab.activeBackground": "#0B2029",
    "tab.activeForeground": "#D5E4EC",
    "tab.activeBorderTop": "#3EAABF",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#081722",
    "tab.inactiveForeground": "#80A8B8",
    "tab.border": "#18364B",
    "tab.hoverBackground": "#112F3B",
    "tab.hoverForeground": "#D5E4EC",
    "tab.selectedBackground": "#3EAABF38",
    "tab.selectedForeground": "#D5E4EC",
    "tab.unfocusedActiveBackground": "#081821",
    "tab.unfocusedActiveForeground": "#D5E4ECD9",
    "tab.unfocusedActiveBorderTop": "#3EAABF88",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#081722",
    "tab.unfocusedInactiveForeground": "#80A8B8B3",
    "tab.unfocusedHoverBackground": "#112F3B",
    "tab.unfocusedHoverForeground": "#D5E4EC",
    "tab.lastPinnedBorder": "#18364B",
    "panel.background": "#0E2130",
    "panel.border": "#18364B",
    "panelTitle.activeBorder": "#3EAABF",
    "panelTitle.activeForeground": "#D5E4EC",
    "panelTitle.inactiveForeground": "#80A8B8",
    "terminal.background": "#0E2130",
    "terminal.foreground": "#D5E4EC",
    "terminal.border": "#18364B",
    "terminal.ansiBlack": "#081722",
    "terminal.ansiRed": "#F87171",
    "terminal.ansiGreen": "#4ADE80",
    "terminal.ansiYellow": "#FBBF24",
    "terminal.ansiBlue": "#3EAABF",
    "terminal.ansiMagenta": "#B89FD6",
    "terminal.ansiCyan": "#38BDF8",
    "terminal.ansiWhite": "#D5E4EC",
    "statusBar.background": "#0E2130",
    "statusBar.foreground": "#80A8B8",
    "statusBar.border": "#18364B",
    "statusBar.debuggingBackground": "#3EAABF2A",
    "statusBar.debuggingForeground": "#D5E4EC",
    "statusBar.noFolderBackground": "#0E2130",
    "statusBarItem.hoverBackground": "#3EAABF18",
    "statusBarItem.activeBackground": "#3EAABF2A",
    "statusBarItem.prominentBackground": "#3EAABF",
    "statusBarItem.prominentForeground": "#000000",
    "gitDecoration.addedResourceForeground": "#4ADE80",
    "gitDecoration.modifiedResourceForeground": "#3EAABF",
    "gitDecoration.deletedResourceForeground": "#F87171",
    "gitDecoration.untrackedResourceForeground": "#A7F3D0",
    "gitDecoration.ignoredResourceForeground": "#4B768788",
    "diffEditor.insertedTextBackground": "#4ADE8020",
    "diffEditor.removedTextBackground": "#F8717120",
    "input.background": "#081722",
    "input.foreground": "#D5E4EC",
    "input.border": "#18364B",
    "input.placeholderForeground": "#4B768799",
    "dropdown.background": "#0E2130",
    "dropdown.foreground": "#D5E4EC",
    "dropdown.border": "#18364B",
    "quickInput.background": "#0E2130",
    "quickInput.foreground": "#D5E4EC",
    "pickerGroup.border": "#18364B",
    "pickerGroup.foreground": "#3EAABF",
    "notificationCenter.border": "#18364B",
    "notificationCenterHeader.background": "#081722",
    "notificationCenterHeader.foreground": "#D5E4EC",
    "notifications.background": "#0E2130",
    "notifications.foreground": "#D5E4EC",
    "notifications.border": "#18364B",
    "badge.background": "#3EAABF",
    "badge.foreground": "#000000",
    "breadcrumb.background": "#040D14",
    "breadcrumb.foreground": "#80A8B8",
    "breadcrumb.focusForeground": "#D5E4EC",
    "breadcrumb.activeSelectionForeground": "#3EAABF"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5A8296",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#3EAABF"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#6BBCCF"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#7ECEAA"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#E59D62"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#80A8B8"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#D5E4EC"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#D5E4EC"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#6BBCCF"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#3EAABF"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#6BBCCF"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#3EAABF"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#6BBCCF"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#7ECEAA"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#3EAABF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#7ECEAA"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#5296A8"
      }
    }
  ]
}
