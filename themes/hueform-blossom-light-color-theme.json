{
  "name": "HUEFORM — Blossom Light",
  "$schema": "vscode://schemas/color-theme",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#2B0D18",
    "variable.readonly": "#B45309",
    "variable.defaultLibrary": "#C41C5E",
    "parameter": "#2B0D18",
    "property": "#2B0D18",
    "property.readonly": "#B45309",
    "enumMember": "#B45309",
    "function": "#A3164D",
    "method": "#A3164D",
    "class": "#7A1A40",
    "interface": "#7A1A40",
    "type": "#7A1A40",
    "typeParameter": "#7A1A40",
    "namespace": "#7A1A40",
    "enum": "#7A1A40",
    "struct": "#7A1A40",
    "decorator": "#A3164D",
    "event": "#C41C5E",
    "keyword": "#C41C5E",
    "modifier": "#C41C5E",
    "string": "#9E3610",
    "number": "#B45309",
    "regexp": "#9E3610",
    "operator": "#C41C5E",
    "comment": "#7F5462",
    "macro": "#A3164D"
  },
  "colors": {
    "focusBorder": "#C41C5E88",
    "foreground": "#2B0D18",
    "disabledForeground": "#CE2C6C99",
    "widget.shadow": "#00000018",
    "widget.border": "#DAB9B2",
    "selection.background": "#C41C5E2A",
    "descriptionForeground": "#7A1A40",
    "errorForeground": "#DC2626",
    "icon.foreground": "#7A1A40",
    "window.activeBorder": "#DAB9B2",
    "window.inactiveBorder": "#ECD6D2",
    "titleBar.activeBackground": "#F6E6E3",
    "titleBar.activeForeground": "#2B0D18",
    "titleBar.inactiveBackground": "#F6E6E3",
    "titleBar.inactiveForeground": "#7A1A40",
    "titleBar.border": "#DAB9B2",
    "activityBar.background": "#F6E6E3",
    "activityBar.foreground": "#C41C5E",
    "activityBar.inactiveForeground": "#7A1A4088",
    "activityBar.border": "#DAB9B2",
    "activityBar.activeBorder": "#C41C5E",
    "activityBarBadge.background": "#C41C5E",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#F6E6E3",
    "sideBar.foreground": "#2B0D18",
    "sideBar.border": "#DAB9B2",
    "sideBarTitle.foreground": "#7A1A40",
    "sideBarSectionHeader.background": "#F6E6E3",
    "sideBarSectionHeader.foreground": "#2B0D18",
    "sideBarSectionHeader.border": "#DAB9B2",
    "list.activeSelectionBackground": "#C41C5E20",
    "list.activeSelectionForeground": "#2B0D18",
    "list.inactiveSelectionBackground": "#C41C5E12",
    "list.inactiveSelectionForeground": "#2B0D18",
    "list.hoverBackground": "#F1DEDA",
    "list.hoverForeground": "#2B0D18",
    "list.focusBackground": "#C41C5E20",
    "list.focusForeground": "#2B0D18",
    "list.highlightForeground": "#C41C5E",
    "list.dropBackground": "#C41C5E22",
    "tree.indentGuidesStroke": "#ECD6D2",
    "editor.background": "#FCF3F2",
    "editor.foreground": "#2B0D18",
    "editorCursor.foreground": "#C41C5E",
    "editorCursor.background": "#FCF3F2",
    "editor.lineHighlightBackground": "#F6E6E366",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#C41C5E2A",
    "editor.selectionHighlightBackground": "#C41C5E18",
    "editor.wordHighlightBackground": "#A3164D1E",
    "editor.wordHighlightBorder": "#A3164D66",
    "editor.findMatchBackground": "#C41C5E50",
    "editor.findMatchHighlightBackground": "#C41C5E26",
    "editorLineNumber.foreground": "#CE2C6C88",
    "editorLineNumber.activeForeground": "#C41C5E",
    "editorIndentGuide.background1": "#ECD6D2",
    "editorIndentGuide.activeBackground1": "#C41C5E66",
    "editorWhitespace.foreground": "#ECD6D2",
    "editorRuler.foreground": "#ECD6D2",
    "editorBracketHighlight.foreground1": "#C41C5E",
    "editorBracketHighlight.foreground2": "#A3164D",
    "editorBracketHighlight.foreground3": "#B45309",
    "editorBracketHighlight.foreground4": "#9E3610",
    "editorBracketHighlight.foreground5": "#C41C5E",
    "editorBracketHighlight.foreground6": "#7A1A40",
    "editorGroupHeader.tabsBackground": "#F6E6E3",
    "editorGroupHeader.tabsBorder": "#DAB9B2",
    "editorGroupHeader.noTabsBackground": "#F6E6E3",
    "editorGroup.border": "#DAB9B2",
    "tab.activeBackground": "#F8E2E6",
    "tab.activeForeground": "#2B0D18",
    "tab.activeBorderTop": "#C41C5E",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#F6E6E3",
    "tab.inactiveForeground": "#7A1A40",
    "tab.border": "#DAB9B2",
    "tab.hoverBackground": "#EFCAD0",
    "tab.hoverForeground": "#2B0D18",
    "tab.selectedBackground": "#C41C5E2A",
    "tab.selectedForeground": "#2B0D18",
    "tab.unfocusedActiveBackground": "#F7E4E5",
    "tab.unfocusedActiveForeground": "#2B0D18D9",
    "tab.unfocusedActiveBorderTop": "#C41C5E88",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#F6E6E3",
    "tab.unfocusedInactiveForeground": "#7A1A40B3",
    "tab.unfocusedHoverBackground": "#EFCAD0",
    "tab.unfocusedHoverForeground": "#2B0D18",
    "tab.lastPinnedBorder": "#DAB9B2",
    "panel.background": "#ECD6D1",
    "panel.border": "#DAB9B2",
    "panelTitle.activeBorder": "#C41C5E",
    "panelTitle.activeForeground": "#2B0D18",
    "panelTitle.inactiveForeground": "#7A1A40",
    "terminal.background": "#ECD6D1",
    "terminal.foreground": "#2B0D18",
    "terminal.border": "#DAB9B2",
    "terminal.ansiBlack": "#2B0D18",
    "terminal.ansiRed": "#9F1239",
    "terminal.ansiGreen": "#166534",
    "terminal.ansiYellow": "#92400E",
    "terminal.ansiBlue": "#7A1A40",
    "terminal.ansiMagenta": "#86198F",
    "terminal.ansiCyan": "#0E7490",
    "terminal.ansiWhite": "#475569",
    "statusBar.background": "#ECD6D1",
    "statusBar.foreground": "#7A1A40",
    "statusBar.border": "#DAB9B2",
    "statusBar.debuggingBackground": "#C41C5E20",
    "statusBar.debuggingForeground": "#2B0D18",
    "statusBar.noFolderBackground": "#ECD6D1",
    "statusBarItem.hoverBackground": "#C41C5E12",
    "statusBarItem.activeBackground": "#C41C5E20",
    "statusBarItem.prominentBackground": "#C41C5E",
    "statusBarItem.prominentForeground": "#FFFFFF",
    "gitDecoration.addedResourceForeground": "#16A34A",
    "gitDecoration.modifiedResourceForeground": "#C41C5E",
    "gitDecoration.deletedResourceForeground": "#DC2626",
    "gitDecoration.untrackedResourceForeground": "#059669",
    "gitDecoration.ignoredResourceForeground": "#CE2C6C88",
    "diffEditor.insertedTextBackground": "#16A34A18",
    "diffEditor.removedTextBackground": "#DC262618",
    "input.background": "#FCF3F2",
    "input.foreground": "#2B0D18",
    "input.border": "#DAB9B2",
    "input.placeholderForeground": "#CE2C6C99",
    "dropdown.background": "#F6E6E3",
    "dropdown.foreground": "#2B0D18",
    "dropdown.border": "#DAB9B2",
    "quickInput.background": "#F6E6E3",
    "quickInput.foreground": "#2B0D18",
    "pickerGroup.border": "#DAB9B2",
    "pickerGroup.foreground": "#C41C5E",
    "notificationCenter.border": "#DAB9B2",
    "notificationCenterHeader.background": "#F6E6E3",
    "notificationCenterHeader.foreground": "#2B0D18",
    "notifications.background": "#F6E6E3",
    "notifications.foreground": "#2B0D18",
    "notifications.border": "#DAB9B2",
    "badge.background": "#C41C5E",
    "badge.foreground": "#FFFFFF",
    "breadcrumb.background": "#FCF3F2",
    "breadcrumb.foreground": "#7A1A40",
    "breadcrumb.focusForeground": "#2B0D18",
    "breadcrumb.activeSelectionForeground": "#C41C5E"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7F5462",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#C41C5E"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#A3164D"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#9E3610"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#B45309"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#7A1A40"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#2B0D18"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#2B0D18"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#C41C5E"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#C41C5E"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#A3164D"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#C41C5E"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#A3164D"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#9E3610"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#C41C5E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#9E3610"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#A3164D"
      }
    }
  ]
}
