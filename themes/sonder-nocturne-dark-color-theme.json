{
  "name": "SONDER — Nocturne Dark",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#EFEBF7",
    "variable.readonly": "#DEAC62",
    "variable.defaultLibrary": "#D47FA6",
    "parameter": "#EFEBF7",
    "property": "#EFEBF7",
    "property.readonly": "#DEAC62",
    "enumMember": "#DEAC62",
    "function": "#A77DC8",
    "method": "#A77DC8",
    "class": "#B89FD6",
    "interface": "#B89FD6",
    "type": "#B89FD6",
    "typeParameter": "#B89FD6",
    "namespace": "#B89FD6",
    "enum": "#B89FD6",
    "struct": "#B89FD6",
    "decorator": "#A77DC8",
    "event": "#D47FA6",
    "keyword": "#D47FA6",
    "modifier": "#D47FA6",
    "string": "#E0CCA0",
    "number": "#DEAC62",
    "regexp": "#E0CCA0",
    "operator": "#BA8BD9",
    "comment": "#8177A1",
    "macro": "#A77DC8"
  },
  "colors": {
    "focusBorder": "#A77DC888",
    "foreground": "#EFEBF7",
    "disabledForeground": "#8358B799",
    "widget.shadow": "var(--color-accent)66",
    "widget.border": "#2B2745",
    "selection.background": "#A77DC838",
    "descriptionForeground": "#B89FD6",
    "errorForeground": "#F87171",
    "icon.foreground": "#B89FD6",
    "window.activeBorder": "#2B2745",
    "window.inactiveBorder": "#1B182D",
    "titleBar.activeBackground": "#121020",
    "titleBar.activeForeground": "#EFEBF7",
    "titleBar.inactiveBackground": "#121020",
    "titleBar.inactiveForeground": "#B89FD6",
    "titleBar.border": "#2B2745",
    "activityBar.background": "#121020",
    "activityBar.foreground": "#A77DC8",
    "activityBar.inactiveForeground": "#B89FD688",
    "activityBar.border": "#2B2745",
    "activityBar.activeBorder": "#A77DC8",
    "activityBarBadge.background": "#A77DC8",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#121020",
    "sideBar.foreground": "#EFEBF7",
    "sideBar.border": "#2B2745",
    "sideBarTitle.foreground": "#B89FD6",
    "sideBarSectionHeader.background": "#121020",
    "sideBarSectionHeader.foreground": "#EFEBF7",
    "sideBarSectionHeader.border": "#2B2745",
    "list.activeSelectionBackground": "#A77DC82A",
    "list.activeSelectionForeground": "#EFEBF7",
    "list.inactiveSelectionBackground": "#A77DC818",
    "list.inactiveSelectionForeground": "#EFEBF7",
    "list.hoverBackground": "#1C192F",
    "list.hoverForeground": "#EFEBF7",
    "list.focusBackground": "#A77DC82A",
    "list.focusForeground": "#EFEBF7",
    "list.highlightForeground": "#A77DC8",
    "list.dropBackground": "#A77DC822",
    "tree.indentGuidesStroke": "#1B182D",
    "editor.background": "#0A0912",
    "editor.foreground": "#EFEBF7",
    "editorCursor.foreground": "#A77DC8",
    "editorCursor.background": "#0A0912",
    "editor.lineHighlightBackground": "#12102055",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#A77DC838",
    "editor.selectionHighlightBackground": "#A77DC820",
    "editor.wordHighlightBackground": "#C88EE026",
    "editor.wordHighlightBorder": "#C88EE066",
    "editor.findMatchBackground": "#A77DC850",
    "editor.findMatchHighlightBackground": "#A77DC826",
    "editorLineNumber.foreground": "#8358B788",
    "editorLineNumber.activeForeground": "#A77DC8",
    "editorIndentGuide.background1": "#1B182D",
    "editorIndentGuide.activeBackground1": "#A77DC866",
    "editorWhitespace.foreground": "#1B182D",
    "editorRuler.foreground": "#1B182D",
    "editorBracketHighlight.foreground1": "#A77DC8",
    "editorBracketHighlight.foreground2": "#C88EE0",
    "editorBracketHighlight.foreground3": "#DEAC62",
    "editorBracketHighlight.foreground4": "#E0CCA0",
    "editorBracketHighlight.foreground5": "#D47FA6",
    "editorBracketHighlight.foreground6": "#B89FD6",
    "editorGroupHeader.tabsBackground": "#121020",
    "editorGroupHeader.tabsBorder": "#2B2745",
    "editorGroupHeader.noTabsBackground": "#121020",
    "editorGroup.border": "#2B2745",
    "tab.activeBackground": "#1D1728",
    "tab.activeForeground": "#EFEBF7",
    "tab.activeBorderTop": "#A77DC8",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#121020",
    "tab.inactiveForeground": "#B89FD6",
    "tab.border": "#2B2745",
    "tab.hoverBackground": "#2A213B",
    "tab.hoverForeground": "#EFEBF7",
    "tab.selectedBackground": "#A77DC838",
    "tab.selectedForeground": "#EFEBF7",
    "tab.unfocusedActiveBackground": "#15111F",
    "tab.unfocusedActiveForeground": "#EFEBF7D9",
    "tab.unfocusedActiveBorderTop": "#A77DC888",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#121020",
    "tab.unfocusedInactiveForeground": "#B89FD6B3",
    "tab.unfocusedHoverBackground": "#2A213B",
    "tab.unfocusedHoverForeground": "#EFEBF7",
    "tab.lastPinnedBorder": "#2B2745",
    "panel.background": "#19172A",
    "panel.border": "#2B2745",
    "panelTitle.activeBorder": "#A77DC8",
    "panelTitle.activeForeground": "#EFEBF7",
    "panelTitle.inactiveForeground": "#B89FD6",
    "terminal.background": "#19172A",
    "terminal.foreground": "#EFEBF7",
    "terminal.border": "#2B2745",
    "terminal.ansiBlack": "#121020",
    "terminal.ansiRed": "#FB7185",
    "terminal.ansiGreen": "#4ADE80",
    "terminal.ansiYellow": "#FBBF24",
    "terminal.ansiBlue": "#A77DC8",
    "terminal.ansiMagenta": "#C88EE0",
    "terminal.ansiCyan": "#67E8F9",
    "terminal.ansiWhite": "#EFEBF7",
    "statusBar.background": "#19172A",
    "statusBar.foreground": "#B89FD6",
    "statusBar.border": "#2B2745",
    "statusBar.debuggingBackground": "#A77DC82A",
    "statusBar.debuggingForeground": "#EFEBF7",
    "statusBar.noFolderBackground": "#19172A",
    "statusBarItem.hoverBackground": "#A77DC818",
    "statusBarItem.activeBackground": "#A77DC82A",
    "statusBarItem.prominentBackground": "#A77DC8",
    "statusBarItem.prominentForeground": "#000000",
    "gitDecoration.addedResourceForeground": "#4ADE80",
    "gitDecoration.modifiedResourceForeground": "#A77DC8",
    "gitDecoration.deletedResourceForeground": "#F87171",
    "gitDecoration.untrackedResourceForeground": "#A7F3D0",
    "gitDecoration.ignoredResourceForeground": "#8358B788",
    "diffEditor.insertedTextBackground": "#4ADE8020",
    "diffEditor.removedTextBackground": "#F8717120",
    "input.background": "#121020",
    "input.foreground": "#EFEBF7",
    "input.border": "#2B2745",
    "input.placeholderForeground": "#8358B799",
    "dropdown.background": "#19172A",
    "dropdown.foreground": "#EFEBF7",
    "dropdown.border": "#2B2745",
    "quickInput.background": "#19172A",
    "quickInput.foreground": "#EFEBF7",
    "pickerGroup.border": "#2B2745",
    "pickerGroup.foreground": "#A77DC8",
    "notificationCenter.border": "#2B2745",
    "notificationCenterHeader.background": "#121020",
    "notificationCenterHeader.foreground": "#EFEBF7",
    "notifications.background": "#19172A",
    "notifications.foreground": "#EFEBF7",
    "notifications.border": "#2B2745",
    "badge.background": "#A77DC8",
    "badge.foreground": "#000000",
    "breadcrumb.background": "#0A0912",
    "breadcrumb.foreground": "#B89FD6",
    "breadcrumb.focusForeground": "#EFEBF7",
    "breadcrumb.activeSelectionForeground": "#A77DC8"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8177A1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#D47FA6"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#A77DC8"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#E0CCA0"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#DEAC62"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#B89FD6"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#EFEBF7"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#EFEBF7"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#BA8BD9"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#D47FA6"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#A77DC8"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#D47FA6"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#A77DC8"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#E0CCA0"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#A77DC8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#E0CCA0"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#C88EE0"
      }
    }
  ]
}
