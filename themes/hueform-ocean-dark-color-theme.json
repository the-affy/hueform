{
  "name": "HUEFORM — Ocean Dark",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#EBF6FC",
    "variable.readonly": "#FBBF24",
    "variable.defaultLibrary": "#14D2E6",
    "parameter": "#EBF6FC",
    "property": "#EBF6FC",
    "property.readonly": "#FBBF24",
    "enumMember": "#FBBF24",
    "function": "#38BDF8",
    "method": "#38BDF8",
    "class": "#52C2F8",
    "interface": "#52C2F8",
    "type": "#52C2F8",
    "typeParameter": "#52C2F8",
    "namespace": "#52C2F8",
    "enum": "#52C2F8",
    "struct": "#52C2F8",
    "decorator": "#38BDF8",
    "event": "#14D2E6",
    "keyword": "#14D2E6",
    "modifier": "#14D2E6",
    "string": "#98F5D8",
    "number": "#FBBF24",
    "regexp": "#98F5D8",
    "operator": "#14D2E6",
    "comment": "#5684A8",
    "macro": "#38BDF8"
  },
  "colors": {
    "focusBorder": "#14D2E688",
    "foreground": "#EBF6FC",
    "disabledForeground": "#0997DB99",
    "widget.shadow": "var(--color-accent)66",
    "widget.border": "#1A4970",
    "selection.background": "#14D2E638",
    "descriptionForeground": "#52C2F8",
    "errorForeground": "#F87171",
    "icon.foreground": "#52C2F8",
    "window.activeBorder": "#1A4970",
    "window.inactiveBorder": "#0E2E48",
    "titleBar.activeBackground": "#081F33",
    "titleBar.activeForeground": "#EBF6FC",
    "titleBar.inactiveBackground": "#081F33",
    "titleBar.inactiveForeground": "#52C2F8",
    "titleBar.border": "#1A4970",
    "activityBar.background": "#081F33",
    "activityBar.foreground": "#14D2E6",
    "activityBar.inactiveForeground": "#52C2F888",
    "activityBar.border": "#1A4970",
    "activityBar.activeBorder": "#14D2E6",
    "activityBarBadge.background": "#14D2E6",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#081F33",
    "sideBar.foreground": "#EBF6FC",
    "sideBar.border": "#1A4970",
    "sideBarTitle.foreground": "#52C2F8",
    "sideBarSectionHeader.background": "#081F33",
    "sideBarSectionHeader.foreground": "#EBF6FC",
    "sideBarSectionHeader.border": "#1A4970",
    "list.activeSelectionBackground": "#14D2E62A",
    "list.activeSelectionForeground": "#EBF6FC",
    "list.inactiveSelectionBackground": "#14D2E618",
    "list.inactiveSelectionForeground": "#EBF6FC",
    "list.hoverBackground": "#0F304B",
    "list.hoverForeground": "#EBF6FC",
    "list.focusBackground": "#14D2E62A",
    "list.focusForeground": "#EBF6FC",
    "list.highlightForeground": "#14D2E6",
    "list.dropBackground": "#14D2E622",
    "tree.indentGuidesStroke": "#0E2E48",
    "editor.background": "#041322",
    "editor.foreground": "#EBF6FC",
    "editorCursor.foreground": "#14D2E6",
    "editorCursor.background": "#041322",
    "editor.lineHighlightBackground": "#081F3355",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#14D2E638",
    "editor.selectionHighlightBackground": "#14D2E620",
    "editor.wordHighlightBackground": "#38BDF826",
    "editor.wordHighlightBorder": "#38BDF866",
    "editor.findMatchBackground": "#14D2E650",
    "editor.findMatchHighlightBackground": "#14D2E626",
    "editorLineNumber.foreground": "#0997DB88",
    "editorLineNumber.activeForeground": "#14D2E6",
    "editorIndentGuide.background1": "#0E2E48",
    "editorIndentGuide.activeBackground1": "#14D2E666",
    "editorWhitespace.foreground": "#0E2E48",
    "editorRuler.foreground": "#0E2E48",
    "editorBracketHighlight.foreground1": "#14D2E6",
    "editorBracketHighlight.foreground2": "#38BDF8",
    "editorBracketHighlight.foreground3": "#FBBF24",
    "editorBracketHighlight.foreground4": "#98F5D8",
    "editorBracketHighlight.foreground5": "#14D2E6",
    "editorBracketHighlight.foreground6": "#52C2F8",
    "editorGroupHeader.tabsBackground": "#081F33",
    "editorGroupHeader.tabsBorder": "#1A4970",
    "editorGroupHeader.noTabsBackground": "#081F33",
    "editorGroup.border": "#1A4970",
    "tab.activeBackground": "#062A3A",
    "tab.activeForeground": "#EBF6FC",
    "tab.activeBorderTop": "#14D2E6",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#081F33",
    "tab.inactiveForeground": "#52C2F8",
    "tab.border": "#1A4970",
    "tab.hoverBackground": "#0A3C50",
    "tab.hoverForeground": "#EBF6FC",
    "tab.selectedBackground": "#14D2E638",
    "tab.selectedForeground": "#EBF6FC",
    "tab.unfocusedActiveBackground": "#052130",
    "tab.unfocusedActiveForeground": "#EBF6FCD9",
    "tab.unfocusedActiveBorderTop": "#14D2E688",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#081F33",
    "tab.unfocusedInactiveForeground": "#52C2F8B3",
    "tab.unfocusedHoverBackground": "#0A3C50",
    "tab.unfocusedHoverForeground": "#EBF6FC",
    "tab.lastPinnedBorder": "#1A4970",
    "panel.background": "#0E2B45",
    "panel.border": "#1A4970",
    "panelTitle.activeBorder": "#14D2E6",
    "panelTitle.activeForeground": "#EBF6FC",
    "panelTitle.inactiveForeground": "#52C2F8",
    "terminal.background": "#0E2B45",
    "terminal.foreground": "#EBF6FC",
    "terminal.border": "#1A4970",
    "terminal.ansiBlack": "#081F33",
    "terminal.ansiRed": "#F87171",
    "terminal.ansiGreen": "#34D399",
    "terminal.ansiYellow": "#FBBF24",
    "terminal.ansiBlue": "#38BDF8",
    "terminal.ansiMagenta": "#818CF8",
    "terminal.ansiCyan": "#14D2E6",
    "terminal.ansiWhite": "#EBF6FC",
    "statusBar.background": "#0E2B45",
    "statusBar.foreground": "#52C2F8",
    "statusBar.border": "#1A4970",
    "statusBar.debuggingBackground": "#14D2E62A",
    "statusBar.debuggingForeground": "#EBF6FC",
    "statusBar.noFolderBackground": "#0E2B45",
    "statusBarItem.hoverBackground": "#14D2E618",
    "statusBarItem.activeBackground": "#14D2E62A",
    "statusBarItem.prominentBackground": "#14D2E6",
    "statusBarItem.prominentForeground": "#000000",
    "gitDecoration.addedResourceForeground": "#4ADE80",
    "gitDecoration.modifiedResourceForeground": "#14D2E6",
    "gitDecoration.deletedResourceForeground": "#F87171",
    "gitDecoration.untrackedResourceForeground": "#A7F3D0",
    "gitDecoration.ignoredResourceForeground": "#0997DB88",
    "diffEditor.insertedTextBackground": "#4ADE8020",
    "diffEditor.removedTextBackground": "#F8717120",
    "input.background": "#081F33",
    "input.foreground": "#EBF6FC",
    "input.border": "#1A4970",
    "input.placeholderForeground": "#0997DB99",
    "dropdown.background": "#0E2B45",
    "dropdown.foreground": "#EBF6FC",
    "dropdown.border": "#1A4970",
    "quickInput.background": "#0E2B45",
    "quickInput.foreground": "#EBF6FC",
    "pickerGroup.border": "#1A4970",
    "pickerGroup.foreground": "#14D2E6",
    "notificationCenter.border": "#1A4970",
    "notificationCenterHeader.background": "#081F33",
    "notificationCenterHeader.foreground": "#EBF6FC",
    "notifications.background": "#0E2B45",
    "notifications.foreground": "#EBF6FC",
    "notifications.border": "#1A4970",
    "badge.background": "#14D2E6",
    "badge.foreground": "#000000",
    "breadcrumb.background": "#041322",
    "breadcrumb.foreground": "#52C2F8",
    "breadcrumb.focusForeground": "#EBF6FC",
    "breadcrumb.activeSelectionForeground": "#14D2E6"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5684A8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#14D2E6"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#38BDF8"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#98F5D8"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#FBBF24"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#52C2F8"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#EBF6FC"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#EBF6FC"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#14D2E6"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#14D2E6"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#38BDF8"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#14D2E6"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#38BDF8"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#98F5D8"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#14D2E6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#98F5D8"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#38BDF8"
      }
    }
  ]
}
