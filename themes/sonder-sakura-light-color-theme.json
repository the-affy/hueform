{
  "name": "SONDER — Sakura Light",
  "$schema": "vscode://schemas/color-theme",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#261219",
    "variable.readonly": "#A35018",
    "variable.defaultLibrary": "#B81B42",
    "parameter": "#261219",
    "property": "#261219",
    "property.readonly": "#A35018",
    "enumMember": "#A35018",
    "function": "#981434",
    "method": "#981434",
    "class": "#70273B",
    "interface": "#70273B",
    "type": "#70273B",
    "typeParameter": "#70273B",
    "namespace": "#70273B",
    "enum": "#70273B",
    "struct": "#70273B",
    "decorator": "#981434",
    "event": "#B81B42",
    "keyword": "#B81B42",
    "modifier": "#B81B42",
    "string": "#2A663E",
    "number": "#A35018",
    "regexp": "#2A663E",
    "operator": "#B81B42",
    "comment": "#7D5C66",
    "macro": "#981434"
  },
  "colors": {
    "focusBorder": "#B81B4288",
    "foreground": "#261219",
    "disabledForeground": "#BC416399",
    "widget.shadow": "#00000018",
    "widget.border": "#D8BCC4",
