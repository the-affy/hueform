    "window.activeBorder": "#D8BCC4",
    "window.inactiveBorder": "#EAD9DE",
    "titleBar.activeBackground": "#F4E9EC",
    "titleBar.activeForeground": "#261219",
    "titleBar.inactiveBackground": "#F4E9EC",
    "titleBar.inactiveForeground": "#70273B",
    "titleBar.border": "#D8BCC4",
    "activityBar.background": "#F4E9EC",
    "activityBar.foreground": "#B81B42",
    "activityBar.inactiveForeground": "#70273B88",
    "activityBar.border": "#D8BCC4",
    "activityBar.activeBorder": "#B81B42",
    "activityBarBadge.background": "#B81B42",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#F4E9EC",
    "sideBar.foreground": "#261219",
    "sideBar.border": "#D8BCC4",
    "sideBarTitle.foreground": "#70273B",
    "sideBarSectionHeader.background": "#F4E9EC",
    "sideBarSectionHeader.foreground": "#261219",
    "sideBarSectionHeader.border": "#D8BCC4",
    "list.activeSelectionBackground": "#B81B4220",
    "list.activeSelectionForeground": "#261219",
    "list.inactiveSelectionBackground": "#B81B4212",
    "list.inactiveSelectionForeground": "#261219",
    "list.hoverBackground": "#EFE2E6",
    "list.hoverForeground": "#261219",
    "list.focusBackground": "#B81B4220",
    "list.focusForeground": "#261219",
    "list.highlightForeground": "#B81B42",
    "list.dropBackground": "#B81B4222",
    "tree.indentGuidesStroke": "#EAD9DE",
    "editor.background": "#FAF5F6",
    "editor.foreground": "#261219",
    "editorCursor.foreground": "#B81B42",
    "editorCursor.background": "#FAF5F6",
    "editor.lineHighlightBackground": "#F4E9EC66",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#B81B422A",
    "editor.selectionHighlightBackground": "#B81B4218",
    "editor.wordHighlightBackground": "#9814341E",
    "editor.wordHighlightBorder": "#98143466",
    "editor.findMatchBackground": "#B81B4250",
    "editor.findMatchHighlightBackground": "#B81B4226",
    "editorLineNumber.foreground": "#BC416388",
    "editorLineNumber.activeForeground": "#B81B42",
    "editorIndentGuide.background1": "#EAD9DE",
    "editorIndentGuide.activeBackground1": "#B81B4266",
    "editorWhitespace.foreground": "#EAD9DE",
    "editorRuler.foreground": "#EAD9DE",
    "editorBracketHighlight.foreground1": "#B81B42",
    "editorBracketHighlight.foreground2": "#981434",
    "editorBracketHighlight.foreground3": "#A35018",
    "editorBracketHighlight.foreground4": "#2A663E",
    "editorBracketHighlight.foreground5": "#B81B42",
    "editorBracketHighlight.foreground6": "#70273B",
    "editorGroupHeader.tabsBackground": "#F4E9EC",
    "editorGroupHeader.tabsBorder": "#D8BCC4",
    "editorGroupHeader.noTabsBackground": "#F4E9EC",
    "editorGroup.border": "#D8BCC4",
    "tab.activeBackground": "#F5E4E8",
    "tab.activeForeground": "#261219",
    "tab.activeBorderTop": "#B81B42",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#F4E9EC",
    "tab.inactiveForeground": "#70273B",
    "tab.border": "#D8BCC4",
    "tab.hoverBackground": "#ECCCD4",
    "tab.hoverForeground": "#261219",
    "tab.selectedBackground": "#B81B422A",
    "tab.selectedForeground": "#261219",
    "tab.unfocusedActiveBackground": "#F5E7EA",
    "tab.unfocusedActiveForeground": "#261219D9",
    "tab.unfocusedActiveBorderTop": "#B81B4288",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#F4E9EC",
    "tab.unfocusedInactiveForeground": "#70273BB3",
    "tab.unfocusedHoverBackground": "#ECCCD4",
    "tab.unfocusedHoverForeground": "#261219",
    "tab.lastPinnedBorder": "#D8BCC4",
    "panel.background": "#EADBDF",
    "panel.border": "#D8BCC4",
    "panelTitle.activeBorder": "#B81B42",
    "panelTitle.activeForeground": "#261219",
    "panelTitle.inactiveForeground": "#70273B",
    "terminal.background": "#EADBDF",
    "terminal.foreground": "#261219",
    "terminal.border": "#D8BCC4",
    "terminal.ansiBlack": "#261219",
    "terminal.ansiRed": "#981434",
    "terminal.ansiGreen": "#166534",
    "terminal.ansiYellow": "#92400E",
    "terminal.ansiBlue": "#981434",
    "terminal.ansiMagenta": "#831843",
    "terminal.ansiCyan": "#0E7490",
    "terminal.ansiWhite": "#475569",
    "statusBar.background": "#EADBDF",
    "statusBar.foreground": "#70273B",
    "statusBar.border": "#D8BCC4",
    "statusBar.debuggingBackground": "#B81B4220",
    "statusBar.debuggingForeground": "#261219",
    "statusBar.noFolderBackground": "#EADBDF",
    "statusBarItem.hoverBackground": "#B81B4212",
    "statusBarItem.activeBackground": "#B81B4220",
    "statusBarItem.prominentBackground": "#B81B42",
    "statusBarItem.prominentForeground": "#FFFFFF",
    "gitDecoration.addedResourceForeground": "#16A34A",
    "gitDecoration.modifiedResourceForeground": "#B81B42",
    "gitDecoration.deletedResourceForeground": "#DC2626",
    "gitDecoration.untrackedResourceForeground": "#059669",
    "gitDecoration.ignoredResourceForeground": "#BC416388",
    "diffEditor.insertedTextBackground": "#16A34A18",
    "diffEditor.removedTextBackground": "#DC262618",
    "input.background": "#FAF5F6",
    "input.foreground": "#261219",
    "input.border": "#D8BCC4",
    "input.placeholderForeground": "#BC416399",
    "dropdown.background": "#F4E9EC",
    "dropdown.foreground": "#261219",
    "dropdown.border": "#D8BCC4",
    "quickInput.background": "#F4E9EC",
    "quickInput.foreground": "#261219",
    "pickerGroup.border": "#D8BCC4",
    "pickerGroup.foreground": "#B81B42",
    "notificationCenter.border": "#D8BCC4",
    "notificationCenterHeader.background": "#F4E9EC",
    "notificationCenterHeader.foreground": "#261219",
    "notifications.background": "#F4E9EC",
    "notifications.foreground": "#261219",
    "notifications.border": "#D8BCC4",
    "badge.background": "#B81B42",
    "badge.foreground": "#FFFFFF",
    "breadcrumb.background": "#FAF5F6",
    "breadcrumb.foreground": "#70273B",
    "breadcrumb.focusForeground": "#261219",
    "breadcrumb.activeSelectionForeground": "#B81B42"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7D5C66",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#B81B42"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#981434"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2A663E"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#A35018"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#70273B"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#261219"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#261219"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#B81B42"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#B81B42"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#981434"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#B81B42"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#981434"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#2A663E"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#B81B42",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#2A663E"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#981434"
      }
    }
  ]
}
