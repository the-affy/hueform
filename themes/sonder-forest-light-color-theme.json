{
  "name": "SONDER — Forest Light",
  "$schema": "vscode://schemas/color-theme",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#0A2413",
    "variable.readonly": "#A8520C",
    "variable.defaultLibrary": "#0D6E66",
    "parameter": "#0A2413",
    "property": "#0A2413",
    "property.readonly": "#A8520C",
    "enumMember": "#A8520C",
    "function": "#15803D",
    "method": "#15803D",
    "class": "#155E32",
    "interface": "#155E32",
    "type": "#155E32",
    "typeParameter": "#155E32",
    "namespace": "#155E32",
    "enum": "#155E32",
    "struct": "#155E32",
    "decorator": "#15803D",
    "event": "#0D6E66",
    "keyword": "#0D6E66",
    "modifier": "#0D6E66",
    "string": "#4D7C0F",
    "number": "#A8520C",
    "regexp": "#4D7C0F",
    "operator": "#15803D",
    "comment": "#537460",
    "macro": "#15803D"
  },
  "colors": {
    "focusBorder": "#15803D88",
    "foreground": "#0A2413",
    "disabledForeground": "#28B15E99",
    "widget.shadow": "#00000018",
    "widget.border": "#B5CDC0",
    "selection.background": "#15803D2A",
    "descriptionForeground": "#155E32",
    "errorForeground": "#DC2626",
    "icon.foreground": "#155E32",
    "window.activeBorder": "#B5CDC0",
    "window.inactiveBorder": "#D5E3DB",
    "titleBar.activeBackground": "#E6EFE9",
    "titleBar.activeForeground": "#0A2413",
    "titleBar.inactiveBackground": "#E6EFE9",
    "titleBar.inactiveForeground": "#155E32",
    "titleBar.border": "#B5CDC0",
    "activityBar.background": "#E6EFE9",
    "activityBar.foreground": "#15803D",
    "activityBar.inactiveForeground": "#155E3288",
    "activityBar.border": "#B5CDC0",
    "activityBar.activeBorder": "#15803D",
    "activityBarBadge.background": "#15803D",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#E6EFE9",
    "sideBar.foreground": "#0A2413",
    "sideBar.border": "#B5CDC0",
    "sideBarTitle.foreground": "#155E32",
    "sideBarSectionHeader.background": "#E6EFE9",
    "sideBarSectionHeader.foreground": "#0A2413",
    "sideBarSectionHeader.border": "#B5CDC0",
    "list.activeSelectionBackground": "#15803D20",
    "list.activeSelectionForeground": "#0A2413",
    "list.inactiveSelectionBackground": "#15803D12",
    "list.inactiveSelectionForeground": "#0A2413",
    "list.hoverBackground": "#DFEAE3",
    "list.hoverForeground": "#0A2413",
    "list.focusBackground": "#15803D20",
    "list.focusForeground": "#0A2413",
    "list.highlightForeground": "#15803D",
    "list.dropBackground": "#15803D22",
    "tree.indentGuidesStroke": "#D5E3DB",
    "editor.background": "#F3F7F4",
    "editor.foreground": "#0A2413",
    "editorCursor.foreground": "#15803D",
    "editorCursor.background": "#F3F7F4",
    "editor.lineHighlightBackground": "#E6EFE966",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#15803D2A",
    "editor.selectionHighlightBackground": "#15803D18",
    "editor.wordHighlightBackground": "#0D6E661E",
    "editor.wordHighlightBorder": "#0D6E6666",
    "editor.findMatchBackground": "#15803D50",
    "editor.findMatchHighlightBackground": "#15803D26",
    "editorLineNumber.foreground": "#28B15E88",
    "editorLineNumber.activeForeground": "#15803D",
    "editorIndentGuide.background1": "#D5E3DB",
    "editorIndentGuide.activeBackground1": "#15803D66",
    "editorWhitespace.foreground": "#D5E3DB",
    "editorRuler.foreground": "#D5E3DB",
    "editorBracketHighlight.foreground1": "#15803D",
    "editorBracketHighlight.foreground2": "#0D6E66",
    "editorBracketHighlight.foreground3": "#A8520C",
    "editorBracketHighlight.foreground4": "#4D7C0F",
    "editorBracketHighlight.foreground5": "#0D6E66",
    "editorBracketHighlight.foreground6": "#155E32",
    "editorGroupHeader.tabsBackground": "#E6EFE9",
    "editorGroupHeader.tabsBorder": "#B5CDC0",
    "editorGroupHeader.noTabsBackground": "#E6EFE9",
    "editorGroup.border": "#B5CDC0",
    "tab.activeBackground": "#E1EDE5",
    "tab.activeForeground": "#0A2413",
    "tab.activeBorderTop": "#15803D",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#E6EFE9",
    "tab.inactiveForeground": "#155E32",
    "tab.border": "#B5CDC0",
    "tab.hoverBackground": "#C9DFD1",
    "tab.hoverForeground": "#0A2413",
    "tab.selectedBackground": "#15803D2A",
    "tab.selectedForeground": "#0A2413",
    "tab.unfocusedActiveBackground": "#E4EEE7",
    "tab.unfocusedActiveForeground": "#0A2413D9",
    "tab.unfocusedActiveBorderTop": "#15803D88",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#E6EFE9",
    "tab.unfocusedInactiveForeground": "#155E32B3",
    "tab.unfocusedHoverBackground": "#C9DFD1",
    "tab.unfocusedHoverForeground": "#0A2413",
    "tab.lastPinnedBorder": "#B5CDC0",
    "panel.background": "#D7E5DC",
    "panel.border": "#B5CDC0",
    "panelTitle.activeBorder": "#15803D",
    "panelTitle.activeForeground": "#0A2413",
    "panelTitle.inactiveForeground": "#155E32",
    "terminal.background": "#D7E5DC",
    "terminal.foreground": "#0A2413",
    "terminal.border": "#B5CDC0",
    "terminal.ansiBlack": "#0A2413",
    "terminal.ansiRed": "#991B1B",
    "terminal.ansiGreen": "#166534",
    "terminal.ansiYellow": "#854D0E",
    "terminal.ansiBlue": "#115E59",
    "terminal.ansiMagenta": "#701A75",
    "terminal.ansiCyan": "#0E7490",
    "terminal.ansiWhite": "#475569",
    "statusBar.background": "#D7E5DC",
    "statusBar.foreground": "#155E32",
    "statusBar.border": "#B5CDC0",
    "statusBar.debuggingBackground": "#15803D20",
    "statusBar.debuggingForeground": "#0A2413",
    "statusBar.noFolderBackground": "#D7E5DC",
    "statusBarItem.hoverBackground": "#15803D12",
    "statusBarItem.activeBackground": "#15803D20",
    "statusBarItem.prominentBackground": "#15803D",
    "statusBarItem.prominentForeground": "#FFFFFF",
    "gitDecoration.addedResourceForeground": "#16A34A",
    "gitDecoration.modifiedResourceForeground": "#15803D",
    "gitDecoration.deletedResourceForeground": "#DC2626",
    "gitDecoration.untrackedResourceForeground": "#059669",
    "gitDecoration.ignoredResourceForeground": "#28B15E88",
    "diffEditor.insertedTextBackground": "#16A34A18",
    "diffEditor.removedTextBackground": "#DC262618",
    "input.background": "#F3F7F4",
    "input.foreground": "#0A2413",
    "input.border": "#B5CDC0",
    "input.placeholderForeground": "#28B15E99",
    "dropdown.background": "#E6EFE9",
    "dropdown.foreground": "#0A2413",
    "dropdown.border": "#B5CDC0",
    "quickInput.background": "#E6EFE9",
    "quickInput.foreground": "#0A2413",
    "pickerGroup.border": "#B5CDC0",
    "pickerGroup.foreground": "#15803D",
    "notificationCenter.border": "#B5CDC0",
    "notificationCenterHeader.background": "#E6EFE9",
    "notificationCenterHeader.foreground": "#0A2413",
    "notifications.background": "#E6EFE9",
    "notifications.foreground": "#0A2413",
    "notifications.border": "#B5CDC0",
    "badge.background": "#15803D",
    "badge.foreground": "#FFFFFF",
    "breadcrumb.background": "#F3F7F4",
    "breadcrumb.foreground": "#155E32",
    "breadcrumb.focusForeground": "#0A2413",
    "breadcrumb.activeSelectionForeground": "#15803D"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#537460",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#0D6E66"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#15803D"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#4D7C0F"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#A8520C"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#155E32"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#0A2413"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#0A2413"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#15803D"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#0D6E66"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#15803D"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#0D6E66"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#15803D"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#4D7C0F"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#15803D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#4D7C0F"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#0D6E66"
      }
    }
  ]
}
