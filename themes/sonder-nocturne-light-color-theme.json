{
  "name": "SONDER — Nocturne Light",
  "$schema": "vscode://schemas/color-theme",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#1A132B",
    "variable.readonly": "#A34F0C",
    "variable.defaultLibrary": "#8F2060",
    "parameter": "#1A132B",
    "property": "#1A132B",
    "property.readonly": "#A34F0C",
    "enumMember": "#A34F0C",
    "function": "#6F26B8",
    "method": "#6F26B8",
    "class": "#4F3574",
    "interface": "#4F3574",
    "type": "#4F3574",
    "typeParameter": "#4F3574",
    "namespace": "#4F3574",
    "enum": "#4F3574",
    "struct": "#4F3574",
    "decorator": "#6F26B8",
    "event": "#8F2060",
    "keyword": "#8F2060",
    "modifier": "#8F2060",
    "string": "#73531A",
    "number": "#A34F0C",
    "regexp": "#73531A",
    "operator": "#5E1F9E",
    "comment": "#6B5E87",
    "macro": "#6F26B8"
  },
  "colors": {
    "focusBorder": "#6F26B888",
    "foreground": "#1A132B",
    "disabledForeground": "#805BB499",
    "widget.shadow": "#00000018",
    "widget.border": "#CAC2DD",
    "selection.background": "#6F26B82A",
    "descriptionForeground": "#4F3574",
    "errorForeground": "#DC2626",
    "icon.foreground": "#4F3574",
    "window.activeBorder": "#CAC2DD",
    "window.inactiveBorder": "#E1DCEB",
    "titleBar.activeBackground": "#EDEAF3",
    "titleBar.activeForeground": "#1A132B",
    "titleBar.inactiveBackground": "#EDEAF3",
    "titleBar.inactiveForeground": "#4F3574",
    "titleBar.border": "#CAC2DD",
    "activityBar.background": "#EDEAF3",
    "activityBar.foreground": "#6F26B8",
    "activityBar.inactiveForeground": "#4F357488",
    "activityBar.border": "#CAC2DD",
    "activityBar.activeBorder": "#6F26B8",
    "activityBarBadge.background": "#6F26B8",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#EDEAF3",
    "sideBar.foreground": "#1A132B",
    "sideBar.border": "#CAC2DD",
    "sideBarTitle.foreground": "#4F3574",
    "sideBarSectionHeader.background": "#EDEAF3",
    "sideBarSectionHeader.foreground": "#1A132B",
    "sideBarSectionHeader.border": "#CAC2DD",
    "list.activeSelectionBackground": "#6F26B820",
    "list.activeSelectionForeground": "#1A132B",
    "list.inactiveSelectionBackground": "#6F26B812",
    "list.inactiveSelectionForeground": "#1A132B",
    "list.hoverBackground": "#E8E4F0",
    "list.hoverForeground": "#1A132B",
    "list.focusBackground": "#6F26B820",
    "list.focusForeground": "#1A132B",
    "list.highlightForeground": "#6F26B8",
    "list.dropBackground": "#6F26B822",
    "tree.indentGuidesStroke": "#E1DCEB",
    "editor.background": "#F6F5F9",
    "editor.foreground": "#1A132B",
    "editorCursor.foreground": "#6F26B8",
    "editorCursor.background": "#F6F5F9",
    "editor.lineHighlightBackground": "#EDEAF366",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#6F26B82A",
    "editor.selectionHighlightBackground": "#6F26B818",
    "editor.wordHighlightBackground": "#8C279E1E",
    "editor.wordHighlightBorder": "#8C279E66",
    "editor.findMatchBackground": "#6F26B850",
    "editor.findMatchHighlightBackground": "#6F26B826",
    "editorLineNumber.foreground": "#805BB488",
    "editorLineNumber.activeForeground": "#6F26B8",
    "editorIndentGuide.background1": "#E1DCEB",
    "editorIndentGuide.activeBackground1": "#6F26B866",
    "editorWhitespace.foreground": "#E1DCEB",
    "editorRuler.foreground": "#E1DCEB",
    "editorBracketHighlight.foreground1": "#6F26B8",
    "editorBracketHighlight.foreground2": "#8C279E",
    "editorBracketHighlight.foreground3": "#A34F0C",
    "editorBracketHighlight.foreground4": "#73531A",
    "editorBracketHighlight.foreground5": "#8F2060",
    "editorBracketHighlight.foreground6": "#4F3574",
    "editorGroupHeader.tabsBackground": "#EDEAF3",
    "editorGroupHeader.tabsBorder": "#CAC2DD",
    "editorGroupHeader.noTabsBackground": "#EDEAF3",
    "editorGroup.border": "#CAC2DD",
    "tab.activeBackground": "#EBE4F4",
    "tab.activeForeground": "#1A132B",
    "tab.activeBorderTop": "#6F26B8",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#EDEAF3",
    "tab.inactiveForeground": "#4F3574",
    "tab.border": "#CAC2DD",
    "tab.hoverBackground": "#DBCFEB",
    "tab.hoverForeground": "#1A132B",
    "tab.selectedBackground": "#6F26B82A",
    "tab.selectedForeground": "#1A132B",
    "tab.unfocusedActiveBackground": "#ECE7F4",
    "tab.unfocusedActiveForeground": "#1A132BD9",
    "tab.unfocusedActiveBorderTop": "#6F26B888",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#EDEAF3",
    "tab.unfocusedInactiveForeground": "#4F3574B3",
    "tab.unfocusedHoverBackground": "#DBCFEB",
    "tab.unfocusedHoverForeground": "#1A132B",
    "tab.lastPinnedBorder": "#CAC2DD",
    "panel.background": "#E2DEEC",
    "panel.border": "#CAC2DD",
    "panelTitle.activeBorder": "#6F26B8",
    "panelTitle.activeForeground": "#1A132B",
    "panelTitle.inactiveForeground": "#4F3574",
    "terminal.background": "#E2DEEC",
    "terminal.foreground": "#1A132B",
    "terminal.border": "#CAC2DD",
    "terminal.ansiBlack": "#1A132B",
    "terminal.ansiRed": "#9F1239",
    "terminal.ansiGreen": "#166534",
    "terminal.ansiYellow": "#92400E",
    "terminal.ansiBlue": "#581C87",
    "terminal.ansiMagenta": "#86198F",
    "terminal.ansiCyan": "#0E7490",
    "terminal.ansiWhite": "#475569",
    "statusBar.background": "#E2DEEC",
    "statusBar.foreground": "#4F3574",
    "statusBar.border": "#CAC2DD",
    "statusBar.debuggingBackground": "#6F26B820",
    "statusBar.debuggingForeground": "#1A132B",
    "statusBar.noFolderBackground": "#E2DEEC",
    "statusBarItem.hoverBackground": "#6F26B812",
    "statusBarItem.activeBackground": "#6F26B820",
    "statusBarItem.prominentBackground": "#6F26B8",
    "statusBarItem.prominentForeground": "#FFFFFF",
    "gitDecoration.addedResourceForeground": "#16A34A",
    "gitDecoration.modifiedResourceForeground": "#6F26B8",
    "gitDecoration.deletedResourceForeground": "#DC2626",
    "gitDecoration.untrackedResourceForeground": "#059669",
    "gitDecoration.ignoredResourceForeground": "#805BB488",
    "diffEditor.insertedTextBackground": "#16A34A18",
    "diffEditor.removedTextBackground": "#DC262618",
    "input.background": "#F6F5F9",
    "input.foreground": "#1A132B",
    "input.border": "#CAC2DD",
    "input.placeholderForeground": "#805BB499",
    "dropdown.background": "#EDEAF3",
    "dropdown.foreground": "#1A132B",
    "dropdown.border": "#CAC2DD",
    "quickInput.background": "#EDEAF3",
    "quickInput.foreground": "#1A132B",
    "pickerGroup.border": "#CAC2DD",
    "pickerGroup.foreground": "#6F26B8",
    "notificationCenter.border": "#CAC2DD",
    "notificationCenterHeader.background": "#EDEAF3",
    "notificationCenterHeader.foreground": "#1A132B",
    "notifications.background": "#EDEAF3",
    "notifications.foreground": "#1A132B",
    "notifications.border": "#CAC2DD",
    "badge.background": "#6F26B8",
    "badge.foreground": "#FFFFFF",
    "breadcrumb.background": "#F6F5F9",
    "breadcrumb.foreground": "#4F3574",
    "breadcrumb.focusForeground": "#1A132B",
    "breadcrumb.activeSelectionForeground": "#6F26B8"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6B5E87",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#8F2060"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#6F26B8"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#73531A"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#A34F0C"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#4F3574"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#1A132B"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#1A132B"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#5E1F9E"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#8F2060"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#6F26B8"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#8F2060"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#6F26B8"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#73531A"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#6F26B8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#73531A"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#8C279E"
      }
    }
  ]
}
