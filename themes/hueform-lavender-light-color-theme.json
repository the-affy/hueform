    "titleBar.inactiveBackground": "#E6E8F6",
    "titleBar.inactiveForeground": "#4338CA",
    "titleBar.border": "#B6BCDF",
    "activityBar.background": "#E6E8F6",
    "activityBar.foreground": "#4F46E5",
    "activityBar.inactiveForeground": "#4338CA88",
    "activityBar.border": "#B6BCDF",
    "activityBar.activeBorder": "#4F46E5",
    "activityBarBadge.background": "#4F46E5",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#E6E8F6",
    "sideBar.foreground": "#121636",
    "sideBar.border": "#B6BCDF",
    "sideBarTitle.foreground": "#4338CA",
    "sideBarSectionHeader.background": "#E6E8F6",
    "sideBarSectionHeader.foreground": "#121636",
    "sideBarSectionHeader.border": "#B6BCDF",
    "list.activeSelectionBackground": "#4F46E520",
    "list.activeSelectionForeground": "#121636",
    "list.inactiveSelectionBackground": "#4F46E512",
    "list.inactiveSelectionForeground": "#121636",
    "list.hoverBackground": "#DFE1F2",
    "list.hoverForeground": "#121636",
    "list.focusBackground": "#4F46E520",
    "list.focusForeground": "#121636",
    "list.highlightForeground": "#4F46E5",
    "list.dropBackground": "#4F46E522",
    "tree.indentGuidesStroke": "#D5D9EE",
    "editor.background": "#F4F5FB",
    "editor.foreground": "#121636",
    "editorCursor.foreground": "#4F46E5",
    "editorCursor.background": "#F4F5FB",
    "editor.lineHighlightBackground": "#E6E8F666",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#4F46E52A",
    "editor.selectionHighlightBackground": "#4F46E518",
    "editor.wordHighlightBackground": "#4338CA1E",
    "editor.wordHighlightBorder": "#4338CA66",
    "editor.findMatchBackground": "#4F46E550",
    "editor.findMatchHighlightBackground": "#4F46E526",
    "editorLineNumber.foreground": "#8F89DF88",
    "editorLineNumber.activeForeground": "#4F46E5",
    "editorIndentGuide.background1": "#D5D9EE",
    "editorIndentGuide.activeBackground1": "#4F46E566",
    "editorWhitespace.foreground": "#D5D9EE",
    "editorRuler.foreground": "#D5D9EE",
    "editorBracketHighlight.foreground1": "#4F46E5",
    "editorBracketHighlight.foreground2": "#4338CA",
    "editorBracketHighlight.foreground3": "#941848",
    "editorBracketHighlight.foreground4": "#157158",
    "editorBracketHighlight.foreground5": "#4F46E5",
    "editorBracketHighlight.foreground6": "#4338CA",
    "editorGroupHeader.tabsBackground": "#E6E8F6",
    "editorGroupHeader.tabsBorder": "#B6BCDF",
    "editorGroupHeader.noTabsBackground": "#E6E8F6",
    "editorGroup.border": "#B6BCDF",
    "tab.activeBackground": "#E7E7F9",
    "tab.activeForeground": "#121636",
    "tab.activeBorderTop": "#4F46E5",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#E6E8F6",
    "tab.inactiveForeground": "#4338CA",
    "tab.border": "#B6BCDF",
    "tab.hoverBackground": "#D1D1F4",
    "tab.hoverForeground": "#121636",
    "tab.selectedBackground": "#4F46E52A",
    "tab.selectedForeground": "#121636",
    "tab.unfocusedActiveBackground": "#E7E8F8",
    "tab.unfocusedActiveForeground": "#121636D9",
    "tab.unfocusedActiveBorderTop": "#4F46E588",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#E6E8F6",
    "tab.unfocusedInactiveForeground": "#4338CAB3",
    "tab.unfocusedHoverBackground": "#D1D1F4",
    "tab.unfocusedHoverForeground": "#121636",
    "tab.lastPinnedBorder": "#B6BCDF",
    "panel.background": "#D7DAED",
    "panel.border": "#B6BCDF",
    "panelTitle.activeBorder": "#4F46E5",
    "panelTitle.activeForeground": "#121636",
    "panelTitle.inactiveForeground": "#4338CA",
    "terminal.background": "#D7DAED",
    "terminal.foreground": "#121636",
    "terminal.border": "#B6BCDF",
    "terminal.ansiBlack": "#121636",
    "terminal.ansiRed": "#9F1239",
    "terminal.ansiGreen": "#166534",
    "terminal.ansiYellow": "#92400E",
    "terminal.ansiBlue": "#4F46E5",
    "terminal.ansiMagenta": "#86198F",
    "terminal.ansiCyan": "#0E7490",
    "terminal.ansiWhite": "#475569",
    "statusBar.background": "#D7DAED",
    "statusBar.foreground": "#4338CA",
    "statusBar.border": "#B6BCDF",
    "statusBar.debuggingBackground": "#4F46E520",
    "statusBar.debuggingForeground": "#121636",
    "statusBar.noFolderBackground": "#D7DAED",
    "statusBarItem.hoverBackground": "#4F46E512",
    "statusBarItem.activeBackground": "#4F46E520",
    "statusBarItem.prominentBackground": "#4F46E5",
    "statusBarItem.prominentForeground": "#FFFFFF",
    "gitDecoration.addedResourceForeground": "#16A34A",
    "gitDecoration.modifiedResourceForeground": "#4F46E5",
    "gitDecoration.deletedResourceForeground": "#DC2626",
    "gitDecoration.untrackedResourceForeground": "#059669",
    "gitDecoration.ignoredResourceForeground": "#8F89DF88",
    "diffEditor.insertedTextBackground": "#16A34A18",
    "diffEditor.removedTextBackground": "#DC262618",
    "input.background": "#F4F5FB",
    "input.foreground": "#121636",
    "input.border": "#B6BCDF",
    "input.placeholderForeground": "#8F89DF99",
    "dropdown.background": "#E6E8F6",
    "dropdown.foreground": "#121636",
    "dropdown.border": "#B6BCDF",
    "quickInput.background": "#E6E8F6",
    "quickInput.foreground": "#121636",
    "pickerGroup.border": "#B6BCDF",
    "pickerGroup.foreground": "#4F46E5",
    "notificationCenter.border": "#B6BCDF",
    "notificationCenterHeader.background": "#E6E8F6",
    "notificationCenterHeader.foreground": "#121636",
    "notifications.background": "#E6E8F6",
    "notifications.foreground": "#121636",
    "notifications.border": "#B6BCDF",
    "badge.background": "#4F46E5",
    "badge.foreground": "#FFFFFF",
    "breadcrumb.background": "#F4F5FB",
    "breadcrumb.foreground": "#4338CA",
    "breadcrumb.focusForeground": "#121636",
    "breadcrumb.activeSelectionForeground": "#4F46E5"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5C668D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#4F46E5"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#3730A3"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#157158"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#941848"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#4338CA"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#121636"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#121636"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#4F46E5"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#4F46E5"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#3730A3"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#4F46E5"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#3730A3"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#157158"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#4F46E5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#157158"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#4338CA"
      }
    }
  ]
}
