{
  "name": "HUEFORM — Lavender Light",
  "$schema": "vscode://schemas/color-theme",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#121636",
    "variable.readonly": "#941848",
    "variable.defaultLibrary": "#4F46E5",
    "parameter": "#121636",
    "property": "#121636",
    "property.readonly": "#941848",
    "enumMember": "#941848",
    "function": "#3730A3",
    "method": "#3730A3",
    "class": "#4338CA",
    "interface": "#4338CA",
    "type": "#4338CA",
    "typeParameter": "#4338CA",
    "namespace": "#4338CA",
    "enum": "#4338CA",
    "struct": "#4338CA",
    "decorator": "#3730A3",
    "event": "#4F46E5",
    "keyword": "#4F46E5",
    "modifier": "#4F46E5",
    "string": "#157158",
    "number": "#941848",
    "regexp": "#157158",
    "operator": "#4F46E5",
    "comment": "#5C668D",
    "macro": "#3730A3"
  },
  "colors": {
    "focusBorder": "#4F46E588",
    "foreground": "#121636",
    "disabledForeground": "#8F89DF99",
    "widget.shadow": "#00000018",
