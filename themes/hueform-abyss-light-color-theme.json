{
  "name": "HUEFORM — Abyss Light",
  "$schema": "vscode://schemas/color-theme",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#071720",
    "variable.readonly": "#92400E",
    "variable.defaultLibrary": "#0C606E",
    "parameter": "#071720",
    "property": "#071720",
    "property.readonly": "#92400E",
    "enumMember": "#92400E",
    "function": "#135A7A",
    "method": "#135A7A",
    "class": "#234E6B",
    "interface": "#234E6B",
    "type": "#234E6B",
    "typeParameter": "#234E6B",
    "namespace": "#234E6B",
    "enum": "#234E6B",
    "struct": "#234E6B",
    "decorator": "#135A7A",
    "event": "#0C606E",
    "keyword": "#0C606E",
    "modifier": "#0C606E",
    "string": "#156644",
    "number": "#92400E",
    "regexp": "#156644",
    "operator": "#135A7A",
    "comment": "#526E7D",
    "macro": "#135A7A"
  },
  "colors": {
    "focusBorder": "#0C606E88",
    "foreground": "#071720",
    "disabledForeground": "#3C86B899",
    "widget.shadow": "#00000018",
    "widget.border": "#B6CAD6",
    "selection.background": "#0C606E2A",
    "descriptionForeground": "#234E6B",
    "errorForeground": "#DC2626",
    "icon.foreground": "#234E6B",
    "window.activeBorder": "#B6CAD6",
    "window.inactiveBorder": "#D1DCE4",
    "titleBar.activeBackground": "#DFE5EB",
    "titleBar.activeForeground": "#071720",
    "titleBar.inactiveBackground": "#DFE5EB",
    "titleBar.inactiveForeground": "#234E6B",
    "titleBar.border": "#B6CAD6",
    "activityBar.background": "#DFE5EB",
    "activityBar.foreground": "#0C606E",
    "activityBar.inactiveForeground": "#234E6B88",
    "activityBar.border": "#B6CAD6",
    "activityBar.activeBorder": "#0C606E",
    "activityBarBadge.background": "#0C606E",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#DFE5EB",
    "sideBar.foreground": "#071720",
    "sideBar.border": "#B6CAD6",
    "sideBarTitle.foreground": "#234E6B",
    "sideBarSectionHeader.background": "#DFE5EB",
    "sideBarSectionHeader.foreground": "#071720",
    "sideBarSectionHeader.border": "#B6CAD6",
    "list.activeSelectionBackground": "#0C606E20",
    "list.activeSelectionForeground": "#071720",
    "list.inactiveSelectionBackground": "#0C606E12",
    "list.inactiveSelectionForeground": "#071720",
    "list.hoverBackground": "#D7DFE6",
    "list.hoverForeground": "#071720",
    "list.focusBackground": "#0C606E20",
    "list.focusForeground": "#071720",
    "list.highlightForeground": "#0C606E",
    "list.dropBackground": "#0C606E22",
    "tree.indentGuidesStroke": "#D1DCE4",
    "editor.background": "#EFF2F5",
    "editor.foreground": "#071720",
    "editorCursor.foreground": "#0C606E",
    "editorCursor.background": "#EFF2F5",
    "editor.lineHighlightBackground": "#DFE5EB66",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#0C606E2A",
    "editor.selectionHighlightBackground": "#0C606E18",
    "editor.wordHighlightBackground": "#135A7A1E",
    "editor.wordHighlightBorder": "#135A7A66",
    "editor.findMatchBackground": "#0C606E50",
    "editor.findMatchHighlightBackground": "#0C606E26",
    "editorLineNumber.foreground": "#3C86B888",
    "editorLineNumber.activeForeground": "#0C606E",
    "editorIndentGuide.background1": "#D1DCE4",
    "editorIndentGuide.activeBackground1": "#0C606E66",
    "editorWhitespace.foreground": "#D1DCE4",
    "editorRuler.foreground": "#D1DCE4",
    "editorBracketHighlight.foreground1": "#0C606E",
    "editorBracketHighlight.foreground2": "#135A7A",
    "editorBracketHighlight.foreground3": "#92400E",
    "editorBracketHighlight.foreground4": "#156644",
    "editorBracketHighlight.foreground5": "#0C606E",
    "editorBracketHighlight.foreground6": "#234E6B",
    "editorGroupHeader.tabsBackground": "#DFE5EB",
    "editorGroupHeader.tabsBorder": "#B6CAD6",
    "editorGroupHeader.noTabsBackground": "#DFE5EB",
    "editorGroup.border": "#B6CAD6",
    "tab.activeBackground": "#DDE6EA",
    "tab.activeForeground": "#071720",
    "tab.activeBorderTop": "#0C606E",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#DFE5EB",
    "tab.inactiveForeground": "#234E6B",
    "tab.border": "#B6CAD6",
    "tab.hoverBackground": "#C1D2DA",
    "tab.hoverForeground": "#071720",
    "tab.selectedBackground": "#0C606E2A",
    "tab.selectedForeground": "#071720",
    "tab.unfocusedActiveBackground": "#DEE6EB",
    "tab.unfocusedActiveForeground": "#071720D9",
    "tab.unfocusedActiveBorderTop": "#0C606E88",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#DFE5EB",
    "tab.unfocusedInactiveForeground": "#234E6BB3",
    "tab.unfocusedHoverBackground": "#C1D2DA",
    "tab.unfocusedHoverForeground": "#071720",
    "tab.lastPinnedBorder": "#B6CAD6",
    "panel.background": "#CFD8E1",
    "panel.border": "#B6CAD6",
    "panelTitle.activeBorder": "#0C606E",
    "panelTitle.activeForeground": "#071720",
    "panelTitle.inactiveForeground": "#234E6B",
    "terminal.background": "#CFD8E1",
    "terminal.foreground": "#071720",
    "terminal.border": "#B6CAD6",
    "terminal.ansiBlack": "#071720",
    "terminal.ansiRed": "#B91C1C",
    "terminal.ansiGreen": "#166534",
    "terminal.ansiYellow": "#92400E",
    "terminal.ansiBlue": "#0C606E",
    "terminal.ansiMagenta": "#7E22CE",
    "terminal.ansiCyan": "#0E7490",
    "terminal.ansiWhite": "#475569",
    "statusBar.background": "#CFD8E1",
    "statusBar.foreground": "#234E6B",
    "statusBar.border": "#B6CAD6",
    "statusBar.debuggingBackground": "#0C606E20",
    "statusBar.debuggingForeground": "#071720",
    "statusBar.noFolderBackground": "#CFD8E1",
    "statusBarItem.hoverBackground": "#0C606E12",
    "statusBarItem.activeBackground": "#0C606E20",
    "statusBarItem.prominentBackground": "#0C606E",
    "statusBarItem.prominentForeground": "#FFFFFF",
    "gitDecoration.addedResourceForeground": "#16A34A",
    "gitDecoration.modifiedResourceForeground": "#0C606E",
    "gitDecoration.deletedResourceForeground": "#DC2626",
    "gitDecoration.untrackedResourceForeground": "#059669",
    "gitDecoration.ignoredResourceForeground": "#3C86B888",
    "diffEditor.insertedTextBackground": "#16A34A18",
    "diffEditor.removedTextBackground": "#DC262618",
    "input.background": "#EFF2F5",
    "input.foreground": "#071720",
    "input.border": "#B6CAD6",
    "input.placeholderForeground": "#3C86B899",
    "dropdown.background": "#DFE5EB",
    "dropdown.foreground": "#071720",
    "dropdown.border": "#B6CAD6",
    "quickInput.background": "#DFE5EB",
    "quickInput.foreground": "#071720",
    "pickerGroup.border": "#B6CAD6",
    "pickerGroup.foreground": "#0C606E",
    "notificationCenter.border": "#B6CAD6",
    "notificationCenterHeader.background": "#DFE5EB",
    "notificationCenterHeader.foreground": "#071720",
    "notifications.background": "#DFE5EB",
    "notifications.foreground": "#071720",
    "notifications.border": "#B6CAD6",
    "badge.background": "#0C606E",
    "badge.foreground": "#FFFFFF",
    "breadcrumb.background": "#EFF2F5",
    "breadcrumb.foreground": "#234E6B",
    "breadcrumb.focusForeground": "#071720",
    "breadcrumb.activeSelectionForeground": "#0C606E"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#526E7D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#0C606E"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#135A7A"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#156644"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#92400E"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#234E6B"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#071720"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#071720"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#135A7A"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#0C606E"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#135A7A"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#0C606E"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#135A7A"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#156644"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#0C606E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#156644"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#135A7A"
      }
    }
  ]
}
