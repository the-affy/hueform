{
  "name": "SONDER — Ember Light",
  "$schema": "vscode://schemas/color-theme",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#2E1208",
    "variable.readonly": "#B91C1C",
    "variable.defaultLibrary": "#C2410C",
    "parameter": "#2E1208",
    "property": "#2E1208",
    "property.readonly": "#B91C1C",
    "enumMember": "#B91C1C",
    "function": "#C2410C",
    "method": "#C2410C",
    "class": "#9A3412",
    "interface": "#9A3412",
    "type": "#9A3412",
    "typeParameter": "#9A3412",
    "namespace": "#9A3412",
    "enum": "#9A3412",
    "struct": "#9A3412",
    "decorator": "#C2410C",
    "event": "#C2410C",
    "keyword": "#C2410C",
    "modifier": "#C2410C",
    "string": "#2D6A4F",
    "number": "#B91C1C",
    "regexp": "#2D6A4F",
    "operator": "#C2410C",
    "comment": "#87685D",
    "macro": "#C2410C"
  },
  "colors": {
    "focusBorder": "#EA580C88",
    "foreground": "#2E1208",
    "disabledForeground": "#E65A2C99",
    "widget.shadow": "#00000018",
    "widget.border": "#E8D2C2",
    "selection.background": "#EA580C2A",
    "descriptionForeground": "#9A3412",
    "errorForeground": "#DC2626",
    "icon.foreground": "#9A3412",
    "window.activeBorder": "#E8D2C2",
    "window.inactiveBorder": "#F5E9E1",
    "titleBar.activeBackground": "#FCF6F2",
    "titleBar.activeForeground": "#2E1208",
    "titleBar.inactiveBackground": "#FCF6F2",
    "titleBar.inactiveForeground": "#9A3412",
    "titleBar.border": "#E8D2C2",
    "activityBar.background": "#FCF6F2",
    "activityBar.foreground": "#EA580C",
    "activityBar.inactiveForeground": "#9A341288",
    "activityBar.border": "#E8D2C2",
    "activityBar.activeBorder": "#EA580C",
    "activityBarBadge.background": "#EA580C",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#FCF6F2",
    "sideBar.foreground": "#2E1208",
    "sideBar.border": "#E8D2C2",
    "sideBarTitle.foreground": "#9A3412",
    "sideBarSectionHeader.background": "#FCF6F2",
    "sideBarSectionHeader.foreground": "#2E1208",
    "sideBarSectionHeader.border": "#E8D2C2",
    "list.activeSelectionBackground": "#EA580C20",
    "list.activeSelectionForeground": "#2E1208",
    "list.inactiveSelectionBackground": "#EA580C12",
    "list.inactiveSelectionForeground": "#2E1208",
    "list.hoverBackground": "#FAF1EB",
    "list.hoverForeground": "#2E1208",
    "list.focusBackground": "#EA580C20",
    "list.focusForeground": "#2E1208",
    "list.highlightForeground": "#EA580C",
    "list.dropBackground": "#EA580C22",
    "tree.indentGuidesStroke": "#F5E9E1",
    "editor.background": "#FFFFFF",
    "editor.foreground": "#2E1208",
    "editorCursor.foreground": "#EA580C",
    "editorCursor.background": "#FFFFFF",
    "editor.lineHighlightBackground": "#FCF6F266",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#EA580C2A",
    "editor.selectionHighlightBackground": "#EA580C18",
    "editor.wordHighlightBackground": "#C2410C1E",
    "editor.wordHighlightBorder": "#C2410C66",
    "editor.findMatchBackground": "#EA580C50",
    "editor.findMatchHighlightBackground": "#EA580C26",
    "editorLineNumber.foreground": "#E65A2C88",
    "editorLineNumber.activeForeground": "#EA580C",
    "editorIndentGuide.background1": "#F5E9E1",
    "editorIndentGuide.activeBackground1": "#EA580C66",
    "editorWhitespace.foreground": "#F5E9E1",
    "editorRuler.foreground": "#F5E9E1",
    "editorBracketHighlight.foreground1": "#EA580C",
    "editorBracketHighlight.foreground2": "#C2410C",
    "editorBracketHighlight.foreground3": "#B91C1C",
    "editorBracketHighlight.foreground4": "#2D6A4F",
    "editorBracketHighlight.foreground5": "#C2410C",
    "editorBracketHighlight.foreground6": "#9A3412",
    "editorGroupHeader.tabsBackground": "#FCF6F2",
    "editorGroupHeader.tabsBorder": "#E8D2C2",
    "editorGroupHeader.noTabsBackground": "#FCF6F2",
    "editorGroup.border": "#E8D2C2",
    "tab.activeBackground": "#FDF2EC",
    "tab.activeForeground": "#2E1208",
    "tab.activeBorderTop": "#EA580C",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#FCF6F2",
    "tab.inactiveForeground": "#9A3412",
    "tab.border": "#E8D2C2",
    "tab.hoverBackground": "#F9E0D2",
    "tab.hoverForeground": "#2E1208",
    "tab.selectedBackground": "#EA580C2A",
    "tab.selectedForeground": "#2E1208",
    "tab.unfocusedActiveBackground": "#FDF4EF",
    "tab.unfocusedActiveForeground": "#2E1208D9",
    "tab.unfocusedActiveBorderTop": "#EA580C88",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#FCF6F2",
    "tab.unfocusedInactiveForeground": "#9A3412B3",
    "tab.unfocusedHoverBackground": "#F9E0D2",
    "tab.unfocusedHoverForeground": "#2E1208",
    "tab.lastPinnedBorder": "#E8D2C2",
    "panel.background": "#F7ECE4",
    "panel.border": "#E8D2C2",
    "panelTitle.activeBorder": "#EA580C",
    "panelTitle.activeForeground": "#2E1208",
    "panelTitle.inactiveForeground": "#9A3412",
    "terminal.background": "#F7ECE4",
    "terminal.foreground": "#2E1208",
    "terminal.border": "#E8D2C2",
    "terminal.ansiBlack": "#2E1208",
    "terminal.ansiRed": "#9A3412",
    "terminal.ansiGreen": "#166534",
    "terminal.ansiYellow": "#854D0E",
    "terminal.ansiBlue": "#9A3412",
    "terminal.ansiMagenta": "#831843",
    "terminal.ansiCyan": "#0E7490",
    "terminal.ansiWhite": "#475569",
    "statusBar.background": "#F7ECE4",
    "statusBar.foreground": "#9A3412",
    "statusBar.border": "#E8D2C2",
    "statusBar.debuggingBackground": "#EA580C20",
    "statusBar.debuggingForeground": "#2E1208",
    "statusBar.noFolderBackground": "#F7ECE4",
    "statusBarItem.hoverBackground": "#EA580C12",
    "statusBarItem.activeBackground": "#EA580C20",
    "statusBarItem.prominentBackground": "#EA580C",
    "statusBarItem.prominentForeground": "#FFFFFF",
    "gitDecoration.addedResourceForeground": "#16A34A",
    "gitDecoration.modifiedResourceForeground": "#EA580C",
    "gitDecoration.deletedResourceForeground": "#DC2626",
    "gitDecoration.untrackedResourceForeground": "#059669",
    "gitDecoration.ignoredResourceForeground": "#E65A2C88",
    "diffEditor.insertedTextBackground": "#16A34A18",
    "diffEditor.removedTextBackground": "#DC262618",
    "input.background": "#FFFFFF",
    "input.foreground": "#2E1208",
    "input.border": "#E8D2C2",
    "input.placeholderForeground": "#E65A2C99",
    "dropdown.background": "#FCF6F2",
    "dropdown.foreground": "#2E1208",
    "dropdown.border": "#E8D2C2",
    "quickInput.background": "#FCF6F2",
    "quickInput.foreground": "#2E1208",
    "pickerGroup.border": "#E8D2C2",
    "pickerGroup.foreground": "#EA580C",
    "notificationCenter.border": "#E8D2C2",
    "notificationCenterHeader.background": "#FCF6F2",
    "notificationCenterHeader.foreground": "#2E1208",
    "notifications.background": "#FCF6F2",
    "notifications.foreground": "#2E1208",
    "notifications.border": "#E8D2C2",
    "badge.background": "#EA580C",
    "badge.foreground": "#FFFFFF",
    "breadcrumb.background": "#FFFFFF",
    "breadcrumb.foreground": "#9A3412",
    "breadcrumb.focusForeground": "#2E1208",
    "breadcrumb.activeSelectionForeground": "#EA580C"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#87685D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#C2410C"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#C2410C"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#2D6A4F"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#B91C1C"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#9A3412"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#2E1208"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#2E1208"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#C2410C"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#C2410C"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#C2410C"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#C2410C"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#C2410C"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#2D6A4F"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#EA580C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#2D6A4F"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#C2410C"
      }
    }
  ]
}
