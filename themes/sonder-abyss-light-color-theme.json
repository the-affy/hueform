{
  "name": "SONDER — Abyss Light",
  "$schema": "vscode://schemas/color-theme",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#0B1E29",
    "variable.readonly": "#A35417",
    "variable.defaultLibrary": "#0A7D92",
    "parameter": "#0B1E29",
    "property": "#0B1E29",
    "property.readonly": "#A35417",
    "enumMember": "#A35417",
    "function": "#1B647A",
    "method": "#1B647A",
    "class": "#23495D",
    "interface": "#23495D",
    "type": "#23495D",
    "typeParameter": "#23495D",
    "namespace": "#23495D",
    "enum": "#23495D",
    "struct": "#23495D",
    "decorator": "#1B647A",
    "event": "#0A7D92",
    "keyword": "#0A7D92",
    "modifier": "#0A7D92",
    "string": "#1E6E45",
    "number": "#A35417",
    "regexp": "#1E6E45",
    "operator": "#1B647A",
    "comment": "#5C7887",
    "macro": "#1B647A"
  },
  "colors": {
    "focusBorder": "#0A7D9288",
    "foreground": "#0B1E29",
    "disabledForeground": "#3F83A799",
    "widget.shadow": "#00000018",
    "widget.border": "#C6D7E1",
    "selection.background": "#0A7D922A",
    "descriptionForeground": "#23495D",
    "errorForeground": "#DC2626",
    "icon.foreground": "#23495D",
    "window.activeBorder": "#C6D7E1",
    "window.inactiveBorder": "#E2EBF0",
    "titleBar.activeBackground": "#F1F5F8",
    "titleBar.activeForeground": "#0B1E29",
    "titleBar.inactiveBackground": "#F1F5F8",
    "titleBar.inactiveForeground": "#23495D",
    "titleBar.border": "#C6D7E1",
    "activityBar.background": "#F1F5F8",
    "activityBar.foreground": "#0A7D92",
    "activityBar.inactiveForeground": "#23495D88",
    "activityBar.border": "#C6D7E1",
    "activityBar.activeBorder": "#0A7D92",
    "activityBarBadge.background": "#0A7D92",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#F1F5F8",
    "sideBar.foreground": "#0B1E29",
    "sideBar.border": "#C6D7E1",
    "sideBarTitle.foreground": "#23495D",
    "sideBarSectionHeader.background": "#F1F5F8",
    "sideBarSectionHeader.foreground": "#0B1E29",
    "sideBarSectionHeader.border": "#C6D7E1",
    "list.activeSelectionBackground": "#0A7D9220",
    "list.activeSelectionForeground": "#0B1E29",
    "list.inactiveSelectionBackground": "#0A7D9212",
    "list.inactiveSelectionForeground": "#0B1E29",
    "list.hoverBackground": "#EAF1F5",
    "list.hoverForeground": "#0B1E29",
    "list.focusBackground": "#0A7D9220",
    "list.focusForeground": "#0B1E29",
    "list.highlightForeground": "#0A7D92",
    "list.dropBackground": "#0A7D9222",
    "tree.indentGuidesStroke": "#E2EBF0",
    "editor.background": "#FFFFFF",
    "editor.foreground": "#0B1E29",
    "editorCursor.foreground": "#0A7D92",
    "editorCursor.background": "#FFFFFF",
    "editor.lineHighlightBackground": "#F1F5F866",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#0A7D922A",
    "editor.selectionHighlightBackground": "#0A7D9218",
    "editor.wordHighlightBackground": "#1B647A1E",
    "editor.wordHighlightBorder": "#1B647A66",
    "editor.findMatchBackground": "#0A7D9250",
    "editor.findMatchHighlightBackground": "#0A7D9226",
    "editorLineNumber.foreground": "#3F83A788",
    "editorLineNumber.activeForeground": "#0A7D92",
    "editorIndentGuide.background1": "#E2EBF0",
    "editorIndentGuide.activeBackground1": "#0A7D9266",
    "editorWhitespace.foreground": "#E2EBF0",
