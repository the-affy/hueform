{
  "name": "HUEFORM — Umber Dark",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#FAF3EC",
    "variable.readonly": "#EFA058",
    "variable.defaultLibrary": "#DE7456",
    "parameter": "#FAF3EC",
    "property": "#FAF3EC",
    "property.readonly": "#EFA058",
    "enumMember": "#EFA058",
    "function": "#E5B860",
    "method": "#E5B860",
    "class": "#D4A274",
    "interface": "#D4A274",
    "type": "#D4A274",
    "typeParameter": "#D4A274",
    "namespace": "#D4A274",
    "enum": "#D4A274",
    "struct": "#D4A274",
    "decorator": "#E5B860",
    "event": "#DE7456",
    "keyword": "#DE7456",
    "modifier": "#DE7456",
    "string": "#A3C660",
    "number": "#EFA058",
    "regexp": "#A3C660",
    "operator": "#DE7456",
    "comment": "#8E7766",
    "macro": "#E5B860"
  },
  "colors": {
    "focusBorder": "#DE745688",
    "foreground": "#FAF3EC",
    "disabledForeground": "#AD6F3599",
    "widget.shadow": "var(--color-accent)66",
    "widget.border": "#46382C",
    "selection.background": "#DE745638",
    "descriptionForeground": "#D4A274",
    "errorForeground": "#F87171",
    "icon.foreground": "#D4A274",
    "window.activeBorder": "#46382C",
    "window.inactiveBorder": "#2B221A",
    "titleBar.activeBackground": "#1D1611",
    "titleBar.activeForeground": "#FAF3EC",
    "titleBar.inactiveBackground": "#1D1611",
    "titleBar.inactiveForeground": "#D4A274",
    "titleBar.border": "#46382C",
    "activityBar.background": "#1D1611",
    "activityBar.foreground": "#DE7456",
    "activityBar.inactiveForeground": "#D4A27488",
    "activityBar.border": "#46382C",
    "activityBar.activeBorder": "#DE7456",
    "activityBarBadge.background": "#DE7456",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#1D1611",
    "sideBar.foreground": "#FAF3EC",
    "sideBar.border": "#46382C",
    "sideBarTitle.foreground": "#D4A274",
    "sideBarSectionHeader.background": "#1D1611",
    "sideBarSectionHeader.foreground": "#FAF3EC",
    "sideBarSectionHeader.border": "#46382C",
    "list.activeSelectionBackground": "#DE74562A",
    "list.activeSelectionForeground": "#FAF3EC",
    "list.inactiveSelectionBackground": "#DE745618",
    "list.inactiveSelectionForeground": "#FAF3EC",
    "list.hoverBackground": "#2D241C",
    "list.hoverForeground": "#FAF3EC",
    "list.focusBackground": "#DE74562A",
    "list.focusForeground": "#FAF3EC",
    "list.highlightForeground": "#DE7456",
    "list.dropBackground": "#DE745622",
    "tree.indentGuidesStroke": "#2B221A",
    "editor.background": "#130F0B",
    "editor.foreground": "#FAF3EC",
    "editorCursor.foreground": "#DE7456",
    "editorCursor.background": "#130F0B",
    "editor.lineHighlightBackground": "#1D161155",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#DE745638",
    "editor.selectionHighlightBackground": "#DE745620",
    "editor.wordHighlightBackground": "#E5B86026",
    "editor.wordHighlightBorder": "#E5B86066",
    "editor.findMatchBackground": "#DE745650",
    "editor.findMatchHighlightBackground": "#DE745626",
    "editorLineNumber.foreground": "#AD6F3588",
    "editorLineNumber.activeForeground": "#DE7456",
    "editorIndentGuide.background1": "#2B221A",
    "editorIndentGuide.activeBackground1": "#DE745666",
    "editorWhitespace.foreground": "#2B221A",
    "editorRuler.foreground": "#2B221A",
    "editorBracketHighlight.foreground1": "#DE7456",
    "editorBracketHighlight.foreground2": "#E5B860",
    "editorBracketHighlight.foreground3": "#EFA058",
    "editorBracketHighlight.foreground4": "#A3C660",
    "editorBracketHighlight.foreground5": "#DE7456",
    "editorBracketHighlight.foreground6": "#D4A274",
    "editorGroupHeader.tabsBackground": "#1D1611",
    "editorGroupHeader.tabsBorder": "#46382C",
    "editorGroupHeader.noTabsBackground": "#1D1611",
    "editorGroup.border": "#46382C",
    "tab.activeBackground": "#2B1B14",
    "tab.activeForeground": "#FAF3EC",
    "tab.activeBorderTop": "#DE7456",
    "tab.activeBorder": "#00000000",
    "tab.inactiveBackground": "#1D1611",
    "tab.inactiveForeground": "#D4A274",
    "tab.border": "#46382C",
    "tab.hoverBackground": "#3C251C",
    "tab.hoverForeground": "#FAF3EC",
    "tab.selectedBackground": "#DE745638",
    "tab.selectedForeground": "#FAF3EC",
    "tab.unfocusedActiveBackground": "#211610",
    "tab.unfocusedActiveForeground": "#FAF3ECD9",
    "tab.unfocusedActiveBorderTop": "#DE745688",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedInactiveBackground": "#1D1611",
    "tab.unfocusedInactiveForeground": "#D4A274B3",
    "tab.unfocusedHoverBackground": "#3C251C",
    "tab.unfocusedHoverForeground": "#FAF3EC",
    "tab.lastPinnedBorder": "#46382C",
    "panel.background": "#271F18",
    "panel.border": "#46382C",
    "panelTitle.activeBorder": "#DE7456",
    "panelTitle.activeForeground": "#FAF3EC",
    "panelTitle.inactiveForeground": "#D4A274",
    "terminal.background": "#271F18",
    "terminal.foreground": "#FAF3EC",
    "terminal.border": "#46382C",
    "terminal.ansiBlack": "#1D1611",
    "terminal.ansiRed": "#E76F51",
    "terminal.ansiGreen": "#A3C660",
    "terminal.ansiYellow": "#E5B860",
    "terminal.ansiBlue": "#DE7456",
    "terminal.ansiMagenta": "#DDA15E",
    "terminal.ansiCyan": "#8AB17D",
    "terminal.ansiWhite": "#FAF3EC",
    "statusBar.background": "#271F18",
    "statusBar.foreground": "#D4A274",
    "statusBar.border": "#46382C",
    "statusBar.debuggingBackground": "#DE74562A",
    "statusBar.debuggingForeground": "#FAF3EC",
    "statusBar.noFolderBackground": "#271F18",
    "statusBarItem.hoverBackground": "#DE745618",
    "statusBarItem.activeBackground": "#DE74562A",
    "statusBarItem.prominentBackground": "#DE7456",
    "statusBarItem.prominentForeground": "#000000",
    "gitDecoration.addedResourceForeground": "#4ADE80",
    "gitDecoration.modifiedResourceForeground": "#DE7456",
    "gitDecoration.deletedResourceForeground": "#F87171",
    "gitDecoration.untrackedResourceForeground": "#A7F3D0",
    "gitDecoration.ignoredResourceForeground": "#AD6F3588",
    "diffEditor.insertedTextBackground": "#4ADE8020",
    "diffEditor.removedTextBackground": "#F8717120",
    "input.background": "#1D1611",
    "input.foreground": "#FAF3EC",
    "input.border": "#46382C",
    "input.placeholderForeground": "#AD6F3599",
    "dropdown.background": "#271F18",
    "dropdown.foreground": "#FAF3EC",
    "dropdown.border": "#46382C",
    "quickInput.background": "#271F18",
    "quickInput.foreground": "#FAF3EC",
    "pickerGroup.border": "#46382C",
    "pickerGroup.foreground": "#DE7456",
    "notificationCenter.border": "#46382C",
    "notificationCenterHeader.background": "#1D1611",
    "notificationCenterHeader.foreground": "#FAF3EC",
    "notifications.background": "#271F18",
    "notifications.foreground": "#FAF3EC",
    "notifications.border": "#46382C",
    "badge.background": "#DE7456",
    "badge.foreground": "#000000",
    "breadcrumb.background": "#130F0B",
    "breadcrumb.foreground": "#D4A274",
    "breadcrumb.focusForeground": "#FAF3EC",
    "breadcrumb.activeSelectionForeground": "#DE7456"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8E7766",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#DE7456"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#E5B860"
      }
    },
    {
      "name": "Strings & Regular Expressions",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#A3C660"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#EFA058"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#D4A274"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#FAF3EC"
      }
    },
    {
      "name": "Object Properties & Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#FAF3EC"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#DE7456"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#DE7456"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#E5B860"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#DE7456"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#E5B860"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#A3C660"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#DE7456",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#A3C660"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#E5B860"
      }
    }
  ]
}
